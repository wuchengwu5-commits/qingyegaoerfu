<view class="page"><view class="title">本轮规则</view><view class="sub">{{version}} · 修订 {{revision}} · 记分员代表本组确认</view><view wx:for="{{fields}}" wx:key="key" class="card"><view class="muted">{{item.label}}</view><picker wx:if="{{item.type==='select'}}" range="{{item.options}}" range-key="label" value="{{item.index}}" data-index="{{index}}" disabled="{{readonly}}" bindchange="change"><view style="padding:20rpx 0">{{item.options[item.index].label}} ▾</view></picker><switch wx:elif="{{item.type==='boolean'}}" checked="{{item.value}}" data-index="{{index}}" disabled="{{readonly}}" bindchange="change" color="#176b48"/><input wx:elif="{{item.type==='number'}}" type="number" value="{{item.value}}" data-index="{{index}}" disabled="{{readonly}}" bindblur="change" placeholder="请明确填写"/><textarea wx:else value="{{item.value}}" data-index="{{index}}" disabled="{{readonly}}" bindblur="change" placeholder="填写本场约定" auto-height /></view><view wx:if="{{error}}" class="card" style="color:#a55d2f">{{error}}</view><view class="section">逐洞让杆预览</view><view class="card" wx:for="{{preview}}" wx:key="hole">第 {{item.hole}} 洞 · SI {{item.si}}<view class="muted">{{item.text}}</view></view><view wx:if="{{!readonly}}"><button class="primary" bindtap="save">校验并保存规则</button><button class="space" bindtap="saveTemplate">保存为我的常用规则</button><view class="card" wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="applyTemplate">应用：{{item.name}} →</view></view></view>
