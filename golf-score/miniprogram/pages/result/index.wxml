<view class="page"><view class="eyebrow">EVERY STROKE COUNTS</view><view class="title">本轮成绩</view><view class="sub">{{r.courseName}} · {{date}}</view><view class="card space"><view class="muted">我的实际总杆 · {{mine.played}} / {{r.holes.length}} 洞</view><view style="font-size:100rpx;font-weight:300;margin:24rpx 0">{{mine.totalText}}</view><view class="pill">修订 {{r.revision}} · {{finished?'本轮已结束':editing?'更正尚未提交':'进行中'}}</view></view><view class="section">主赛结果</view><view class="card"><view class="row"><text>{{main.title}}</text><text class="pill">{{main.state}}</text></view><view wx:if="{{recordOnly}}" class="sub">仅记录成绩，不设主赛冠军或名次。</view><view wx:elif="{{main.result}}" class="section">{{main.winner}} {{main.result}}</view><view wx:for="{{main.rows}}" wx:key="id" class="row space"><text>{{item.rank || '—'}} · {{item.name}}（{{item.played}}洞）</text><text>{{item.played?item.total:'—'}} {{main.unit}}</text></view><view class="muted">{{main.explanation}}</view></view><view wx:if="{{side.length}}" class="section">附加玩法 · 独立结算</view><view wx:for="{{side}}" wx:key="id" class="card"><view class="row"><text>{{item.name}}</text><text class="pill">{{item.state}}</text></view><view wx:for="{{item.contests}}" wx:for-item="c" wx:key="contestId" class="row space"><text>{{c.label}} · {{c.state}}</text><text>{{c.winner}} {{c.result}}</text></view><view wx:for="{{item.totals}}" wx:for-item="t" wx:key="id" class="row space"><text>{{t.name}}</text><text>{{t.text}} {{item.unit}}</text></view><view wx:if="{{item.unallocated}}" class="muted">未分配 {{item.unallocated}} 点，不自动平分。</view></view><view class="section">实际成绩与完整记分卡</view><view class="muted">捡球、跳洞与认可完成不计入实际完洞总杆。表格第二行是主赛口径下的派生成绩。</view><view class="card" wx:for="{{players}}" wx:key="id"><view class="row"><text>{{item.name}}</text><text>{{item.totalText}} 杆 · {{item.played}} / {{r.holes.length}} 洞</text></view><view class="muted">实际前九 {{item.frontN?item.front:'—'}} / 后九 {{item.backN?item.back:'—'}}</view></view><scroll-view scroll-x><view style="min-width:650rpx"><view class="row card"><text>洞 / Par</text><text wx:for="{{players}}" wx:key="id">{{item.name}}</text></view><view wx:for="{{rows}}" wx:key="number" class="row card" data-number="{{item.number}}" bindtap="edit"><text>{{item.number}} / {{item.par}}</text><view wx:for="{{item.values}}" wx:for-item="v" wx:key="id"><view>{{v.raw}}</view><view class="muted">让 {{v.allowance}} · 净 {{v.net}} · 计 {{v.derived}}</view></view></view></view></scroll-view><button class="space" bindtap="rules">本场规则与逐洞让杆</button><button wx:if="{{finished}}" class="primary space" bindtap="beginEdit">更正成绩</button><button wx:else class="primary space" bindtap="resume">{{editing?'继续更正并提交':'继续本轮记分'}}</button><button class="space" bindtap="reviseRules">整轮规则 / Par / SI 更正</button><button class="space" bindtap="copy">复制带修订号的成绩</button><button wx:if="{{needsSourceConfirmation}}" class="space" bindtap="confirmSources">核对旧记录来源</button><view class="section">修订记录</view><view wx:for="{{log}}" wx:key="revision" class="card">修订 {{item.revision}} · {{item.reason}}<view class="muted">{{item.date}}</view></view></view>
