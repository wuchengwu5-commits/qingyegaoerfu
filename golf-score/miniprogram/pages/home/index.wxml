<view class="page"><view wx:if="{{storageError}}" class="card"><view>{{storageError}}</view><button bindtap="retryUpgrade">重新尝试升级</button></view>
<view class="row"><view><view class="eyebrow">GREEN DAYS, GOOD GAMES</view><view class="title">去球场，找回好状态</view></view><view class="avatar" bindtap="profile">青</view></view><view class="sub">你好，{{profile.name}}。把每一次进步记下来。</view>
<view class="hero"><image src="/assets/course.jpg" mode="aspectFill"/><view class="shade"><view class="eyebrow" style="color:#e0ecd9">LET’S PLAY GOLF</view><view class="title">下一杆，值得期待。</view><view class="sub">{{active ? active.courseName : '从第一洞开始，专注当下的每一杆'}}</view><button bindtap="start">{{active ? '继续记分 · 第 ' + active.currentHole + ' 洞 →' : '开启一场好球 →'}}</button></view></view>
<view class="metrics"><view class="metric"><text class="num">{{stats.rounds}}</text><text class="label">已完成球局</text></view><view class="metric"><text class="num">{{stats.best}}</text><text class="label">18 洞最佳</text></view><view class="metric"><text class="num">{{stats.holes}}</text><text class="label">累计球洞</text></view></view>
<view class="row section"><text>球场时光</text><text class="link" bindtap="courses">选择球场 →</text></view><view class="card row" bindtap="friends"><view class="avatar">＋</view><view class="grow"><view>和球友一起挥杆</view><view class="muted">管理常用球友，轻松同组记分</view></view><text>›</text></view>
<view class="row section"><text>最近一轮</text><text class="link" bindtap="history">全部记录 →</text></view><view wx:if="recent" class="card" bindtap="result"><view class="row"><view><view>{{recent.courseName}}</view><view class="muted">{{recent.date}} · {{recent.holes.length}} 洞</view></view><view><text class="num">{{recent.totalText}}</text><text class="pill">{{recent.diffText}}</text></view></view></view><view wx:else class="card empty">还没有球局记录<view/>从今天开始，记录你的高球时光</view><view class="footer-note">青野 · 每一杆，都是新的开始</view>
</view>
