.holes{display:flex;gap:8rpx}.hole{flex:1;background:#fff;text-align:center;border-radius:15rpx;padding:17rpx 0;color:#7f8f80;font-size:26rpx}.hole text{display:block;font-size:17rpx;line-height:15rpx}.hole.done{color:#176b48}.hole.selected{background:#176b48;color:white}.stepper{display:flex;align-items:center;gap:24rpx}.stepper button{width:76rpx;min-height:76rpx;line-height:76rpx;padding:0;font-size:36rpx}.score-value{font-size:56rpx;min-width:68rpx;text-align:center;font-weight:600}.small-step{gap:10rpx}.small-step button{width:50rpx;min-height:58rpx;line-height:58rpx;font-size:28rpx}
