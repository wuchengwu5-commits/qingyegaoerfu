<view class="page"><view class="pill">{{editing?'更正中，尚未提交':'已保存到本机'}}</view><view class="sub">{{r.courseName}}</view><view class="title">第 {{h.number}} 洞 <text class="muted">Par {{h.par}}</text></view><view class="muted">{{h.sectionName}} · 原洞号 {{h.label}} · {{p.tee}}</view><scroll-view scroll-x class="space" style="white-space:nowrap"><text wx:for="{{holes}}" wx:key="number" class="choice {{r.currentHole===item.number?'active':''}}" style="display:inline-block;margin:5rpx" data-number="{{item.number}}" bindtap="hole">{{item.number}}{{item.done?' ✓':''}}</text></scroll-view><view class="choices space"><view wx:for="{{players}}" wx:key="id" class="choice {{p.id===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectPlayer">{{item.name}} · {{item.score}}</view></view><view class="card space"><view class="row"><text>{{p.name}} · {{statusText}}</text><text class="link" bindtap="rules">本场规则</text></view><view class="row" style="margin:32rpx 0;justify-content:space-around"><button size="mini" data-delta="-1" bindtap="step">−</button><text style="font-size:90rpx;font-weight:300" bindtap="input">{{s.grossStrokes===null?'—':s.grossStrokes || h.par}}</text><button size="mini" data-delta="1" bindtap="step">＋</button></view><view wx:if="{{!s}}" class="muted">建议值，点击确认才保存</view><view class="choices"><text wx:for="{{quick}}" wx:key="*this" class="choice" data-value="{{item}}" bindtap="quick">{{item}}</text></view><view class="sub">{{explanation}}</view><view class="row space"><text>实际累计 {{summary.totalText}} 杆</text><text bindtap="clear" class="link">清空</text></view></view><view class="card"><view class="section">技术记录（选填）</view><view class="row" data-key="putts" bindtap="tech"><text>推杆</text><text>{{s.putts===null||!s?'未记录':s.putts}} →</text></view><view class="row space" data-key="penalties" bindtap="tech"><text>罚杆分项 · 已含于总杆</text><text>{{s?s.penalties:0}} →</text></view><view class="row space" data-key="fairway" bindtap="hit"><text>球道命中</text><text>{{h.par===3?'不适用':!s||s.fairway===null?'未记录':s.fairway?'命中':'未中'}}</text></view><view class="row space" data-key="green" bindtap="hit"><text>标准杆上果岭</text><text>{{!s||s.green===null?'未记录':s.green?'命中':'未中'}}</text></view></view><view class="choices"><text class="choice" data-mode="special" bindtap="adjust">捡球 / 跳洞</text><text class="choice" data-mode="penalty" bindtap="adjust">追加罚杆</text><text class="choice" data-mode="event" bindtap="adjust">比赛事件</text><text class="choice" data-mode="award" bindtap="adjust">附加奖项</text><text class="choice" bindtap="undo">撤销上次</text></view><view class="row space"><button data-step="-1" disabled="{{index===0}}" bindtap="move">上一洞</button><button data-step="1" disabled="{{index===r.holes.length-1}}" bindtap="move">下一洞</button></view><button class="space" bindtap="result">查看记分卡与分项结果</button><button wx:if="{{!editing}}" class="primary space" bindtap="finish">检查并结束</button><view wx:else><button class="primary space" bindtap="commit">填写原因并提交更正</button><button class="space" bindtap="cancel">放弃本次更正</button></view></view>
