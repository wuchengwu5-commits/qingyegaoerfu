.chart{display:flex;align-items:flex-end;height:330rpx;gap:12rpx}.bar-group{flex:1;min-width:0;text-align:center}.bar-track{height:210rpx;display:flex;align-items:flex-end;justify-content:center;margin:12rpx 0}.bar{width:32rpx;border-radius:10rpx 10rpx 0 0;background:linear-gradient(#a9c29b,#216d47)}.tiny{font-size:17rpx;color:#809086;white-space:nowrap}
