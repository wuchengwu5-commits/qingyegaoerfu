page{background:#f6f8f5;color:#203d31;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;border-radius:22rpx;padding:0 28rpx;min-height:88rpx;line-height:88rpx;background:#edf3ee;color:#176b48;font-weight:600;margin:0}button::after{border:none}button[disabled]{opacity:.4}input{height:92rpx;padding:20rpx 26rpx;background:#fff;border:1rpx solid #e2eae3;border-radius:20rpx}textarea{width:100%;background:#fff;border-radius:20rpx;padding:20rpx;height:200rpx}.page{padding:32rpx 32rpx 64rpx}.eyebrow{font-size:21rpx;letter-spacing:5rpx;color:#73927e;font-weight:600}.title{font-size:48rpx;font-weight:650;line-height:1.4;margin:12rpx 0}.sub,.muted{color:#819087;font-size:25rpx;line-height:1.7}.section{font-size:32rpx;font-weight:600;margin:40rpx 0 22rpx}.card{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:24rpx;border:1rpx solid #e9eee8}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.primary{background:#176b48;color:#fff}.dark{background:#174c35;color:#fff}.dark .muted{color:#c3d8c9}.soft{color:#176b48;background:#edf4ec}.hero{height:400rpx;border-radius:32rpx;overflow:hidden;position:relative;margin:28rpx 0;background:#265c36}.hero image{height:100%;width:100%}.shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(9,45,27,.83),rgba(0,0,0,0) 90%);padding:38rpx;display:flex;flex-direction:column;justify-content:flex-end;color:#fff}.hero .title{font-size:44rpx}.hero .sub{color:#e7f1e6}.hero button{margin-top:22rpx;background:#fff;color:#176b48;width:100%}.metrics{display:flex;gap:14rpx;margin:24rpx 0}.metric{flex:1;text-align:center;background:white;border-radius:24rpx;padding:24rpx 8rpx}.num{font-size:45rpx;font-weight:600;display:block;margin:8rpx 0}.label{font-size:22rpx;color:#849087}.link{color:#176b48;font-size:26rpx}.avatar{width:76rpx;height:76rpx;flex-shrink:0;border-radius:50%;background:#ecf3e6;display:flex;align-items:center;justify-content:center;color:#176b48;font-size:30rpx;font-weight:600}.pill{display:inline-block;padding:10rpx 20rpx;border-radius:30rpx;background:#eef5ed;color:#50745b;font-size:22rpx}.choices{display:flex;gap:14rpx;flex-wrap:wrap;margin:20rpx 0}.choice{padding:18rpx 26rpx;border-radius:18rpx;background:#edf1ed;color:#75837a;min-width:108rpx;text-align:center}.choice.active{background:#176b48;color:#fff}.empty{text-align:center;padding:60rpx 24rpx;color:#859389;line-height:1.8}.empty .num{color:#b1c7ac;font-size:70rpx}.course-img{width:100%;height:260rpx;border-radius:20rpx;margin-bottom:20rpx}.divider{height:1rpx;background:#edf0eb;margin:24rpx 0}.footer-note{text-align:center;color:#96a197;font-size:21rpx;margin:35rpx 0}.space{margin-top:24rpx}.badge{font-size:22rpx;color:#9d7029;background:#fbf4df;border-radius:12rpx;padding:8rpx 14rpx}.danger{color:#b75041}.small{font-size:23rpx}.segment{display:flex;background:#e8eee7;padding:8rpx;border-radius:20rpx;margin:26rpx 0}.segment view{flex:1;text-align:center;padding:18rpx;border-radius:16rpx;color:#6c8172}.segment .active{background:#fff;color:#176b48;font-weight:600}.bottom{padding-bottom:env(safe-area-inset-bottom)}
