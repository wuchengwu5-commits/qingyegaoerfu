:host{display:block}
.dialog-layer{position:fixed;inset:0;z-index:10000;color:#244a34;font-size:30rpx;line-height:1.5}
.dialog-mask{position:absolute;inset:0;background:rgba(20,36,25,.4)}
.dialog-sheet{position:absolute;bottom:0;left:0;right:0;box-sizing:border-box;max-height:88vh;display:flex;flex-direction:column;background:#f8faf4;border-radius:36rpx 36rpx 0 0;padding:16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));box-shadow:0 -12rpx 50rpx rgba(18,46,28,.12)}
.dialog-grip{width:64rpx;height:6rpx;border-radius:10rpx;background:#d3ddce;margin:0 auto 16rpx;flex-shrink:0}
.dialog-heading{display:flex;align-items:center;gap:20rpx;margin-bottom:24rpx;flex-shrink:0;min-height:64rpx}
.dialog-title{font-size:35rpx;font-weight:600;flex:1;min-width:0;line-height:1.45}
.dialog-layer .dialog-button{margin:0;padding:0;border:0;box-shadow:none;box-sizing:border-box;font-weight:500}
.dialog-layer .dialog-button::after{border:0}
.dialog-heading .dialog-close{flex-shrink:0;width:68rpx;height:68rpx;line-height:62rpx;border-radius:50%;font-size:42rpx;color:#6e806b;background:#edf2e8}
.dialog-copy{min-height:0;max-height:45vh}.dialog-message{display:block;white-space:pre-wrap;line-height:1.75;font-size:29rpx;color:#526a51;word-break:break-word}
.dialog-input{margin-top:12rpx;box-sizing:border-box;background:#fff;border:2rpx solid #d5e2cf;border-radius:20rpx;padding:20rpx 24rpx;min-height:100rpx;height:100rpx;font-size:32rpx;color:#244a34}.dialog-message+.dialog-input{margin-top:24rpx}.dialog-placeholder{color:#8a9883}
.dialog-options{min-height:0;max-height:49vh;height:auto}.dialog-option{display:flex;align-items:center;gap:22rpx;min-height:100rpx;padding:18rpx 24rpx;box-sizing:border-box;border-radius:18rpx;margin:4rpx 0;font-size:31rpx}.dialog-option-label{flex:1;min-width:0;word-break:break-word}.is-selected{background:#e4eddb;color:#285c3a;font-weight:600}.dialog-check{font-size:34rpx;width:36rpx;text-align:center;color:#3d6e4c;flex:none}.dialog-swatch{width:34rpx;height:34rpx;border:2rpx solid rgba(67,85,69,.3);border-radius:50%;flex:none;box-sizing:border-box}.is-disabled{opacity:.3}
.dialog-actions{display:flex;gap:20rpx;margin-top:28rpx;padding-top:22rpx;border-top:1rpx solid #e0e7da;flex-shrink:0}.dialog-actions .dialog-button{flex:1;min-width:0;min-height:96rpx;line-height:1.4;padding:26rpx 16rpx;border-radius:22rpx;font-size:30rpx}.dialog-cancel{background:#edf1e7;color:#63775e}.dialog-confirm{background:#326446;color:#fff}
.calendar-heading{display:flex;align-items:center;gap:8rpx;margin-bottom:20rpx}.calendar-heading .calendar-month{flex:1;text-align:center;font-size:31rpx;font-weight:600}.calendar-heading .calendar-nav{width:64rpx;height:76rpx;line-height:72rpx;font-size:36rpx;color:#436c4a;background:transparent}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4rpx}.calendar-weekday{text-align:center;font-size:25rpx;color:#87967f;padding-bottom:12rpx}.calendar-day{display:flex;align-items:center;justify-content:center;min-height:88rpx;border-radius:50%;font-size:30rpx}.dialog-calendar{overflow-y:auto;min-height:0;max-height:52vh}
.dialog-time{display:flex;align-items:center;gap:22rpx;min-height:0}.time-column{flex:1;min-width:0}.time-label{text-align:center;color:#71866a;font-size:26rpx;margin-bottom:12rpx}.time-list{height:36vh;border-radius:20rpx;background:#f0f4ea}.time-option{margin:6rpx 12rpx;text-align:center;line-height:96rpx;font-size:34rpx;border-radius:18rpx}.time-colon{font-size:40rpx;font-weight:600}
