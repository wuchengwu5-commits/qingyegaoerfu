.privacy-shade{position:fixed;inset:0;background:#17392c66;z-index:9999;display:flex;align-items:center;justify-content:center;padding:40rpx}.privacy-card{background:#f8faf5;border-radius:36rpx;padding:40rpx;max-width:620rpx}.privacy-title{font-size:36rpx;font-weight:600;color:#203d31}.privacy-copy{font-size:28rpx;line-height:1.8;color:#6b7e6d;margin:24rpx 0}.privacy-link{font-size:27rpx;color:#226448;min-height:88rpx;display:flex;align-items:center}.privacy-card button{background:#226448;color:white;border-radius:20rpx;font-size:30rpx;line-height:88rpx;margin-top:16rpx}.privacy-card .privacy-later{background:transparent;color:#6b7e6d}.privacy-card button::after{border:0}

.privacy-card{background:#f0f7ed;border:1rpx solid #fff;box-shadow:inset 0 2rpx 0 #fff,0 25rpx 80rpx #193d2b29}.privacy-card button{background:#3c754a;border:1rpx solid #9bc198;border-radius:28rpx;box-shadow:inset 0 2rpx 1rpx #cee7c6aa,0 6rpx 20rpx #315d3720}.privacy-card .privacy-later{border-color:transparent;box-shadow:none}
