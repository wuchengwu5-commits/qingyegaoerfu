.privacy-shade{position:fixed;inset:0;background:#17392c66;z-index:9999;display:flex;align-items:center;justify-content:center;padding:40rpx}.privacy-card{background:#f8faf5;border-radius:36rpx;padding:40rpx;max-width:620rpx}.privacy-title{font-size:36rpx;font-weight:600;color:#203d31}.privacy-copy{font-size:28rpx;line-height:1.8;color:#6b7e6d;margin:24rpx 0}.privacy-link{font-size:27rpx;color:#226448;min-height:88rpx;display:flex;align-items:center}.privacy-action{background:#226448;color:white;border-radius:20rpx;font-size:30rpx;line-height:88rpx;margin-top:16rpx}.privacy-card .privacy-later{background:transparent;color:#6b7e6d}.privacy-action::after{border:0}

.privacy-card{background:#f0f7ed;border:1rpx solid #fff;box-shadow:inset 0 2rpx 0 #fff,0 25rpx 80rpx #193d2b29}.privacy-action{background:#3c754a;border:1rpx solid #9bc198;border-radius:28rpx;box-shadow:inset 0 2rpx 1rpx #cee7c6aa,0 6rpx 20rpx #315d3720}.privacy-card .privacy-later{border-color:transparent;box-shadow:none}

/* Isolated component: same approved action material, readable dialog body. */
.privacy-card{border-color:rgba(255,255,255,.4);box-shadow:inset 0 1rpx 1rpx rgba(255,255,255,.45),0 20rpx 60rpx rgba(25,61,43,.14)}
.privacy-action{background:linear-gradient(180deg,rgba(255,255,243,.07),rgba(255,255,243,0) 52%,rgba(15,49,25,.09)),linear-gradient(110deg,rgba(62,117,65,.96),rgba(31,83,46,.97));border:1rpx solid rgba(246,255,232,.23);box-shadow:inset 0 2rpx 2rpx rgba(252,255,241,.2),inset 0 -2rpx 4rpx rgba(26,64,33,.19),0 6rpx 14rpx rgba(30,66,35,.14);color:#f5fff8}
.privacy-card .privacy-action.privacy-later{background:transparent;border-color:transparent;color:#586f5c;box-shadow:none}
