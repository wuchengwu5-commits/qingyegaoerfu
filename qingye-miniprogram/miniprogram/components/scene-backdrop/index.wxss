:host{position:fixed;left:0;top:0;right:0;bottom:0;z-index:-2;pointer-events:none}.scene-backdrop{position:fixed;left:0;top:0;width:100vw;height:100vh;overflow:hidden;background:#e2ebd8}.scene-image{width:100%;height:100%;filter:blur(16px) saturate(.58);transform:scale(1.08)}.scene-veil{position:absolute;left:0;top:0;right:0;bottom:0;background:rgba(246,250,239,.78)}.is-original .scene-image{filter:none;transform:none}.is-original .scene-veil{background:transparent}
