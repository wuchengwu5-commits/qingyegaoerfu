.flow-progress{display:flex;align-items:flex-start;margin:30rpx 0 36rpx;padding:0 2rpx}.flow-step{position:relative;flex:1;min-width:0;text-align:center;min-height:102rpx;padding:8rpx 0;box-sizing:border-box}.flow-step::before{content:"";position:absolute;top:30rpx;left:-50%;width:100%;height:2rpx;background:#ccd8c5}.flow-step:first-child::before{display:none}.flow-dot{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;margin:0 auto 12rpx;background:#e0e8d8;border:2rpx solid #d2ddca;border-radius:50%;color:#6b8065;font-size:24rpx;font-weight:600}.flow-label{font-size:25rpx;color:#788970;line-height:1.4}.flow-step.is-current .flow-dot{background:#376849;color:white;border-color:#376849;box-shadow:0 0 0 7rpx #e0ead7}.flow-step.is-current .flow-label{color:#244b34;font-weight:600}.flow-step.is-done .flow-dot{background:#e4efdc;color:#386446;border-color:#abc49d}.flow-step.is-done::before{background:#abc49d}.flow-kicker{font-size:23rpx;color:#7c8c72;line-height:1.6;margin-bottom:6rpx}.flow-title{font-size:34rpx;font-weight:600;color:#284e36;line-height:1.5}.flow-caption{font-size:25rpx;color:#7a8b71;line-height:1.65;margin-top:6rpx}.flow-footer{position:fixed;bottom:0;left:0;right:0;z-index:20;background:rgba(245,248,239,.98);border-top:1rpx solid #dce5d3;padding:20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:20rpx}.flow-footer button.flow-next{flex:1;width:auto;max-width:none;margin:0;min-height:96rpx;line-height:1.4;padding:24rpx 16rpx;font-size:30rpx}.flow-footer button.flow-back{flex:0 0 112rpx;width:112rpx;min-height:88rpx;margin:0;padding:16rpx 0;background:none;box-shadow:none;font-size:26rpx;font-weight:400;line-height:1.5;color:#678161}.flow-quiet-action{font-size:25rpx;line-height:1.5;color:#597c58;padding:18rpx 0;min-height:80rpx;display:flex;align-items:center;box-sizing:border-box}
