<view class="hole-page {{view==='overview'?'overview-mode':diagramMode?'diagram-mode':''}}">
 <view class="stage"><canvas hidden="{{pickerOpen}}" id="map" type="2d" class="map" aria-label="{{view==='overview'?'全场卫星总览，可缩放拖动':'第'+selected+'洞球道图'}}" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"/></view>
 <block wx:if="{{!pickerOpen}}">
  <button wx:for="{{actions}}" wx:key="key" class="atlas-hit" aria-label="{{item.name}}" disabled="{{item.disabled}}" data-action="{{item.key}}" bindtap="actionTap" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;"/>
  <view class="map-context" wx:if="{{h&&view==='hole'}}"><text wx:if="{{hasRound}}" class="tee-dot" style="background:{{teeColor}}"></text><text>{{teeLabel}}</text><button wx:if="{{scoringHole&&selected!==scoringHole}}" bindtap="currentHole">回到记分洞 {{scoringHole}}</button></view>
  <view wx:if="{{overviewOnly&&view==='overview'}}" class="overview-pending-note">{{shortName}} · 逐洞 GPS 点位复核中，当前仅显示卫星全览</view>
  <view class="reference-note" wx:if="{{diagramMode&&view==='hole'}}">{{cardTee}} · {{cardDistance}} 码（记分卡） · 双指缩放查看</view>
  <view class="map-pending" wx:if="{{!mapAvailable&&!waitingForGps&&view==='hole'}}"><view class="pending-number">{{selected}}</view><view class="pending-title">本洞球道图待完善</view><text>地图位置已预留，记分仍可继续。</text><button wx:if="{{hasOverview}}" bindtap="overview">查看球场总览</button></view>
  <view class="error" wx:if="{{error}}" bindtap="retry">{{error}} · 重试</view>
  <view class="map-loading" wx:if="{{loading&&(mapAvailable||waitingForGps||view==='overview')&&!error}}">{{diagramMode?'正在加载精修图…':'正在加载 GPS 卫星图…'}}</view>
 </block>
 <view wx:if="{{pickerOpen}}" class="hole-sheet-shade" bindtap="closePicker"><view class="hole-sheet" catchtap="keepPicker"><view class="hole-sheet-head"><text>选择球洞</text><view bindtap="closePicker" class="sheet-close" aria-label="关闭选洞"><image src="/assets/map-icons/x.png"/></view></view><view class="sheet-course">{{courseName}}</view><view wx:if="{{hasOverview}}" class="sheet-overview" bindtap="overview"><text>全场卫星总览</text><image src="/assets/chevron.png"/></view><scroll-view scroll-y="{{true}}" class="hole-group-scroll"><view wx:for="{{groups}}" wx:key="id" class="hole-group"><view class="hole-group-title">{{item.title}}</view><view class="hole-grid"><view wx:for="{{item.holes}}" wx:for-item="hole" wx:key="sourceId" class="hole-option {{selected===hole.number&&view==='hole'?'selected':''}}" data-number="{{hole.number}}" bindtap="chooseHole"><text>{{hole.displayNumber}}</text><text class="hole-option-par">Par {{hole.par}}</text><view class="available-dot {{hole.mapAvailable?'ready':''}}"></view></view></view></view></scroll-view><view class="sheet-note"><text class="ready-dot"></text><text>{{hasOverview||referenceAvailable?availabilityNote:'该球场卫星图待补充'}}</text></view></view></view>
</view><privacy-panel/>
<qy-dialog class="page-dialog"/>
