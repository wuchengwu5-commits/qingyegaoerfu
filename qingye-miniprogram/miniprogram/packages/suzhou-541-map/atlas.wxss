page{height:100%;background:#edf3ec;color:#1e4736}
.atlas-page{position:absolute;inset:0;overflow:hidden;background:#edf3ec;color:#1e4736}
.atlas-canvas{display:block;width:100%;height:100%;touch-action:none}
.atlas-page .atlas-hit{position:absolute;z-index:2;opacity:0;min-width:0;min-height:0;padding:0;margin:0;border:0;cursor:pointer}
.atlas-page .atlas-hit:focus-visible{opacity:1;background:transparent;outline:3px solid #f6d679}
.load-state{position:absolute;z-index:4;top:38%;left:12%;right:12%;padding:22rpx;text-align:center;background:#f6f9f0;border-radius:22rpx;font-size:25rpx}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none}
.hole-picker{position:absolute;inset:0;z-index:5;display:flex;flex-direction:column;padding:36rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));background:#f4f7f0}
.picker-head,.group-name{display:flex;align-items:center}.picker-head{justify-content:space-between;margin-bottom:22rpx}.eyebrow{font-size:22rpx;color:#5b7564}.picker-title{font-size:44rpx;font-weight:650;line-height:1.5}
.atlas-page .close-picker{width:70rpx;min-height:70rpx;line-height:70rpx;padding:0;margin:0;border-radius:50%;background:#e4ecdf;color:#365c42;font-size:36rpx}
.group-scroll{flex:1;height:0;min-height:0}.group{margin-bottom:30rpx}.group-name{font-size:27rpx;font-weight:650;margin-bottom:13rpx;gap:10rpx}.group-dot{width:15rpx;height:15rpx;border-radius:50%}
.hole-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10rpx}.atlas-page .hole-option{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:3rpx;min-width:0;width:100%;height:80rpx;min-height:0;line-height:1.1;padding:0;margin:0;border-radius:18rpx;background:white;color:#2d543c;font-size:29rpx;font-weight:600}
.atlas-page .small-par{font-size:17rpx;opacity:.74;font-weight:400}.atlas-page .chosen{background:#234e39;color:white}.hole-option::after,.close-picker::after{border:0}

.map-notice{position:absolute;z-index:2;top:61px;left:80px;right:52px;padding:5px 8px;border-radius:10px;background:rgba(255,247,220,.94);color:#76531e;font-size:10px;text-align:center;pointer-events:none}
