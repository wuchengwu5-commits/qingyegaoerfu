/* Qingye map: the same cool photographic glass as the main app. */
.hole-page{position:relative;height:100vh;overflow:hidden;background:#e7f0ec;color:#173e34}
.map-backdrop,.map-backdrop-wash{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.map-backdrop{filter:blur(20px) saturate(.45);opacity:1;transform:scale(1.1)}
.map-backdrop-wash{background:rgba(228,243,240,.9)}
.stage{position:absolute;inset:0;overflow:hidden}.map{display:block;width:100%;height:100%}

/* Quiet floating controls leave the full height available to the hole. */
.hole-meta{position:absolute;left:30rpx;top:26rpx;display:flex;flex-direction:column;align-items:flex-start;gap:10rpx;max-width:240rpx}
.hole-selector,.layer-toggle,.edge-distances,.overview-link,.quick-button,.hole-stepper button,.return-current,.overview-north,.overview-tip,.error,.map-loading{border:1rpx solid rgba(255,255,255,.78);background:rgba(243,251,248,.54);box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.52),0 6rpx 20rpx rgba(30,72,58,.055);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.hole-selector{display:flex;align-items:center;justify-content:space-between;gap:14rpx;min-height:76rpx;padding:0 20rpx;border-radius:38rpx;font-size:31rpx;font-weight:500;color:#173e34}
.selector-chevron{width:26rpx;height:26rpx;transform:rotate(90deg);opacity:.72}
.hole-meta .par{font-size:22rpx;letter-spacing:2rpx;font-weight:500;padding-left:8rpx;color:#3d6658}
.course-caption{font-size:20rpx;line-height:1.5;color:#536e66;max-width:222rpx;padding-left:8rpx}
.tee-status{display:flex;align-items:center;gap:10rpx;margin-top:4rpx;padding-left:8rpx;font-size:21rpx;color:#536e66}
.tee-dot{width:18rpx;height:18rpx;border-radius:50%;border:1rpx solid rgba(53,94,78,.2);box-shadow:0 0 0 5rpx rgba(255,255,255,.5)}
.return-current{font-size:19rpx;color:#38664f;margin-top:6rpx;min-height:56rpx;padding:0 14rpx;border-radius:28rpx;display:flex;align-items:center}
.layer-toggle{position:absolute;right:24rpx;top:26rpx;min-width:112rpx;min-height:76rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:center;border-radius:38rpx;color:#3d6658;font-size:23rpx}

.distance-stack{position:absolute;left:30rpx;top:28%;width:178rpx}
.center-distance,.hole-option.selected{background:linear-gradient(118deg,rgba(126,173,135,.96) 0%,rgba(77,132,94,.96) 47%,rgba(41,91,63,.98) 100%);border:1rpx solid rgba(235,255,242,.58);color:#f8fffb;box-shadow:inset 0 2rpx 2rpx rgba(255,255,255,.25),inset 0 -1rpx 1rpx rgba(21,64,43,.12),0 8rpx 20rpx rgba(35,83,59,.1)}
.center-distance{border-radius:32rpx;padding:22rpx 20rpx;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.flag-icon{width:28rpx;height:28rpx;display:block;margin-bottom:12rpx;opacity:.9}
.distance-label{font-size:21rpx;color:#edf8f1;display:block}
.distance-number{font-size:65rpx;font-weight:500;line-height:1.15;letter-spacing:-2rpx;margin:8rpx 0;font-variant-numeric:tabular-nums}
.unit-label{font-size:21rpx;color:#e6f3ec;display:block}
.edge-distances{margin-top:14rpx;padding:8rpx 18rpx;border-radius:28rpx}
.edge-distances>view{display:flex;align-items:center;justify-content:space-between;gap:6rpx;padding:15rpx 0}
.edge-distances>view+view{border-top:1rpx solid rgba(75,111,95,.13)}
.edge-distances>view>text:first-child{font-size:20rpx;color:#536e66}
.edge-distances>view>text:last-child{font-size:29rpx;font-weight:500;color:#274d40;font-variant-numeric:tabular-nums}
.overview-link{font-size:21rpx;color:#3d6658;min-height:66rpx;display:flex;align-items:center;justify-content:center;border-radius:33rpx;margin-top:14rpx}
.hole-stepper{position:absolute;left:24rpx;bottom:calc(158rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:6rpx;color:#536e66}
.hole-stepper button{width:80rpx;height:80rpx;min-height:80rpx;line-height:1;padding:0;border-radius:40rpx;display:flex;align-items:center;justify-content:center}
.hole-stepper button::after{border:0}.hole-stepper button[disabled]{opacity:.35;box-shadow:none}
.hole-stepper button image{width:30rpx;height:30rpx;opacity:.8}.previous-icon{transform:rotate(180deg)}
.hole-stepper text{font-size:19rpx;min-width:54rpx;text-align:center;font-variant-numeric:tabular-nums}
.map-tip{position:absolute;left:34rpx;bottom:calc(88rpx + env(safe-area-inset-bottom));width:220rpx;line-height:1.7;pointer-events:none}
.map-tip>text{display:none;font-size:18rpx;color:#536e66}.map-tip>text:first-child{display:block}
.quick-controls{position:absolute;right:24rpx;bottom:calc(82rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;align-items:center;gap:16rpx}
.quick-button{width:88rpx;min-height:88rpx;border-radius:44rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3rpx}
.quick-button image{width:32rpx;height:32rpx;opacity:.8}.quick-button text{font-size:18rpx;color:#3d6658}
.map-foot{position:absolute;bottom:calc(16rpx + env(safe-area-inset-bottom));left:34rpx;right:120rpx;display:flex;flex-direction:column;gap:5rpx;padding-top:10rpx;font-size:14rpx;line-height:1.4;color:#5e786e;text-shadow:0 1rpx 3rpx rgba(244,252,248,.8)}
.map-foot>text:first-child{font-size:18rpx}
.error{position:absolute;z-index:3;top:44%;left:27%;right:8%;padding:24rpx;font-size:24rpx;border-radius:24rpx;color:#274d40;text-align:center}
.map-loading{position:absolute;left:40%;top:46%;padding:18rpx 24rpx;border-radius:24rpx;color:#536e66;font-size:22rpx}

/* Overview and empty maps use the same surrounding glass. */
.overview-mode .hole-meta{left:24rpx;top:24rpx;padding:0;max-width:310rpx}
.overview-mode .course-caption{margin-top:4rpx;max-width:300rpx;padding:8rpx 14rpx;border-radius:16rpx;background:rgba(240,250,246,.72)}
.overview-north{position:absolute;right:28rpx;top:32rpx;padding:12rpx 16rpx;border-radius:24rpx;font-size:23rpx;color:#3d6658;letter-spacing:2rpx}
.overview-tip{position:absolute;left:30rpx;bottom:calc(96rpx + env(safe-area-inset-bottom));padding:12rpx 18rpx;border-radius:24rpx;font-size:20rpx;color:#536e66}
.overview-mode .map-foot{background:rgba(240,250,246,.75);padding:8rpx 14rpx;border-radius:16rpx;width:max-content;max-width:70%;right:auto}
.map-pending{position:absolute;left:40rpx;right:40rpx;top:31%;text-align:center;color:#3d6658}
.pending-number{font-size:120rpx;line-height:1.2;font-weight:500;color:#a7c2b6;margin-bottom:26rpx}
.pending-title{font-size:32rpx;margin-bottom:20rpx}.map-pending>text{display:block;font-size:23rpx;color:#536e66;line-height:1.8}
.pending-overview{display:flex;align-items:center;justify-content:center;width:max-content;max-width:100%;min-height:88rpx;margin:40rpx auto 0;padding:0 30rpx;border:1rpx solid rgba(255,255,255,.78);border-radius:44rpx;background:rgba(240,250,246,.54);color:#38664f;font-size:25rpx}
.pending-note{font-size:23rpx;color:#536e66;margin-top:32rpx}

/* One translucent sheet for all holes; no extra toolbar or repeated controls. */
.hole-sheet-shade{position:absolute;z-index:20;inset:0;background:rgba(20,53,43,.2);display:flex;align-items:flex-end}
.hole-sheet{width:100%;max-height:84%;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.8);border-bottom:0;border-radius:40rpx 40rpx 0 0;background:rgba(233,247,241,.84);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:24rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.68),0 -16rpx 60rpx rgba(23,63,50,.1);display:flex;flex-direction:column}
.hole-sheet-head{display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:500;color:#173e34}
.sheet-close{width:72rpx;height:72rpx;border-radius:36rpx;background:rgba(248,255,252,.45);border:1rpx solid rgba(255,255,255,.65);display:flex;align-items:center;justify-content:center}.sheet-close image{width:30rpx;height:30rpx;opacity:.8}
.sheet-course{font-size:22rpx;color:#536e66;margin:2rpx 0 22rpx}
.sheet-overview{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;border-radius:28rpx;padding:0 24rpx;background:rgba(246,253,249,.5);border:1rpx solid rgba(255,255,255,.8);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.65);font-size:25rpx;color:#38664f;margin-bottom:18rpx}.sheet-overview image{width:28rpx;height:28rpx}
.hole-group-scroll{height:540rpx;max-height:52vh;flex-shrink:1;min-height:0;overflow-y:auto}
.hole-sheet-head,.sheet-course,.sheet-overview,.sheet-note{flex-shrink:0}
.hole-group-title{font-size:23rpx;color:#536e66;margin:20rpx 0 16rpx}
.hole-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12rpx}
.hole-option{position:relative;min-height:96rpx;border:1rpx solid rgba(255,255,255,.78);border-radius:24rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5rpx;font-size:31rpx;color:#274d40;background:rgba(246,253,249,.46);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.55)}
.hole-option-par{font-size:18rpx;color:#607e70}.hole-option.selected{color:#f8fffb}.hole-option.selected .hole-option-par{color:#e6f3ec}
.available-dot{height:7rpx;width:7rpx;position:absolute;right:12rpx;top:12rpx;border-radius:50%}.available-dot.ready{background:#73a789}.hole-option.selected .available-dot.ready{background:#d9eee2}
.sheet-note{display:flex;align-items:center;gap:10rpx;font-size:20rpx;color:#536e66;margin-top:24rpx}.ready-dot{width:9rpx;height:9rpx;border-radius:50%;background:#73a789}
@media(max-height:700px){.hole-meta{top:18rpx;gap:6rpx}.hole-selector{min-height:68rpx}.layer-toggle{top:18rpx;min-height:68rpx}.distance-stack{top:31%;width:168rpx}.center-distance{padding:17rpx 18rpx}.flag-icon{display:none}.distance-number{font-size:58rpx}.edge-distances{margin-top:10rpx}.edge-distances>view{padding:10rpx 0}.overview-link{margin-top:10rpx;min-height:60rpx}.hole-stepper{bottom:calc(136rpx + env(safe-area-inset-bottom))}.quick-controls{gap:12rpx}}

/* Diagram cards retain their original labels; coordinates are never inferred from them. */
.diagram-mode .hole-meta{max-width:460rpx;gap:7rpx}.diagram-mode .course-caption{max-width:440rpx}
.diagram-tools{position:absolute;right:24rpx;top:24rpx;display:flex;flex-direction:column;align-items:flex-end;gap:14rpx}.diagram-tools .overview-link{margin:0;padding:0 20rpx;min-height:76rpx;font-size:22rpx}.diagram-tools>text{font-size:18rpx;color:#536e66}
.diagram-mode .hole-stepper{bottom:calc(100rpx + env(safe-area-inset-bottom))}.diagram-mode .map-foot{right:110rpx}.diagram-mode .map-loading{left:28%;right:28%;text-align:center}

.card-yardage{position:absolute;right:24rpx;top:132rpx;display:flex;flex-direction:column;align-items:flex-end;gap:8rpx;font-size:20rpx;color:#315c4b;background:rgba(241,250,246,.9);padding:16rpx;border-radius:18rpx;max-width:350rpx}.overview-tip{display:flex;flex-direction:column;gap:8rpx}

.card-yardage.gps-card{left:34rpx;right:auto;top:244rpx;max-width:184rpx;padding:0;background:transparent;border-radius:0;font-size:18rpx;align-items:flex-start;line-height:1.4}.gps-card>text:first-child{display:none}

.hole-meta{max-width:340rpx}.hole-selector{white-space:nowrap}
