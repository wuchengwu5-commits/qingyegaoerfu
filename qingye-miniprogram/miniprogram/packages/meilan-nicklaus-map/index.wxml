<view class="hole-page {{view==='overview'?'overview-mode':diagramMode?'diagram-mode':''}}">
 <image class="map-backdrop" src="cloud://cloud1-d7gketoi570d17f80.636c-cloud1-d7gketoi570d17f80-1524135194/media-v1/assets__spring-lake.webp" mode="aspectFill" aria-hidden="true"/>
 <view class="map-backdrop-wash" aria-hidden="true"/>
 <view class="stage"><canvas id="map" type="2d" class="map" aria-label="{{view==='overview'?'全场卫星总览，可缩放拖动':'第'+selected+'洞球道图'}}" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"/><view class="error" wx:if="{{error}}" bindtap="retry">{{error}} · 重试</view><view class="map-loading" wx:if="{{loading&&(mapAvailable||view==='overview')&&!error}}">{{view==='overview'?'正在加载卫星图…':diagramMode?'正在加载球道图…':'正在加载卫星图…'}}</view></view>
 <view class="hole-meta"><view class="hole-selector" bindtap="openPicker" aria-label="选择球洞"><text>{{view==='overview'?'全场总览':h.displayTitle||'第 '+selected+' 洞'}}</text><image class="selector-chevron" src="/assets/chevron.png"/></view><text wx:if="{{h&&view==='hole'}}" class="par">PAR {{h.par}}</text><text class="course-caption">{{view==='overview'?shortName:courseCaption}}</text><view wx:if="{{view==='hole'&&(!diagramMode||hasRound)}}" class="tee-status"><text wx:if="{{hasRound}}" class="tee-dot" style="background:{{teeColor}}"></text><text>{{teeLabel}}</text></view><view wx:if="{{scoringHole&&selected!==scoringHole}}" class="return-current" bindtap="currentHole">回到记分洞 {{scoringHole}} ↗</view></view>
 <view class="card-yardage {{gpsAvailable&&view==='hole'?'gps-card':''}}" wx:if="{{h}}"><text>{{h.displayTitle}} · PAR {{h.par}}</text><text>{{cardTee}} · {{cardDistance}} 码（记分卡）</text><text wx:if="{{pendingSatellite&&!gpsAvailable}}">本洞卫星位置正在核对</text></view>
 <view wx:if="{{enhancedAvailable&&view==='hole'}}" class="layer-toggle" bindtap="toggleLayer" aria-label="切换精修图与卫星图"><text>{{layer==='enhanced'?'卫星图':'精修图'}}</text></view>
 <view wx:if="{{gpsAvailable&&view==='hole'}}" class="distance-stack"><view class="center-distance"><image class="flag-icon" src="{{assetRoot}}/icons/flag-light.png"/><text class="distance-label">果岭中心</text><view class="distance-number">{{center}}</view><text class="unit-label">{{unit}}</text></view><view class="edge-distances"><view><text>前沿</text><text>{{front}}</text></view><view><text>后沿</text><text>{{back}}</text></view></view><view wx:if="{{hasOverview}}" class="overview-link" bindtap="overview">全场总览</view></view>
 <view wx:if="{{diagramMode&&view==='hole'}}" class="diagram-tools"><view class="overview-link" bindtap="overview">全场卫星总览</view><text>球道示意图 · 双指缩放</text></view>
 <view wx:if="{{!mapAvailable&&view==='hole'}}" class="map-pending"><view class="pending-number">{{selected}}</view><view class="pending-title">第 {{selected}} 洞球道图待完善</view><text>该球场尚未制作本洞地图，记分仍可继续</text><view wx:if="{{hasOverview}}" class="pending-overview" bindtap="overview">查看全场卫星总览 ↗</view><view wx:else class="pending-note">全场卫星图待补充</view></view>
 <view wx:if="{{view==='hole'}}" class="hole-stepper"><button disabled="{{!previousHole}}" bindtap="previous" aria-label="上一洞"><image class="previous-icon" src="/assets/chevron.png"/></button><text>{{selected}} / {{holes.length}}</text><button disabled="{{!nextHole}}" bindtap="next" aria-label="下一洞"><image src="/assets/chevron.png"/></button></view><view wx:if="{{gpsAvailable&&view==='hole'}}" class="map-tip"><text>{{locationText}}</text><text>点按选落点</text><text>拖动起点 / 落点</text><text>双指缩放</text></view>
 <view wx:if="{{view==='overview'}}" class="overview-north">{{northLabel}}</view><view wx:if="{{view==='overview'}}" class="overview-tip"><text>{{locationText}}</text><text>双指缩放 · 拖动查看</text></view>
 <view wx:if="{{mapAvailable||view==='overview'}}" class="quick-controls"><view wx:if="{{view==='overview'}}" class="quick-button" bindtap="wholeCourse"><text>全场</text></view><view class="quick-button" bindtap="reset" aria-label="复位视角和落点"><image src="{{assetRoot}}/icons/arrows-out-simple.png"/><text>复位</text></view><view wx:if="{{gpsAvailable||view==='overview'}}" class="quick-button" bindtap="locate" aria-label="我的位置"><image src="{{assetRoot}}/icons/crosshair.png"/><text>定位</text></view></view>
 <view wx:if="{{mapAvailable||view==='overview'}}" class="map-foot" bindtap="info"><text>{{view==='overview'?'卫星总览 · 说明':diagramMode?'球道示意图 · 暂不提供 GPS 测距':'地图估算 · 说明'}}</text><text>{{view==='overview'?overviewAttribution:attribution}}</text></view>
 <view wx:if="{{pickerOpen}}" class="hole-sheet-shade" bindtap="closePicker"><view class="hole-sheet" catchtap="keepPicker"><view class="hole-sheet-head"><text>选择球洞</text><view bindtap="closePicker" class="sheet-close" aria-label="关闭选洞"><image src="{{assetRoot}}/icons/x.png"/></view></view><view class="sheet-course">{{courseName}}</view><view wx:if="{{hasOverview}}" class="sheet-overview" bindtap="overview"><text>全场卫星总览</text><image src="/assets/chevron.png"/></view><scroll-view scroll-y="{{true}}" class="hole-group-scroll"><view wx:for="{{groups}}" wx:key="id" class="hole-group"><view class="hole-group-title">{{item.title}}</view><view class="hole-grid"><view wx:for="{{item.holes}}" wx:for-item="hole" wx:key="sourceId" class="hole-option {{selected===hole.number&&view==='hole'?'selected':''}}" data-number="{{hole.number}}" bindtap="chooseHole"><text>{{hole.displayNumber}}</text><text class="hole-option-par">Par {{hole.par}}</text><view class="available-dot {{hole.mapAvailable?'ready':''}}"></view></view></view></view></scroll-view><view class="sheet-note"><text class="ready-dot"></text><text>{{hasOverview?availabilityNote:'该球场卫星图待补充'}}</text></view></view></view>
</view><privacy-panel/>
