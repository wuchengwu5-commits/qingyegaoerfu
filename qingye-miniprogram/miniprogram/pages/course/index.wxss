.course-detail{padding:26rpx 30rpx 54rpx}.page .course-overview{padding:0;overflow:hidden;margin-bottom:24rpx}.course-cover{height:206rpx;position:relative;overflow:hidden}.course-cover>image{width:100%;height:100%;filter:saturate(.78)}.cover-credit{position:absolute;bottom:12rpx;right:16rpx;font-size:18rpx;color:#f4faf6;background:rgba(31,63,44,.42);padding:5rpx 10rpx;border-radius:10rpx}.course-summary{padding:24rpx 28rpx 20rpx}.course-name-row{align-items:flex-start;gap:14rpx}.course-name-row .title{font-size:38rpx;line-height:1.5;letter-spacing:0;margin:0}.page .favorite-button{flex-shrink:0;display:flex;justify-content:center;align-items:center;width:64rpx;min-height:64rpx;height:64rpx;padding:0;margin:-3rpx -10rpx 0 0;border:0;border-radius:50%;background:transparent;box-shadow:none;backdrop-filter:none}.favorite-button image{width:37rpx;height:37rpx}.course-meta{font-size:25rpx;margin:8rpx 0 24rpx}.page .start-round{position:relative;display:flex;justify-content:center;align-items:center;gap:16rpx;width:100%;height:104rpx;line-height:104rpx;border-radius:56rpx;font-size:32rpx;letter-spacing:2rpx}.start-icon{width:34rpx;height:34rpx;flex-shrink:0}.start-arrow{position:absolute;right:24rpx;width:42rpx;height:42rpx;padding:7rpx;border-radius:50%;background:rgba(236,255,239,.13)}.start-hint{text-align:center;color:#617e6b;font-size:22rpx;line-height:1.6;margin-top:14rpx}.unavailable{padding:24rpx;text-align:center;background:rgba(218,235,224,.48);border-radius:24rpx;color:#476552;font-size:27rpx;line-height:1.6}.unavailable text{font-size:23rpx;color:#718676}.page .range-entry{padding:26rpx 28rpx}.detail-heading{font-size:29rpx;font-weight:600;color:#294f40;line-height:1.5}.menu-copy{font-size:23rpx;line-height:1.6;margin-top:6rpx}.detail-icon{width:38rpx;height:38rpx;flex-shrink:0;opacity:.85}.detail-arrow{width:24rpx;height:24rpx;flex-shrink:0;opacity:.7}.page .scorecard-panel,.page .sources-panel{padding:0;overflow:hidden}.page .disclosure{display:flex;align-items:center;gap:16rpx;width:100%;text-align:left;min-height:132rpx;line-height:1.5;padding:24rpx 26rpx;margin:0;border:0;border-radius:0;background:transparent;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none}.disclosure-label{font-size:23rpx;font-weight:400;color:#6c8978;white-space:nowrap}.disclosure-arrow{transform:rotate(90deg);width:20rpx;height:20rpx}.disclosure-arrow.expanded{transform:rotate(-90deg)}.scorecard-content,.sources-content{margin:0 26rpx;padding:20rpx 0 24rpx;border-top:1rpx solid rgba(87,123,102,.15)}.section-tabs{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.page .section-tabs .choice{flex:1;min-width:120rpx;min-height:76rpx;line-height:1.5;padding:18rpx 12rpx;margin:0;font-size:25rpx;border-radius:24rpx}.hole-table{border-radius:20rpx;overflow:hidden}.card-row{display:flex;align-items:center;min-height:70rpx;border-bottom:1rpx solid rgba(100,132,113,.14);text-align:center}.card-row:last-child{border:0}.card-row text{flex:1;font-size:26rpx;font-variant-numeric:tabular-nums;color:#325544}.page .hole-table .table-head{margin-top:0;background:rgba(57,101,77,.9)}.table-head text{color:#f1f9f4;font-size:23rpx}.single-section{padding:12rpx 4rpx 18rpx;font-size:28rpx}.scorecard-note{margin-top:20rpx;font-size:22rpx;line-height:1.7}.page .contact-panel{padding:4rpx 26rpx}.contact-row{padding:19rpx 0;min-height:106rpx}.contact-label{color:#718b7b;font-size:22rpx;margin-bottom:7rpx}.contact-value{font-size:26rpx;line-height:1.7;color:#3c5c4c}.contact-row .link{font-size:24rpx;white-space:nowrap}.sources-content .note{font-size:23rpx;line-height:1.8}.sources-content .menu{padding:18rpx 0;min-height:82rpx}

.tee-selector{margin-bottom:24rpx}.tee-selector-heading{font-size:23rpx;color:#6b8576;margin:0 2rpx 16rpx;line-height:1.6}.tee-options{display:flex;flex-wrap:wrap;gap:12rpx}.page .tee-option{position:relative;display:flex;align-items:center;justify-content:center;gap:10rpx;flex:1 0 132rpx;min-width:0;min-height:88rpx;line-height:1.4;padding:18rpx 12rpx;margin:0;border:1rpx solid rgba(255,255,255,.92);border-radius:22rpx;background:rgba(249,254,251,.48);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.65);color:#5c7566;font-size:25rpx;font-weight:400;letter-spacing:0}.page .tee-option.selected{background:linear-gradient(135deg,rgba(228,243,232,.94),rgba(208,230,215,.7));border-color:#91b19c;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.85),0 3rpx 10rpx rgba(47,90,65,.05);color:#284f3a;font-weight:600}.tee-dot{display:block;width:19rpx;height:19rpx;flex-shrink:0;border:1rpx solid rgba(57,80,65,.28);border-radius:50%;box-shadow:inset 0 1rpx 1rpx rgba(255,255,255,.28)}.tee-dot.neutral{border-style:dashed}.tee-label{min-width:0;overflow-wrap:anywhere}.tee-check{position:absolute;right:6rpx;top:3rpx;font-size:17rpx;line-height:1.2;color:#4c785b}.course-detail .section-tabs{margin-top:0;padding-top:22rpx;border-top:1rpx solid rgba(87,123,102,.12)}
