input{height:88rpx;background:#f0f3eb;border-radius:18rpx;padding:0 24rpx;box-sizing:border-box}.note{line-height:1.8}
.account-page{padding-top:56rpx}.login-card{padding:36rpx}.verified{display:flex;justify-content:space-between;gap:20rpx;color:#315b43;font-size:26rpx}.avatar-picker{display:flex;align-items:center;gap:24rpx;width:100%;padding:0;background:transparent;text-align:left;font-size:28rpx;color:#315b43}.avatar-picker::after{border:0}.account-avatar,.avatar-placeholder{width:112rpx;height:112rpx;border-radius:56rpx;flex-shrink:0}.avatar-placeholder{display:flex;align-items:center;justify-content:center;background:#dfeade;font-size:48rpx}.avatar-label{line-height:1.5}.account-error{color:#9b4037}.account-notice{color:#315b43}.privacy-link{text-align:center;margin-top:32rpx;font-size:24rpx;color:#617567;text-decoration:underline}
