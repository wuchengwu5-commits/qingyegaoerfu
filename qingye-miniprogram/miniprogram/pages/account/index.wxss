input{height:88rpx;background:#f0f3eb;border-radius:18rpx;padding:0 24rpx;box-sizing:border-box}.note{line-height:1.8}
.account-page{padding:72rpx 36rpx 64rpx}.account-hero{text-align:center}.account-wordmark{display:block;width:172rpx;height:108rpx;margin:0 auto 34rpx}.account-title{font-family:"Songti SC","STSong",serif;font-size:46rpx;line-height:1.5;font-weight:600;letter-spacing:1rpx;color:#194a36}.account-caption{margin-top:12rpx;font-size:26rpx;color:#667c69;line-height:1.7}
.account-page .login-card{margin-top:52rpx;padding:48rpx 36rpx 40rpx;border-radius:36rpx;text-align:center;border:1rpx solid rgba(255,255,255,.8);background:rgba(255,255,249,.58);box-shadow:0 12rpx 36rpx rgba(41,68,35,.06)}.login-title{font-size:34rpx;font-weight:600;line-height:1.5;color:#234f3a}.login-note{font-size:25rpx;line-height:1.8;color:#647965;margin-top:18rpx}.account-page .wechat-login-button{width:100%;margin-top:38rpx;min-height:96rpx;line-height:96rpx;border-radius:24rpx;font-size:30rpx;letter-spacing:1rpx}.account-footer{text-align:center;margin-top:32rpx}.account-footer .privacy-link{padding:16rpx 0;font-size:23rpx;color:#778773;text-decoration:underline;line-height:1.6}.account-back{display:flex;justify-content:center;align-items:center;gap:12rpx;padding:20rpx 0;font-size:26rpx;line-height:1.6;color:#4f7255}.account-back-arrow{font-size:32rpx}
.verified{text-align:center;color:#527a57;font-size:24rpx}.avatar-picker{display:flex;align-items:center;gap:24rpx;width:100%;padding:0;background:transparent;text-align:left;font-size:28rpx;color:#315b43}.avatar-picker::after{border:0}.account-avatar,.avatar-placeholder{width:112rpx;height:112rpx;border-radius:56rpx;flex-shrink:0}.avatar-placeholder{display:flex;align-items:center;justify-content:center;background:#dfeade;font-size:48rpx}.avatar-label{line-height:1.5}.account-error{color:#9b4037;line-height:1.7;text-align:center}.account-notice{color:#315b43;text-align:center}
@media(max-width:350px){.account-page{padding-left:28rpx;padding-right:28rpx}.account-title{font-size:44rpx;letter-spacing:0}.account-page .login-card{padding-left:28rpx;padding-right:28rpx}}
@media(max-height:700px){.account-page{padding-top:38rpx}.account-wordmark{height:88rpx;margin-bottom:24rpx}.account-page .login-card{margin-top:36rpx;padding-top:36rpx;padding-bottom:32rpx}.account-footer{margin-top:20rpx}}
