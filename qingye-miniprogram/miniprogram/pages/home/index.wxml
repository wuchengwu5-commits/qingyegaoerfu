<view class="page home-immersive" style="padding-top:{{topInset}}px">
  <image class="home-scene {{sceneMirrored?'theme-image-mirrored':''}}" src="{{sceneSrc}}" binderror="sceneError" mode="aspectFill" aria-hidden="true"/>
  <view class="home-scene-wash" aria-hidden="true"/>
  <view class="home-opening">
    <image class="home-wordmark" src="/assets/wordmark.png" mode="aspectFill" aria-label="青野高尔夫"/>
    <view class="home-heading">{{slogan.title}}</view>
    <view class="home-subtitle">{{slogan.subtitle}}</view>
  </view>
  <view class="home-bottom-panel">
    <view class="home-feature-link" data-id="{{featured.id}}" bindtap="course" aria-label="查看球场详情">
      <view class="home-course-copy">
        <view class="home-course-name">{{featured.name}}</view>
        <view class="home-course-meta">{{featured.meta}}</view>
      </view>
      <view class="home-feature-arrow"><image src="/assets/chevron.png" mode="aspectFit"/></view>
    </view>
    <view class="home-weather" wx:if="{{weather.hasData}}">
      <view class="home-weather-readings" aria-label="{{featured.name}}天气，{{weather.condition}}，{{weather.temperature}}，{{weather.windDirection}}，{{weather.windScale}}">
        <view class="home-weather-group"><image class="home-weather-icon" src="{{weather.icon}}" mode="aspectFit" aria-hidden="true"/><text class="home-weather-label">{{weather.condition}}</text><text class="home-weather-value">{{weather.temperature}}</text></view>
        <view class="home-weather-group home-wind"><image class="home-weather-icon" src="/assets/weather/wind.png" mode="aspectFit" aria-hidden="true"/><text class="home-weather-label">{{weather.windDirection}}</text><text class="home-weather-value">{{weather.windScale}}</text></view>
      </view>
    </view>
    <view wx:else class="home-weather-empty">{{weather.status==='loading'?'天气更新中…':weather.message}}</view>
    <view wx:if="{{weather.notice}}" class="home-weather-notice">{{weather.notice}}</view>
    <button class="primary home-start" hover-class="home-start-pressed" hover-stay-time="80" bindtap="start"><image class="home-start-icon" src="/assets/flag-white.png"/><text>前往记分</text><image class="home-start-arrow" src="/assets/arrow-light.png" mode="aspectFit"/></button>
    <view class="home-support" bindtap="about">木圣 AI <text class="home-support-dot">·</text> 让技术服务热爱</view>
  </view>
  <view class="home-scene-credit">AI 意境 · 非球场实拍</view>
</view>
<privacy-panel/>
<qy-dialog class="page-dialog"/>
