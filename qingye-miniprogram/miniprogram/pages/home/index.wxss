.page.home-immersive{isolation:isolate;position:relative;height:100vh;min-height:560px;box-sizing:border-box;display:flex;flex-direction:column;padding:30rpx 36rpx calc(190rpx + env(safe-area-inset-bottom));overflow:hidden;background:#c4d4b0}
.page.home-immersive::before{display:none}
.home-scene{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.page.home-immersive{padding-left:36rpx;padding-right:36rpx;padding-bottom:calc(142rpx + env(safe-area-inset-bottom));background:#cbd6c6}
.home-scene-wash{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(241,246,239,.19),rgba(244,246,237,.06) 36%,rgba(217,228,205,.07))}
.home-opening{position:relative;z-index:2;flex-shrink:0;padding:2rpx 18rpx 0;color:#163e31}
.home-wordmark{display:block;width:224rpx;height:146rpx;margin-left:-6rpx}
.home-heading{font-family:'Songti SC','STSong',serif;font-size:70rpx;line-height:1.32;font-weight:600;margin-top:26rpx;letter-spacing:-1rpx}
.home-subtitle{font-size:26rpx;line-height:1.6;color:#3c5d4d;margin-top:18rpx;letter-spacing:1rpx}
.home-bottom-panel{position:relative;z-index:2;flex-shrink:0;margin-top:auto;padding:28rpx 30rpx 0;border:1rpx solid rgba(255,255,255,.78);border-radius:34rpx;background:linear-gradient(135deg,rgba(249,255,245,.43),rgba(235,248,225,.19));box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.5),0 10rpx 28rpx rgba(29,56,33,.1);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.home-feature-link{display:flex;align-items:center;gap:16rpx;color:#173e32}
.home-course-copy{flex:1;min-width:0}
.home-course-name{font-size:35rpx;font-weight:600;line-height:1.45;word-break:break-word;letter-spacing:-.4rpx}.home-course-meta{font-size:24rpx;color:#385741;line-height:1.5;margin-top:8rpx}
.home-feature-arrow{width:54rpx;height:88rpx;display:flex;align-items:center;justify-content:flex-end;flex-shrink:0}.home-feature-arrow image{width:26rpx;height:26rpx;opacity:.65}
.page button.home-start.primary{position:relative;display:flex;align-items:center;justify-content:flex-start;gap:16rpx;width:100%;margin:26rpx 0 0;min-height:96rpx;line-height:1.4;padding:22rpx 28rpx;border-radius:48rpx;font-size:30rpx;font-weight:500;letter-spacing:.3rpx;color:#f5fff8;background:linear-gradient(118deg,rgba(115,162,108,.95),rgba(63,115,70,.96) 48%,rgba(34,84,53,.98));border:1rpx solid rgba(242,255,234,.6);box-shadow:inset 0 2rpx 2rpx rgba(255,255,255,.26),0 4rpx 12rpx rgba(35,83,59,.12)}
.home-start-icon{width:34rpx;height:34rpx;flex-shrink:0}.home-start-arrow{width:30rpx;height:30rpx;margin-left:auto;flex-shrink:0;opacity:.85}
.home-support{min-height:66rpx;display:flex;align-items:center;justify-content:center;gap:9rpx;font-size:21rpx;color:#36533e;letter-spacing:.3rpx}.home-support-dot{color:#55745b}
.home-scene-credit{position:absolute;z-index:2;right:40rpx;bottom:calc(164rpx + env(safe-area-inset-bottom));font-size:17rpx;line-height:1.4;color:#ebf4e8;text-shadow:0 1rpx 5rpx rgba(20,45,24,.6)}
@media(max-width:350px){.home-heading{font-size:64rpx}.home-opening{padding-left:10rpx;padding-right:10rpx}.home-course-name{font-size:33rpx}.home-bottom-panel{padding:24rpx 26rpx 0}.page button.home-start.primary{padding-left:24rpx;padding-right:24rpx}}
@media(max-height:740px){.home-wordmark{width:194rpx;height:126rpx}.home-heading{margin-top:14rpx;font-size:62rpx}.home-subtitle{margin-top:12rpx}.home-bottom-panel{padding-top:24rpx}.home-support{min-height:58rpx}.page button.home-start.primary{margin-top:22rpx}}
@media(max-height:640px){.home-wordmark{width:170rpx;height:110rpx}.home-heading{font-size:54rpx;line-height:1.22;margin-top:10rpx}.home-subtitle{font-size:24rpx;margin-top:10rpx}.home-bottom-panel{padding-top:20rpx}.home-course-name{font-size:31rpx}.home-support{min-height:54rpx}}

/* Reference calibration: quiet morning, editorial single line, milky glass. */
.home-opening{padding-left:18rpx;padding-right:0;color:#15382b}
.home-wordmark{width:248rpx;height:184rpx;margin-left:-5rpx}
.home-heading{font-size:60rpx;line-height:1.45;letter-spacing:-1rpx;font-weight:500;white-space:nowrap;margin-top:30rpx}
.home-subtitle{font-family:'Songti SC','STSong',serif;font-size:28rpx;color:#344c3c;letter-spacing:0;margin-top:12rpx}
.home-bottom-panel{min-height:340rpx;padding:28rpx 30rpx 4rpx;border-radius:38rpx;border-color:rgba(255,255,255,.64);background:linear-gradient(130deg,rgba(253,255,249,.38),rgba(249,253,242,.22));backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);box-shadow:inset 0 1rpx 1rpx rgba(255,255,255,.74),inset 0 -1rpx 1rpx rgba(255,255,255,.16),0 6rpx 22rpx rgba(30,56,34,.055)}
.home-feature-link{min-height:108rpx}.home-course-name{font-size:32rpx;font-weight:500;letter-spacing:0}.home-course-meta{font-size:25rpx;color:#59705c;margin-top:8rpx}
.home-feature-arrow{width:58rpx;height:58rpx;justify-content:center;border-radius:50%;background:rgba(252,255,247,.22);border:1rpx solid rgba(255,255,255,.38)}
.page button.home-start.primary{justify-content:center;margin-top:36rpx;min-height:92rpx;padding:18rpx 42rpx;font-size:30rpx;font-weight:400;background:linear-gradient(180deg,rgba(255,255,243,.07),rgba(255,255,243,0) 52%,rgba(15,49,25,.09)),linear-gradient(110deg,rgba(62,117,65,.96),rgba(31,83,46,.97));border:1rpx solid rgba(246,255,232,.23);box-shadow:inset 0 2rpx 2rpx rgba(252,255,241,.2),inset 0 -2rpx 4rpx rgba(26,64,33,.19),0 6rpx 14rpx rgba(30,66,35,.14);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);text-decoration:none;transition:transform .12s ease,box-shadow .12s ease}
.home-start-arrow{position:absolute;right:27rpx;width:28rpx;height:28rpx;margin-left:0}.home-support{font-size:22rpx;color:#324d35;min-height:54rpx}
.home-scene-credit{font-size:16rpx;bottom:calc(120rpx + env(safe-area-inset-bottom));color:#40583e;text-shadow:0 1rpx 3rpx #ffffff66}
@media(max-width:350px){.home-heading{font-size:58rpx}.home-subtitle{font-size:27rpx}.home-wordmark{width:232rpx;height:174rpx}.home-bottom-panel{min-height:320rpx}.page button.home-start.primary{margin-top:30rpx}}
@media(max-height:740px){.home-wordmark{width:228rpx;height:170rpx}.home-heading{font-size:58rpx;margin-top:18rpx}.home-bottom-panel{min-height:320rpx;padding-top:24rpx}.page button.home-start.primary{margin-top:28rpx}.home-support{min-height:54rpx}}
.home-scene{filter:saturate(.78) brightness(1.025)}

.home-start text{text-decoration:none;text-shadow:0 1rpx 2rpx rgba(24,59,31,.12)}
.page button.home-start.primary.home-start-pressed{transform:translateY(1rpx);box-shadow:inset 0 3rpx 6rpx rgba(25,60,30,.18),inset 0 1rpx 1rpx rgba(250,255,235,.18),0 2rpx 6rpx rgba(30,66,35,.1)}

/* Explicit edges for native WebView versions without inset shorthand support. */
.home-scene,.home-scene-wash{left:0;right:0;top:0;bottom:0}
.home-scene{display:block;width:100%;height:100%}

/* Rotating titles may wrap naturally without clipping on small screens. */
.home-heading{white-space:normal;overflow-wrap:break-word;max-width:100%}

/* Approved weather layout: quiet course metadata, two groups with larger values. */
.home-bottom-panel{min-height:362rpx}
.home-course-name{font-size:36rpx;font-weight:600}
.home-course-meta{font-size:22rpx;line-height:1.5;color:#4f6248;margin-top:8rpx}
.home-feature-link{min-height:94rpx}
.home-weather{display:flex;align-items:center;gap:12rpx;min-height:56rpx;margin-top:8rpx}
.home-weather-readings{display:flex;align-items:center;gap:54rpx;flex:1;min-width:0;min-height:56rpx}
.home-weather-group{display:flex;align-items:center;gap:14rpx;min-width:0;white-space:nowrap}
.home-weather-icon{display:block;width:36rpx;height:36rpx;flex-shrink:0}
.home-weather-label{font-size:24rpx;line-height:1.4;color:#5b7151;max-width:112rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.home-weather-value{font-size:36rpx;line-height:1.2;font-weight:600;color:#134d36;flex-shrink:0;font-variant-numeric:tabular-nums}
.home-wind .home-weather-label{max-width:none;overflow:visible;text-overflow:clip}
.home-weather-empty{font-size:24rpx;color:#617253;min-height:64rpx;display:flex;align-items:center;margin-top:10rpx}
.home-weather-notice{font-size:20rpx;line-height:1.4;color:#705f43;margin-top:2rpx}
.page button.home-start.primary{margin-top:22rpx}
@media(max-width:380px){.home-weather-readings{gap:30rpx}.home-weather-group{gap:10rpx}.home-weather-value{font-size:34rpx}.home-weather-label{max-width:96rpx}.home-weather{gap:8rpx}}
@media(max-height:740px){.home-bottom-panel{min-height:360rpx}.home-feature-link{min-height:86rpx}.home-weather,.home-weather-readings,.home-weather-empty{min-height:56rpx}.page button.home-start.primary{margin-top:18rpx}}

/* Clear glass: broad transparent areas, soft backing only beneath the copy. */
.page.home-immersive .home-bottom-panel{
 background:
  radial-gradient(ellipse 76% 34% at 24% 13%,rgba(249,253,241,.62) 0%,rgba(249,253,241,.34) 48%,rgba(249,253,241,0) 100%),
  radial-gradient(ellipse 78% 24% at 29% 43%,rgba(249,253,241,.42) 0%,rgba(249,253,241,.20) 55%,rgba(249,253,241,0) 100%),
  radial-gradient(ellipse 52% 13% at 50% 94%,rgba(249,253,241,.44) 0%,rgba(249,253,241,0) 100%),
  linear-gradient(125deg,rgba(250,255,245,.07),rgba(247,253,238,.025));
 border-color:rgba(250,255,240,.78);
 backdrop-filter:blur(1.5px);
 -webkit-backdrop-filter:blur(1.5px);
 box-shadow:inset 0 1rpx 1rpx rgba(255,255,247,.45),0 6rpx 22rpx rgba(25,52,30,.06);
}
.home-course-name,.home-course-meta,.home-weather-label,.home-weather-value,.home-weather-empty,.home-weather-notice,.home-support{text-shadow:0 .5rpx .8rpx rgba(251,255,244,.2)}
.home-course-meta{color:#34503a}
.home-weather-label,.home-weather-empty{color:#3c5638}
.home-support{color:#274831}
.home-feature-arrow{background:rgba(250,255,243,.13);border-color:rgba(250,255,242,.3)}
