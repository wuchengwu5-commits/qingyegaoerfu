<view class="page"><image class="page-backdrop" src="cloud://cloud1-d7gketoi570d17f80.636c-cloud1-d7gketoi570d17f80-1524135194/media-v1/assets__spring-lake.webp" mode="aspectFill" aria-hidden="true"/>
<view class="eyebrow">YOUR GOLF JOURNAL</view><view class="title">留住每一场好球</view><view class="sub">每次出发，都有新的收获</view><view class="segment"><view wx:for="{{filters}}" wx:key="id" class="{{filter===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.label}}</view></view><input placeholder="搜索球场名称" bindinput="search" value="{{query}}"/><view wx:for="{{items}}" wx:key="id" class="card space"><view class="row" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="open"><view class="grow"><text class="pill">{{item.status==='active'?'进行中':item.status==='paused'?'已暂存':'已结束'}}</text><view style="font-size:31rpx;font-weight:600;margin:18rpx 0 8rpx">{{item.courseName}}</view><view class="muted">{{item.date}} · {{item.players.length}} 人 · {{item.played}}/{{item.holes.length}} 洞</view></view><view style="text-align:right"><text class="num">{{item.totalText}}</text><text class="pill">{{item.diffText}}</text></view></view><view class="divider"/><view class="row"><text class="muted">{{item.tee}}</text><text class="link" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="open">{{item.status==='active'||item.status==='paused'?'继续记分':'查看记分卡'}} →</text><text class="danger small" data-id="{{item.id}}" bindtap="remove">删除</text></view></view><view wx:if="{{!items.length}}" class="empty"><view class="num">⚑</view><view>这里还没有球局</view><view class="sub">你的下一场好球，从现在开始</view><button class="primary space" bindtap="home">去选球场</button></view>
</view>

<privacy-panel/>
