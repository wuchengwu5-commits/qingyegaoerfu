<view class="page"><scene-backdrop/><view class="title">我的球局</view><view class="sub">普通球局和比赛，都在这里继续。</view>
 <view class="segment"><view wx:for="{{filters}}" wx:key="id" class="{{filter===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.label}}</view></view>
 <input placeholder="搜索球场或比赛名称" bindinput="search" value="{{query}}"/>
 <view wx:if="{{cloudError}}" class="note space" bindtap="loadCloud">{{cloudError}}</view>
 <view wx:for="{{items}}" wx:key="key" class="card space" data-id="{{item.key}}" bindtap="open" role="button"><view class="row"><text class="pill">{{item.type}} · {{item.state}}</text><text class="link">{{item.status==='active'||item.status==='paused'?'继续 ›':'查看 ›'}}</text></view><view class="section">{{item.name}}</view><view class="row"><view class="muted">{{item.date}}<text wx:if="{{item.kind==='competition'}}"> · {{item.groupCount}} 组</text><text wx:else> · {{item.players}} 人 · {{item.played||0}}/{{item.holes||0}} 洞</text></view><text wx:if="{{item.total!=='—'}}" class="history-total">{{item.total}} 杆</text></view></view>
 <view wx:if="{{backups.length}}" class="card space"><view class="row" bindtap="backups" role="button"><text>待核对本机副本 · {{backups.length}}</text><text class="link">{{showBackups?'收起 −':'展开 ＋'}}</text></view><view wx:if="{{showBackups}}"><view class="note space">同步冲突时保留的原记录，可与正式记分牌核对。</view><view wx:for="{{backups}}" wx:key="key" class="menu row" data-id="{{item.key}}" bindtap="open"><view class="grow">{{item.name}}<view class="note">{{item.played}}/{{item.holes}} 洞 · {{item.total}} 杆</view></view><text class="link">查看 ›</text></view></view></view>
 <view wx:if="{{!items.length&&!backups.length}}" class="empty"><view>还没有球局记录</view><button class="primary space" bindtap="home">创建新球局</button></view>
</view><privacy-panel/>
