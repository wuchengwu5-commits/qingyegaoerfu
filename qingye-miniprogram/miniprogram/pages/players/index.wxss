.players-page{padding-bottom:calc(52rpx + env(safe-area-inset-bottom))}.players-note{margin:20rpx 4rpx 26rpx;font-size:25rpx;line-height:1.7;color:#6b7e65}.players-page button.account-entry{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:112rpx;padding:22rpx 28rpx;margin:24rpx 0;text-align:left;line-height:1.5;font-size:29rpx;font-weight:500;border-radius:30rpx}.account-entry .note{font-size:23rpx;font-weight:400;margin-top:4rpx}.account-entry>text{color:#75886c;font-size:34rpx}.players-page .member-card{padding:0 24rpx;border-radius:30rpx;margin-bottom:18rpx}.players-page button.member-heading{display:flex;align-items:center;gap:18rpx;min-height:136rpx;width:100%;padding:20rpx 0;margin:0;border:0;box-shadow:none;background:transparent;text-align:left;line-height:1.5;font-weight:400}.players-page .member-heading[disabled]{opacity:1;color:inherit}.member-seat{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:50%;background:rgba(216,231,206,.65);color:#6d8562;font-size:27rpx;flex:none}.member-name{font-size:30rpx;font-weight:600;color:#294e36;overflow-wrap:anywhere}.member-meta{display:flex;align-items:center;gap:10rpx;font-size:23rpx;line-height:1.6;color:#71836a;margin-top:5rpx}.member-tee-dot{height:16rpx;width:16rpx;flex:none;border-radius:50%;border:1rpx solid rgba(55,76,51,.3);margin-left:10rpx}.member-edit{font-size:25rpx;color:#647e59;flex:none}.member-editor{padding-bottom:24rpx;border-top:1rpx solid #dfe7d8}.players-page .member-field{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:104rpx;width:100%;margin:0;padding:14rpx 0;border:0;border-radius:0;border-bottom:1rpx solid #dfe7d8;box-shadow:none;background:transparent;line-height:1.5;font-size:27rpx;font-weight:400;text-align:left}.member-field>text:last-child{text-align:right;min-width:0;overflow-wrap:anywhere}.member-actions{display:flex;gap:16rpx;margin-top:22rpx}.member-actions button{flex:1;min-height:88rpx;line-height:1.5;padding:22rpx 12rpx;font-size:27rpx;margin:0}.member-error{font-size:26rpx;color:#886b43;line-height:1.7}.member-error button{margin-top:16rpx;min-height:88rpx}
