.knowledge-page{padding-left:32rpx;padding-right:32rpx}.knowledge-heading{margin:36rpx 12rpx 32rpx}.knowledge-heading .eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#668778}.knowledge-heading .title{font-size:52rpx;margin:12rpx 0 8rpx;letter-spacing:0}.knowledge-heading .sub{font-size:26rpx}.reading-cover{height:294rpx;position:relative;overflow:hidden;border-radius:34rpx;border:1rpx solid rgba(255,255,255,.8);margin-bottom:28rpx;box-shadow:0 12rpx 32rpx rgba(37,72,56,.09)}.reading-photo,.reading-shade{position:absolute;inset:0;width:100%;height:100%}.reading-photo{filter:saturate(.7)}.reading-shade{background:linear-gradient(0deg,rgba(21,60,43,.91),rgba(21,60,43,.08) 95%)}.reading-caption{position:absolute;bottom:26rpx;left:28rpx;right:28rpx;color:#f5fff8}.reading-kicker{font-size:21rpx;letter-spacing:2rpx;color:#e4f0df}.reading-title{font-family:'Songti SC','STSong',serif;font-size:38rpx;line-height:1.6;margin-top:5rpx}.reading-bottom{display:flex;justify-content:space-between;align-items:center;font-size:23rpx;color:#e1eee3}.reading-bottom image{width:38rpx;height:38rpx}.knowledge-categories{display:flex;gap:12rpx;margin:24rpx 0 26rpx}.page .knowledge-categories .choice{flex:1;min-width:0;margin:0;min-height:76rpx;line-height:76rpx;padding:0 10rpx;font-size:26rpx;white-space:nowrap;border-radius:44rpx}.catalog-heading{padding:0 8rpx;margin:0 0 18rpx;font-size:30rpx;font-weight:600}.catalog-heading .note{font-size:23rpx;font-weight:400}.page .article-list{padding:0 26rpx;margin:0}.article-row{display:flex;align-items:center;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid rgba(73,111,90,.13);min-height:166rpx}.article-row:last-child{border-bottom:0}.article-number{align-self:flex-start;margin-top:5rpx;font-size:23rpx;font-variant-numeric:tabular-nums;color:#729083;width:30rpx;flex-shrink:0}.article-meta{font-size:21rpx;color:#6a8578;line-height:1.6}.article-title{font-size:28rpx;color:#214b3b;line-height:1.55;font-weight:600;margin:5rpx 0}.article-summary{font-size:23rpx;line-height:1.65;color:#5c776b}.article-arrow{width:24rpx;height:24rpx;flex-shrink:0;opacity:.65}.knowledge-footer{margin:28rpx 0;text-align:center;font-size:23rpx}
