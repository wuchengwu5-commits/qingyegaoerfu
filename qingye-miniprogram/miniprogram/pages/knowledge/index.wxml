<view class="page knowledge-page"><scene-backdrop/>
 <view class="section">下场常用</view>
 <view class="card article-list">
  <view wx:for="{{essentials}}" wx:key="id" class="article-row" data-id="{{item.id}}" bindtap="article">
   <view class="grow"><view class="article-title">{{item.title}}</view><view class="article-summary">{{item.summary}}</view></view><image class="article-arrow" src="/assets/chevron.png"/>
  </view>
 </view>
 <button class="space" bindtap="toggle">{{expanded?'收起目录':'更多知识'}}</button>
 <block wx:if="{{expanded}}">
 <view class="knowledge-search search-field"><image class="search-icon" src="/assets/search.png" mode="aspectFit"/><input class="search-input" placeholder-class="search-placeholder" placeholder="搜索规则、礼仪或关键词" value="{{query}}" bindinput="search" confirm-type="search"/></view>
 <view class="knowledge-categories"><button wx:for="{{categories}}" wx:key="id" class="choice {{category===item.id?'active':''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</button></view>
 <view class="catalog-heading row"><text>阅读目录</text><text class="note">{{query||category!=='all'?count:total}} 篇</text></view>
 <view wx:if="{{items.length}}" class="card article-list">
  <view wx:for="{{items}}" wx:key="id" class="article-row" data-id="{{item.id}}" bindtap="article" role="button" aria-label="{{item.title}}">
   <text class="article-number">{{item.number}}</text><view class="grow"><view class="article-meta">{{item.categoryName}} · 约 {{item.minutes}} 分钟</view><view class="article-title">{{item.title}}</view><view class="article-summary">{{item.summary}}</view></view><image class="article-arrow" src="/assets/chevron.png" mode="aspectFit"/>
  </view>
 </view>
 <view wx:else class="card empty"><view>没有找到相关内容</view><view class="sub">试试“抛球”“果岭”或“礼仪”。</view><button class="space" bindtap="clear">查看全部文章</button></view>
</block></view><privacy-panel/>
<qy-dialog class="page-dialog"/>
