<view class="page result-page"><scene-backdrop/>
 <view wx:if="{{error}}" class="result-notice" bindtap="reload">{{error}} · 点击刷新</view>
 <block wx:if="{{r}}">
 <view class="card result-heading"><view class="result-course">{{r.courseName}}</view><view class="result-meta">{{date}} · {{r.holes.length}} 洞 · {{r.players.length}} 位球友<text wx:if="{{finished}}"> · {{cancelled?'已取消':'已结束'}}</text><text wx:elif="{{editing}}"> · 更正中</text></view></view>
 <button class="result-player-details" bindtap="playerDetails"><text>组员资料</text><text>称呼与发球台 ›</text></button>
 <view class="card scorecard-panel">
 <view class="result-panel-heading"><text>逐洞成绩</text><button class="card-rules" bindtap="rules">本场规则 ›</button></view>
 <view class="card-tabs">
  <button class="card-tab {{half==='front'?'active':''}}" data-id="front" bindtap="half" aria-pressed="{{half==='front'}}">前九 OUT</button>
  <button wx:if="{{r.holes.length>9}}" class="card-tab {{half==='back'?'active':''}}" data-id="back" bindtap="half" aria-pressed="{{half==='back'}}">后九 IN</button>
 </view>
 <view class="full-card" role="table" aria-label="全组逐洞记分卡">
  <view class="full-card-row full-card-head" role="row"><view class="card-name-cell head-name" role="columnheader">球友 / 洞</view><view wx:for="{{cardHoles}}" wx:key="number" class="card-hole-cell" role="columnheader"><text wx:if="{{item.cardSection}}" class="card-section">{{item.cardSection}}</text><text class="card-hole-number">{{item.cardLabel}}</text><text class="card-hole-par">Par {{item.par}}</text></view></view>
  <view wx:for="{{cardPlayers}}" wx:key="id" class="full-card-row" role="row">
   <view class="card-name-cell" role="rowheader"><view class="card-player-identity"><view class="card-tee-dot" style="background:{{item.teeColor}}" aria-label="{{item.tee}}发球台"></view><text class="card-player-name">{{item.name}}</text></view><text wx:if="{{item.isMine&&item.name!=='我'}}" class="card-mine">我</text></view>
   <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="number" class="card-hole-cell card-score-cell" data-pid="{{item.id}}" data-number="{{cell.number}}" bindtap="edit" aria-label="{{item.name}}，第{{cell.number}}洞，{{cell.recorded?cell.value+'杆':'未记录'}}"><view class="score-mark card-score {{cell.kind}}">{{cell.value}}</view></view>
  </view>
 </view>
 <view class="card-legend"><view><text class="legend-symbol score-mark eagle"/>老鹰或更好</view><view><text class="legend-symbol score-mark birdie"/>小鸟</view><view><text class="legend-symbol score-mark bogey"/>柏忌</view><view><text class="legend-symbol score-mark double"/>双柏忌或更差</view></view>
 </view>
 <view class="card result-summary"><view class="result-panel-heading">本轮汇总<text class="result-meta">实际完洞成绩</text></view>
 <view class="card-totals" role="table" aria-label="全组实际成绩汇总">
  <view class="total-row total-head" role="row"><text>球友</text><text>已记总杆</text><text>相对杆</text><text>进度</text></view>
  <view wx:for="{{cardPlayers}}" wx:key="id" class="total-row" role="row"><text class="total-name">{{item.name}}</text><text class="total-strokes">{{item.totalText}}</text><text>{{item.diffText}}</text><text>{{item.played}}/{{r.holes.length}}</text></view>
 </view>
 <view class="card-footnote">未记球洞保留空白，不计入总杆。</view>
 </view>
 <view wx:if="{{!recordOnly}}" class="card result-section"><view class="row"><text>{{main.title}}</text><text class="result-meta">{{main.state}}</text></view><view wx:if="{{main.result}}" class="section">{{main.winner}} {{main.result}}</view><view wx:for="{{main.rows}}" wx:key="id" class="row result-detail-row"><text>{{item.rank || '—'}} · {{item.name}}<text wx:if="{{item.disqualified}}"> · 退赛/取消资格</text></text><text>{{item.played?item.total:'—'}} {{main.unit}}</text></view><view class="result-meta">{{main.explanation}}</view></view>
 <view wx:for="{{side}}" wx:key="id" class="card result-section"><view class="row"><text>{{item.name}}</text><text class="result-meta">{{item.state}}</text></view><view wx:for="{{item.contests}}" wx:for-item="c" wx:key="contestId" class="row result-detail-row"><text>{{c.label}} · {{c.state}}</text><text>{{c.winner}} {{c.result}}</text></view><view wx:for="{{item.totals}}" wx:for-item="t" wx:key="id" class="row result-detail-row"><text>{{t.name}}</text><text>{{t.text}} {{item.unit}}</text></view><view wx:if="{{item.unallocated}}" class="result-meta">未分配 {{item.unallocated}} 点</view></view>
 <view class="card result-more row" bindtap="toggleActions" role="button"><text>更多操作与修订记录</text><text>{{moreActions?'收起':'展开'}}</text></view>
 <view wx:if="{{moreActions}}" class="card result-details">
  <button wx:if="{{finished&&canEdit&&!cancelled}}" class="result-detail-link" bindtap="beginEdit">更正成绩 ›</button>
  <button wx:if="{{canEdit}}" class="result-detail-link" bindtap="reviseRules">更正规则与球洞 ›</button>
  <button class="result-detail-link" bindtap="copy">复制成绩与修订号 ›</button>
  <button wx:if="{{needsSourceConfirmation&&canEdit}}" class="result-detail-link" bindtap="confirmSources">核对旧记录来源 ›</button>
  <button class="result-detail-link" bindtap="calculations">让杆与比赛计算明细 {{calculation?'收起':'展开'}}</button>
  <view wx:if="{{calculation}}"><view wx:for="{{rows}}" wx:key="number" class="card result-section"><view>第 {{item.number}} 洞 · Par {{item.par}}</view><view wx:for="{{item.values}}" wx:for-item="v" wx:key="id" class="row result-detail-row"><text>{{v.id}}</text><view><view>实际 {{v.raw}}</view><view class="result-meta">让 {{v.allowance}} · 净 {{v.net}} · 计 {{v.derived}}</view></view></view></view></view>
  <view class="section">修订记录</view><view wx:if="{{historyError}}" class="result-meta" bindtap="reload">{{historyError}}</view><view wx:for="{{log}}" wx:key="revision" class="card result-section">修订 {{item.revision}} · {{item.reason}}<view class="result-meta">{{item.date}}</view><view class="result-meta">{{item.details}}</view></view><view wx:if="{{!log.length}}" class="result-meta">暂无修订记录</view>
 </view>
 </block>
<view wx:if="{{r}}" class="card-footer">
 <button wx:if="{{canFinish}}" class="card-return" bindtap="resume">继续记分</button>
 <button wx:if="{{canFinish}}" class="primary card-finish" bindtap="finish" loading="{{ending}}" disabled="{{ending}}">核对成绩 · 结束本轮</button>
 <button wx:elif="{{finished&&!cancelled}}" class="primary card-finish" bindtap="share">分享本场成绩</button>
 <button wx:elif="{{!finished}}" class="primary card-finish" bindtap="resume">{{editing?'继续更正成绩':'返回本组记分'}}</button>
 <button wx:else class="primary card-finish" bindtap="hub">返回记分</button>
</view>
</view>
<privacy-panel/><qy-dialog class="page-dialog"/>
