/* Use the same scene, glass surfaces, score symbols and primary button as scoring. */
.page.result-page{min-height:100vh;padding:24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));color:#294b37}
.result-page .result-heading{padding:30rpx 28rpx 26rpx;margin:0 0 22rpx;border-radius:38rpx}.result-course{font-size:44rpx;font-weight:600;line-height:1.45;color:#204735;overflow-wrap:anywhere}.result-meta{font-size:23rpx;font-weight:400;color:#667e67;line-height:1.7}.result-heading .result-meta{margin-top:14rpx}.result-notice{margin-bottom:18rpx;padding:22rpx;background:#eef2e5;border-radius:20rpx;font-size:24rpx;color:#6b7e60}
.result-page .scorecard-panel,.result-page .result-summary{padding:16rpx 20rpx 20rpx;margin-bottom:22rpx;border-radius:36rpx}.result-panel-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:80rpx;font-size:30rpx;font-weight:600;padding:0 4rpx}.result-page button.card-rules{display:flex;align-items:center;justify-content:flex-end;width:auto;min-height:88rpx;line-height:1.5;margin:0;padding:12rpx 0 12rpx 14rpx;background:transparent;border:0;border-radius:0;box-shadow:none;font-size:24rpx;font-weight:400;color:#607b5d}
.card-tabs{display:flex;gap:8rpx;padding:7rpx;margin:0 0 20rpx;border-radius:22rpx;background:rgba(218,231,208,.6)}.result-page button.card-tab{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;width:auto;max-width:none;min-height:82rpx;margin:0;padding:14rpx 6rpx;border:1rpx solid transparent;border-radius:17rpx;background:transparent;color:#627a5b;font-size:27rpx;font-weight:400;line-height:1.5;box-shadow:none}.result-page button.card-tab.active{background:rgba(253,255,248,.9);border-color:rgba(255,255,255,.7);color:#2f5837;font-weight:600;box-shadow:0 3rpx 10rpx rgba(36,63,43,.05)}
.full-card{overflow:hidden;border:1rpx solid #dce5d5;border-radius:20rpx;background:rgba(249,252,242,.92)}.full-card-row{display:flex;min-height:100rpx}.full-card-head{min-height:100rpx;background:#476d50}.card-name-cell{box-sizing:border-box;flex:0 0 100rpx;width:100rpx;display:flex;flex-direction:column;justify-content:center;padding:14rpx 10rpx;background:rgba(225,236,216,.63);border-bottom:1rpx solid #e1e8d9;border-right:1rpx solid #e1e8d9;color:#34583e;font-size:25rpx;line-height:1.4}.card-player-name{word-break:break-all;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-weight:500}.card-mine{margin-top:6rpx;font-size:21rpx;color:#6b8060}.head-name{font-size:22rpx;color:#f5faf0;background:#476d50;text-align:center;padding:8rpx 2rpx;white-space:nowrap;border-color:rgba(255,255,255,.2)}.card-hole-cell{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10rpx 0;box-sizing:border-box;gap:4rpx}.full-card-head .card-hole-cell{border-right:1rpx solid rgba(255,255,255,.17)}.card-hole-number{font-size:26rpx;font-weight:600;line-height:1.35;color:#f8fcf3}.card-hole-par{font-size:20rpx;line-height:1.4;color:#dce8d6;white-space:nowrap}.card-section{font-size:18rpx;max-width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#dce8d6}.card-score-cell{border-bottom:1rpx solid #e1e8d9;border-right:1rpx solid #e1e8d9}.full-card-row:last-child .card-score-cell,.full-card-row:last-child .card-name-cell{border-bottom:0}.card-hole-cell:last-child{border-right:0}.result-page .card-score{width:44rpx;min-width:44rpx;height:44rpx;font-size:28rpx;font-weight:600;font-variant-numeric:tabular-nums}.result-page .card-score.par{color:#294b37;background:transparent}.result-page .card-score.blank{color:#b1bfaa;font-size:26rpx;font-weight:400}
.card-legend{display:flex;justify-content:center;gap:12rpx 22rpx;flex-wrap:wrap;margin:22rpx 0 0;color:#60745b;font-size:24rpx;line-height:1.6}.card-legend>view{display:flex;align-items:center;gap:7rpx;white-space:nowrap}.result-page .card-legend .legend-symbol{width:24rpx;min-width:24rpx;height:24rpx}.result-page .card-legend .eagle{box-shadow:inset 0 0 0 2rpx #fff3ef,inset 0 0 0 3rpx #d65057}
.card-totals{overflow:hidden;border:1rpx solid #dce5d5;border-radius:20rpx;background:rgba(249,252,242,.78)}.total-row{display:grid;grid-template-columns:minmax(0,1fr) 26% 21% 18%;align-items:center;min-height:92rpx;padding:14rpx 16rpx;border-bottom:1rpx solid #e1e8d9;box-sizing:border-box;font-size:26rpx;gap:4rpx}.total-row:last-child{border-bottom:0}.total-row>text{text-align:center}.total-row>text:first-child{text-align:left}.total-row>text:last-child{text-align:right}.total-head{min-height:72rpx;background:rgba(225,236,216,.7);color:#607857;font-size:22rpx}.total-name{word-break:break-all;line-height:1.5}.total-row .total-strokes{font-size:38rpx;font-weight:600;line-height:1.4;color:#28543b;font-variant-numeric:tabular-nums}.card-footnote{font-size:22rpx;color:#6b7e65;line-height:1.6;margin:18rpx 4rpx 0}
.result-page .result-section{padding:26rpx;margin-bottom:20rpx;border-radius:30rpx;font-size:27rpx;line-height:1.6}.result-detail-row{padding:16rpx 0;font-size:25rpx}.result-page .result-more{min-height:100rpx;padding:20rpx 26rpx;border-radius:28rpx;font-size:25rpx;color:#607857}.result-page .result-details{padding:12rpx 26rpx 26rpx;border-radius:30rpx}.result-page button.result-detail-link{width:100%;max-width:none;background:transparent;box-shadow:none;border:0;border-radius:0;min-height:92rpx;padding:24rpx 0;margin:0;text-align:left;font-size:25rpx;font-weight:400;line-height:1.6;border-bottom:1rpx solid #dfe7d8}.result-details .result-section{box-shadow:none;background:transparent;border:0;border-bottom:1rpx solid #dfe7d8;border-radius:0;padding:22rpx 0}
.card-footer{display:flex;gap:16rpx;position:fixed;bottom:0;left:0;right:0;z-index:20;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(248,252,239,.86);border:1rpx solid rgba(255,255,255,.4);border-bottom:0;border-radius:32rpx 32rpx 0 0;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 -4rpx 20rpx rgba(30,56,34,.04)}.card-footer button{display:flex;align-items:center;justify-content:center;width:auto;max-width:none;margin:0;min-height:92rpx;padding:18rpx 12rpx;line-height:1.5;border-radius:22rpx;font-size:27rpx;font-weight:500}.result-page .card-footer .card-return{flex:0 0 180rpx;background:rgba(224,236,215,.6);border:1rpx solid rgba(104,135,89,.16);color:#3e6048;box-shadow:none}.card-footer .card-finish{flex:1}.card-footer .card-finish[disabled]{opacity:.5;box-shadow:none}
@media(max-width:330px){.result-course{font-size:44rpx}.result-page .scorecard-panel,.result-page .result-summary{padding-left:14rpx;padding-right:14rpx}.card-name-cell{flex-basis:96rpx;width:96rpx}.result-page .card-footer .card-return{flex-basis:170rpx}.card-footer button{font-size:25rpx}}

.result-page button.result-player-details{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%;min-height:88rpx;margin:-12rpx 0 16rpx;padding:14rpx 14rpx;background:transparent;border:0;border-radius:0;box-shadow:none;font-size:26rpx;font-weight:500;line-height:1.5}.result-player-details text:last-child{font-size:23rpx;font-weight:400;color:#718168}.card-player-identity{display:flex;flex-direction:column;align-items:flex-start;gap:8rpx}.card-tee-dot{width:14rpx;height:14rpx;flex:none;border:1rpx solid rgba(55,76,51,.3);border-radius:50%}
