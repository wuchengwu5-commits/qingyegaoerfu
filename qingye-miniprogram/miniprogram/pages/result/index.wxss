.player-summary{min-height:96rpx}.live-total{font-size:46rpx;font-weight:600;text-align:right}.live-total text{display:block;font-size:24rpx;color:#87967b;font-weight:400}.journal-cards{display:flex;flex-wrap:wrap;gap:14rpx}.journal-card{width:calc((100% - 14rpx) / 2);padding:18rpx;background:#f6f8f1;border-radius:18rpx}.journal-card .score-mark{width:56rpx;min-width:56rpx;height:56rpx;font-size:32rpx}.journal-card .note{font-size:23rpx}

.result-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:26rpx 0 8rpx}.page .result-actions button{display:flex;align-items:center;justify-content:center;width:100%;max-width:none;min-width:0;margin:0;min-height:88rpx;line-height:1.5;padding:18rpx 12rpx;font-size:26rpx;white-space:normal;word-break:normal;border-radius:24rpx}.page .result-actions .result-share{grid-column:1/-1;font-size:30rpx;min-height:96rpx}.result-more{font-size:27rpx;min-height:88rpx}.result-secondary{margin-top:16rpx}
