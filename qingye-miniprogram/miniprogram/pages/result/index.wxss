.player-summary{min-height:96rpx}.live-total{font-size:46rpx;font-weight:600;text-align:right}.live-total text{display:block;font-size:24rpx;color:#87967b;font-weight:400}.journal-cards{display:flex;flex-wrap:wrap;gap:14rpx}.journal-card{width:calc((100% - 14rpx) / 2);padding:18rpx;background:#f6f8f1;border-radius:18rpx}.journal-card .score-mark{width:56rpx;min-width:56rpx;height:56rpx;font-size:32rpx}.journal-card .note{font-size:23rpx}
