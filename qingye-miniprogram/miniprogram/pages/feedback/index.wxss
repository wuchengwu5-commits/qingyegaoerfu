textarea{box-sizing:border-box;width:100%;height:280rpx;border:1rpx solid #e1e8da;font-size:29rpx;line-height:1.8;padding:16rpx;border-radius:16rpx}
.feedback-content{white-space:pre-wrap;word-break:break-all;line-height:1.75}
.feedback-id{word-break:break-all;margin-top:20rpx}
.segment>view{min-width:0}

.feedback-admin-summary{margin-bottom:24rpx}
.feedback-admin-title{display:flex;align-items:center;gap:16rpx;margin-bottom:10rpx;font-size:30rpx;font-weight:600;color:#294b38}
.feedback-admin-count{font-size:24rpx;font-weight:400;color:#73866c}
.feedback-admin-actions{display:flex;align-items:stretch;gap:16rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid rgba(92,125,89,.14)}
.feedback-page .feedback-admin-actions button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:1;width:0;max-width:none;margin:0;min-height:88rpx;padding:16rpx 8rpx;border-radius:20rpx;font-size:27rpx;font-weight:500;line-height:1.4;white-space:nowrap;box-shadow:none}
.feedback-page .feedback-admin-actions .feedback-refresh{background:rgba(219,234,211,.68);border:1rpx solid rgba(127,157,117,.12);color:#365e3f}
.feedback-page .feedback-admin-actions .feedback-copy{background:rgba(250,253,247,.48);border:1rpx solid rgba(127,157,117,.22);color:#53704e}
.feedback-page .feedback-admin-actions button[disabled]{color:#96a18d;background:rgba(235,240,228,.55)}
