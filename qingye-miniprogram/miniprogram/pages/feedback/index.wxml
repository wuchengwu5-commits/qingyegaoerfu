<view class="page"><image class="page-backdrop" src="cloud://cloud1-d7gketoi570d17f80.636c-cloud1-d7gketoi570d17f80-1524135194/media-v1/assets__spring-lake.webp" mode="aspectFill" aria-hidden="true"/><view class="title">把不好用的地方，<view/>告诉我们。</view><view class="sub">建议、纠错与版权沟通，我们都会认真对待。</view><view class="segment"><view class="{{tab==='new'?'active':''}}" data-id="new" bindtap="tab">提交反馈</view><view class="{{tab==='history'?'active':''}}" data-id="history" bindtap="tab">我的反馈</view></view><view wx:if="{{tab==='new'}}"><view class="card"><view class="note">反馈类型</view><picker class="choice-picker choice-inset" data-title="反馈类型" value="{{categoryIndex}}" range="{{categories}}" bindchange="category"><view class="select-field "><view class="select-copy"><view class="select-value">{{draft.category}}</view></view><image class="select-chevron" src="/assets/chevron.png" aria-hidden="true"/></view></picker><view class="section">问题或建议</view><textarea maxlength="2000" value="{{draft.content}}" data-key="content" bindinput="input" placeholder="在哪个页面、做了什么操作、遇到了什么问题？也欢迎写下你想要的功能。"/><view class="section">联系方式 <text class="note">选填</text></view><input value="{{draft.contact}}" data-key="contact" bindinput="input" maxlength="120" placeholder="手机、微信或邮箱，仅用于回复反馈"/><view class="note spaced">草稿自动保存在本机。只提交填写的内容，不附带位置或球局记录。</view></view><view wx:if="{{!connected}}" class="quiet-card spaced"><view>草稿已保存在本机</view><view class="note">反馈后台尚未配置上线地址，暂未发送给我们。急需联系可致电吴先生。</view><view class="location-action" bindtap="contact">185 2159 7226 ›</view></view><view wx:if="{{error}}" class="danger spaced">{{error}}</view><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="submit">{{connected?'提交反馈':'保存反馈草稿'}}</button></view><view wx:else><view wx:if="{{!receipts.length}}" class="empty">这里会留下我们的交流。</view><view wx:for="{{receipts}}" wx:key="id" class="card"><view class="row"><text>{{item.category}}</text><text class="pill">{{item.status==='new'?'待查看':item.status==='reading'?'处理中':item.status==='replied'?'已回复':'已处理'}}</text></view><view class="spaced">{{item.content}}</view><view wx:if="{{item.reply}}" class="quiet-card"><view>青野回复</view><view class="sub">{{item.reply}}</view></view><view class="note">回执 {{item.id}}</view></view><button bindtap="status">刷新进度</button></view></view><privacy-panel/>
