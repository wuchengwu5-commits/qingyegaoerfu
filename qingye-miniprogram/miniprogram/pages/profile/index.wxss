.profile-page{padding-left:34rpx;padding-right:34rpx}.profile-heading{padding:44rpx 18rpx 28rpx}.profile-heading .title{margin:0 0 8rpx}.profile-summary{padding:28rpx 30rpx 22rpx}.profile-account{min-height:132rpx}.profile-account .avatar{height:132rpx;width:132rpx;background:#254b37;border:3rpx solid #f6faf0;box-shadow:0 0 0 1rpx #728477;color:white;font-family:'Songti SC',serif;font-size:60rpx;font-weight:400}.profile-name{font-size:32rpx;font-weight:600}.profile-account .note{font-size:23rpx;margin-top:8rpx}.profile-numbers{display:flex;margin-top:24rpx;padding-top:16rpx;border-top:1rpx solid rgba(255,255,255,.8)}.profile-numbers>view{flex:1;text-align:center}.profile-numbers>view+view{border-left:1rpx solid rgba(66,94,69,.19)}.profile-numbers .num{font-size:44rpx;font-weight:500;line-height:1.1;margin:5rpx 0 10rpx}.profile-numbers .label{font-size:25rpx;color:#375646}.recent-round{height:280rpx;position:relative;overflow:hidden;border:1rpx solid rgba(255,255,255,.95);border-radius:32rpx;margin-bottom:26rpx;box-shadow:0 10rpx 26rpx rgba(32,63,43,.1)}.recent-photo{position:absolute;inset:0;width:100%;height:100%}.recent-label{position:absolute;top:18rpx;left:24rpx;background:rgba(246,250,238,.78);border-radius:12rpx;padding:5rpx 10rpx;font-size:24rpx;color:#284c38}.recent-caption{position:absolute;bottom:0;left:0;right:0;padding:18rpx 24rpx;background:rgba(32,69,43,.72);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);color:#fff;font-size:24rpx;line-height:1.7}.recent-name{font-size:28rpx;font-weight:500}.page .profile-menu{padding:0 28rpx;margin-bottom:24rpx}.profile-menu .menu{min-height:100rpx;gap:22rpx}.menu-icon{width:38rpx;height:38rpx;flex-shrink:0}.menu-arrow{width:28rpx;height:28rpx;flex-shrink:0}.handicap-inline{font-size:30rpx;color:#41683f}
