<view class="page tab-page profile-page" style="padding-top:{{topInset}}px">
 <scene-backdrop/>
 <view class="profile-heading"><view class="title">我的青野</view><view class="sub">{{slogan.subtitle}}</view></view>
 <view class="card profile-summary">
  <view class="row profile-account" bindtap="account"><image wx:if="{{loggedIn&&profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{loggedIn?(profile.name[0]||'青'):'青'}}</view><view class="grow"><view class="profile-name">{{loggedIn?profile.name:'未登录'}}</view><view class="note">{{loggedIn?'手机号已验证':'手机号授权登录'}}</view></view><image class="menu-arrow" src="/assets/chevron.png" mode="aspectFit"/></view>
  <view class="profile-numbers"><view bindtap="history"><text class="num">{{stats.rounds}}</text><text class="label">场球局</text></view><view bindtap="stats"><text class="num">{{stats.best}}</text><text class="label">最佳 18 洞</text></view></view>
 </view>
 <view wx:if="{{recent}}" class="recent-round" bindtap="recent"><image class="recent-photo" src="{{sceneSrc}}" mode="aspectFill" binderror="sceneError"/><view class="recent-label">最近一场</view><view class="recent-caption"><view class="recent-name">{{recent.name}}</view><view class="row"><text>{{recent.date}}</text><text>{{recent.holes}} 洞 · Par {{recent.par}}　›</text></view></view></view>
 <view class="card profile-menu">
  <view class="menu row" bindtap="history"><image class="menu-icon" src="/assets/history.png"/><text class="grow">历史记录</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
  <view class="menu row" bindtap="friends"><image class="menu-icon" src="/assets/users.png"/><text class="grow">我的球友</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
  <view class="menu row" bindtap="groups"><image class="menu-icon" src="/assets/flag.png"/><text class="grow">小组与活动</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
  <view class="menu row" bindtap="stats"><image class="menu-icon" src="/assets/stats.png"/><text class="grow">数据统计与差点</text><text class="handicap-inline">{{handicap.display}}</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
 </view>
 <view class="card profile-menu">
  <view class="menu row" bindtap="knowledge"><image class="menu-icon" src="/assets/book.png"/><text class="grow">高尔夫知识</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
  <view class="menu row" bindtap="feedback"><image class="menu-icon" src="/assets/mail.png"/><text class="grow">信息与问题反馈</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
  <view class="menu row" bindtap="background"><view class="menu-icon background-icon">景</view><text class="grow">背景设置</text><text class="background-label">{{backgroundLabel}}</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
  <view class="menu row" bindtap="location"><image class="menu-icon" src="/assets/pin.png"/><text class="grow">定位授权设置</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
  <view class="menu row" bindtap="about"><image class="menu-icon" src="/assets/info.png"/><text class="grow">关于青野</text><image class="menu-arrow" src="/assets/chevron.png"/></view>
 </view>
 <button wx:if="{{loggedIn}}" class="logout-button" bindtap="logout">退出登录</button>
</view><privacy-panel/>
