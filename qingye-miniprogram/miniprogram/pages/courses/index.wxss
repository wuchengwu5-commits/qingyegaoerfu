.course-directory{padding:36rpx 30rpx calc(50rpx + env(safe-area-inset-bottom))}.directory-heading{margin-bottom:28rpx}.directory-heading .title{font-size:54rpx;margin-bottom:6rpx}.directory-heading .sub{font-size:28rpx}.directory-location{min-height:112rpx;padding:20rpx 24rpx;margin-bottom:20rpx}.directory-location .note{font-size:24rpx;margin-top:3rpx}.location-symbol{width:60rpx;height:60rpx;border-radius:50%;background:#e2edd9;color:#2e5c39;display:flex;align-items:center;justify-content:center;font-size:40rpx}.region-chips{display:flex;gap:10rpx;margin-top:22rpx;align-items:center}.page .region-chips .choice{min-width:0;padding:18rpx 18rpx;font-size:27rpx;white-space:nowrap;border-radius:38rpx}.region-chips>.choice{flex:1}.region-more{font-size:24rpx!important;padding-left:12rpx!important;padding-right:12rpx!important}.directory-tools{min-height:72rpx;margin-top:8rpx}.directory-tools .tap{min-height:64rpx}.directory-tools .note{font-size:23rpx}.directory-tools .link{font-size:24rpx}.course-list{background:rgba(251,254,248,.8);border:1rpx solid #fff;border-radius:36rpx;padding:0 20rpx;box-shadow:inset 0 2rpx 0 #fff,0 12rpx 34rpx rgba(33,67,41,.065)}.page .course-card{display:flex;align-items:center;gap:20rpx;min-height:190rpx;padding:20rpx 0;margin:0;border:0;border-bottom:1rpx solid #dde7d6;border-radius:0;background:transparent;box-shadow:none}.page .course-card:last-child{border-bottom:0}.course-card .course-list-image{width:120rpx;height:132rpx;border-radius:22rpx;flex-shrink:0}.course-name{font-size:28rpx;line-height:1.5;font-weight:600;color:#234330}.course-card .muted,.distance{font-size:24rpx;line-height:1.6;margin-top:5rpx;color:#63776a}.course-actions{width:66rpx;flex-shrink:0;display:flex;flex-direction:column;align-items:center}.star{min-width:66rpx;min-height:76rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx;color:#54725d}.course-arrow{font-size:40rpx;color:#4f6857;line-height:32rpx}.directory-footnote{margin-top:26rpx;font-size:24rpx;line-height:1.8}
.location-symbol .location-image{width:38rpx;height:38rpx}

.directory-heading{margin:40rpx 14rpx 32rpx}.directory-heading .title{font-size:56rpx}.directory-location{border-radius:32rpx;padding:22rpx 22rpx}.directory-location .note{font-size:24rpx}.page .course-card{background:transparent;border:0;border-bottom:1rpx solid rgba(97,123,99,.17);border-radius:0;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;gap:22rpx;min-height:184rpx}.course-card .course-list-image{height:142rpx;width:142rpx}.course-name{font-size:29rpx;line-height:1.5;letter-spacing:-.4rpx}.course-card .muted,.distance{font-size:24rpx}.course-card .star-icon{width:40rpx;height:40rpx;object-fit:contain;border-radius:0}.course-card .course-arrow{width:28rpx;height:28rpx;object-fit:contain;border-radius:0}.course-actions{width:48rpx}.star{min-width:64rpx;min-height:70rpx}

.page .region-chips .region-more{display:flex;align-items:center;justify-content:center;gap:6rpx;margin:0;min-height:76rpx;line-height:1.4;padding:14rpx 16rpx!important;font-size:24rpx!important;max-width:158rpx;white-space:normal}.region-down{width:18rpx;height:18rpx;transform:rotate(90deg);opacity:.75;flex-shrink:0}.region-more.active .region-down{filter:brightness(0) invert(1)}
.region-overlay{position:fixed;inset:0;z-index:300;color:#214d3c}.region-backdrop{position:absolute;inset:0;background:rgba(27,52,42,.28);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}.region-sheet{position:absolute;left:0;right:0;bottom:0;padding-bottom:env(safe-area-inset-bottom);border:1rpx solid rgba(255,255,255,.95);border-bottom:0;border-radius:42rpx 42rpx 0 0;background:linear-gradient(145deg,rgba(246,253,250,.98),rgba(226,241,233,.97));box-shadow:0 -16rpx 60rpx rgba(31,66,48,.14);overflow:hidden}.region-handle{height:7rpx;width:64rpx;border-radius:8rpx;background:#c4d7ca;margin:18rpx auto 12rpx}.region-sheet-heading{display:flex;align-items:center;justify-content:space-between;padding:4rpx 32rpx 26rpx}.region-sheet-title{font-family:'Songti SC','STSong',serif;font-size:38rpx;line-height:1.5;font-weight:600;letter-spacing:1rpx}.region-sheet-sub{font-size:24rpx;color:#718b7b;line-height:1.6;margin-top:5rpx}.region-sheet .region-close{display:flex;flex:0 0 80rpx;max-width:80rpx;box-sizing:border-box;align-items:center;justify-content:center;margin:0 -6rpx 0 0;width:80rpx;height:80rpx;min-height:80rpx;line-height:1;padding:0;border:1rpx solid rgba(255,255,255,.9);border-radius:50%;font-size:42rpx;font-weight:300;color:#537360;background:rgba(255,255,255,.5)}.region-scroll{display:block;height:58vh;overflow-y:auto;overscroll-behavior:contain}.region-sheet-content{padding:0 32rpx 46rpx}.region-group{margin-top:28rpx}.region-group-title{font-size:23rpx;color:#688574;line-height:1.6;letter-spacing:2rpx;margin:0 4rpx 14rpx}.region-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx}.region-sheet .region-option{position:relative;width:100%;max-width:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-width:0;min-height:84rpx;line-height:1.5;margin:0;padding:16rpx 6rpx;border:1rpx solid rgba(255,255,255,.92);border-radius:22rpx;background:rgba(255,255,255,.5);color:#4a6b57;font-size:26rpx;font-weight:400}.region-sheet .region-option.selected{background:linear-gradient(125deg,#83af91,#4b825e);color:#fff;border-color:#c7e3cf;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.3);font-weight:500}.region-sheet .region-all{width:100%;justify-content:space-between;padding:16rpx 26rpx}.region-check{position:absolute;right:9rpx;top:4rpx;font-size:18rpx;line-height:1.2}.region-all .region-check{position:static;font-size:25rpx}.region-option:focus-visible,.region-close:focus-visible{outline:2px solid #5a906c;outline-offset:2px}

.course-card>.course-thumbnail{background:#e1eadb}.feed-more{min-height:88rpx;display:flex;align-items:center;justify-content:center}

.course-meta-line{display:flex;flex-wrap:wrap;align-items:center;gap:6rpx 12rpx;margin-top:6rpx}.course-meta-line .distance{margin:0}.course-card .grow{min-width:0}.course-meta-line .course-map-badges{gap:6rpx}.course-meta-line .course-map-badge{padding-left:10rpx;padding-right:10rpx}

.course-pick-check{font-size:32rpx;line-height:32rpx;color:#3f714e;font-weight:600}
