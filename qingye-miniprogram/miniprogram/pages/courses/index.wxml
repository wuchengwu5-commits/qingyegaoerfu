<page-meta page-style="{{regionOpen?'overflow:hidden':''}}"/>
<view style="padding-top:{{topInset}}px" class="page tab-page course-directory"><image class="page-backdrop" src="cloud://cloud1-d7gketoi570d17f80.636c-cloud1-d7gketoi570d17f80-1524135194/media-v1/assets__spring-lake.webp" mode="aspectFill" aria-hidden="true"/><view class="directory-heading"><view class="title">下一场，去哪里？</view><view class="sub">选好球场，开始一场好球。</view></view><view class="nearby-notice directory-location row" bindtap="locate"><view class="location-symbol"><image class="location-image" src="/assets/pin-active.png" mode="aspectFit"/></view><view class="grow"><view>{{location.status==='locating'?'正在定位…':location.fix?'当前位置 · 附近优先':'开启定位'}}</view><view class="note">{{location.error||(location.fix?'来源点估算直线距离':'附近优先推荐')}}</view></view><text>›</text></view><view class="directory-search-wrap search-field"><image class="search-icon" src="/assets/search.png" mode="aspectFit"/><input class="directory-search search-input" placeholder-class="search-placeholder" placeholder="球场、城市或别名" value="{{query}}" bindinput="search" confirm-type="search"/></view><view class="region-chips"><view wx:for="{{quickRegions}}" wx:key="id" class="choice {{province===item.id?'active':''}}" data-id="{{item.id}}" bindtap="quickProvince">{{item.name}}</view><button class="choice region-more {{moreRegionActive?'active':''}}" bindtap="openRegions" aria-label="更多地区" aria-expanded="{{regionOpen}}"><text>{{moreRegionLabel}}</text><image src="/assets/chevron.png" class="region-down" mode="aspectFit"/></button></view><view class="directory-tools row"><text class="note">{{province==='all'?'全国':province}} · {{count}} 条</text><text class="link tap" data-id="{{filter==='favorite'?'all':'favorite'}}" bindtap="filter">{{filter==='favorite'?'查看全部':'我的收藏'}} ›</text></view><view class="course-list"><view wx:for="{{items}}" wx:key="id" class="course-card" data-id="{{item.id}}" bindtap="select"><image src="{{item.thumbnail}}" mode="aspectFill"/><view class="grow"><view class="course-name">{{item.name}}</view><view class="muted">{{item.city}} · {{item.holes?item.holes+' 洞':'资料待补'}} {{item.par?'· Par '+item.par:''}}</view><view class="distance">{{location.fix?item.distanceText:'距离待补充'}}<text wx:if="{{!item.canScore}}"> · 记分卡待补</text></view></view><view class="course-actions"><view class="star" data-id="{{item.id}}" catchtap="favorite"><image class="star-icon" src="/assets/{{item.favorite?'star-active':'star'}}.png" mode="aspectFit"/></view><image class="course-arrow" src="/assets/chevron.png" mode="aspectFit"/></view></view></view><view wx:if="{{!items.length}}" class="empty">这里还没有匹配的球场，换个地区看看。</view><view wx:if="{{items.length<count}}" class="footer-note">上滑继续查看</view><view class="note directory-footnote">配图为 AI 意境图，非球场实拍。距离为来源点估算值，未收录坐标的球场排在后面。</view></view>
<view wx:if="{{regionOpen}}" class="region-overlay" role="dialog" aria-label="选择地区" aria-modal="true">
 <view class="region-backdrop" bindtap="closeRegions" catchtouchmove="noop"/>
 <view class="region-sheet" catchtap="noop">
  <view class="region-handle"/>
  <view class="region-sheet-heading"><view><view class="region-sheet-title">选择地区</view><view class="region-sheet-sub">找到下一场想去的球场</view></view><button class="region-close" bindtap="closeRegions" aria-label="关闭地区选择">×</button></view>
  <scroll-view class="region-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
   <view class="region-sheet-content"><button class="region-option region-all {{province==='all'?'selected':''}}" data-id="all" bindtap="chooseRegion" aria-pressed="{{province==='all'}}"><text>全部地区</text><text wx:if="{{province==='all'}}" class="region-check">✓</text></button>
    <view wx:for="{{regionGroups}}" wx:key="name" class="region-group"><view class="region-group-title">{{item.name}}</view><view class="region-grid"><button wx:for="{{item.items}}" wx:for-item="region" wx:key="id" class="region-option {{province===region.id?'selected':''}}" data-id="{{region.id}}" bindtap="chooseRegion" aria-pressed="{{province===region.id}}">{{region.name}}<text wx:if="{{province===region.id}}" class="region-check">✓</text></button></view></view>
   </view>
  </scroll-view>
 </view>
</view><privacy-panel/>