<page-meta page-style="{{regionOpen?'overflow:hidden':''}}"/>
<view style="padding-top:{{topInset}}px" class="page {{pickerMode?'':'tab-page'}} course-directory"><scene-backdrop/><view class="directory-heading"><view class="title">{{slogan.title}}</view><view class="sub">{{slogan.subtitle}}</view></view><view class="nearby-notice directory-location row" bindtap="locate"><view class="location-symbol"><image class="location-image" src="/assets/pin-active.png" mode="aspectFit"/></view><view class="grow"><view>{{location.status==='locating'?'正在定位…':nearest?'当前位置 · '+nearest.name:location.fix?'附近球场资料待补充':'开启定位'}}</view><view class="note">{{location.error||(nearest?nearest.distanceText+' · 点击重新定位':'点击定位，发现附近球场')}}</view></view><text>›</text></view><view class="directory-search-wrap search-field"><image class="search-icon" src="/assets/search.png" mode="aspectFit"/><input class="directory-search search-input" placeholder-class="search-placeholder" placeholder="球场、城市或别名" value="{{query}}" bindinput="search" confirm-type="search"/></view><view class="region-chips"><view wx:for="{{quickRegions}}" wx:key="id" class="choice {{province===item.id?'active':''}}" data-id="{{item.id}}" bindtap="quickProvince">{{item.name}}</view><button class="choice region-more {{moreRegionActive?'active':''}}" bindtap="openRegions" aria-label="更多地区" aria-expanded="{{regionOpen}}"><text>{{moreRegionLabel}}</text><image src="/assets/chevron.png" class="region-down" mode="aspectFit"/></button></view><view class="directory-tools row"><text class="note">{{province==='all'?(feedMode==='nearby'?'附近球场':feedMode==='recent'?'最近打过':'发现球场'):province}} · 已显示 {{items.length}}/{{count}}</text><text class="link tap" data-id="{{filter==='favorite'?'all':'favorite'}}" bindtap="filter">{{filter==='favorite'?'查看全部':'我的收藏'}} ›</text></view><view class="course-list"><view wx:for="{{items}}" wx:key="id" class="course-card" data-id="{{item.id}}" bindtap="select"><image class="course-list-image course-thumbnail" src="{{item.thumbnail}}" mode="aspectFill" lazy-load="{{true}}"/><view class="grow"><view class="course-name">{{item.name}}</view><view class="muted">{{item.city}} · {{item.holes?item.holes+' 洞':'资料待补'}} {{item.par?'· Par '+item.par:''}}</view><view class="course-meta-line"><view class="distance">{{location.fix?item.distanceText:'距离待补充'}}<text wx:if="{{!item.canScore}}"> · 记分卡待补</text></view><view wx:if="{{item.mapTypes.length}}" class="course-map-badges"><text wx:for="{{item.mapTypes}}" wx:for-item="mapType" wx:key="id" class="course-map-badge {{mapType.id}}">{{mapType.label}}</text></view></view></view><view class="course-actions"><view class="star" data-id="{{item.id}}" catchtap="favorite"><image class="course-list-image star-icon" src="/assets/{{item.favorite?'star-active':'star'}}.png" mode="aspectFit"/></view><text wx:if="{{pickerMode&&selectedCourseId===item.id}}" class="course-pick-check">✓</text><image wx:else class="course-list-image course-arrow" src="/assets/chevron.png" mode="aspectFit"/></view></view></view><view wx:if="{{!items.length}}" class="empty">这里还没有匹配的球场，换个地区看看。</view><view wx:if="{{items.length<count}}" class="footer-note feed-more" bindtap="more" role="button">上滑或点击，再看 10 个球场</view><view wx:elif="{{items.length}}" class="footer-note">已显示全部匹配球场</view><view class="note directory-footnote">配图为 AI 意境图，非球场实拍。有定位时按距离排列；无定位时优先最近打过的球场，否则随机推荐。每次加载 10 个。距离为来源点估算直线距离；缺少坐标的球场排在所属组后面。</view></view>
<view wx:if="{{regionOpen}}" class="region-overlay" role="dialog" aria-label="选择地区" aria-modal="true">
 <view class="region-backdrop" bindtap="closeRegions" catchtouchmove="noop"/>
 <view class="region-sheet" catchtap="noop">
  <view class="region-handle"/>
  <view class="region-sheet-heading"><view><view class="region-sheet-title">选择地区</view><view class="region-sheet-sub">找到下一场想去的球场</view></view><button class="region-close" bindtap="closeRegions" aria-label="关闭地区选择">×</button></view>
  <scroll-view class="region-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
   <view class="region-sheet-content"><button class="region-option region-all {{province==='all'?'selected':''}}" data-id="all" bindtap="chooseRegion" aria-pressed="{{province==='all'}}"><text>全部地区</text><text wx:if="{{province==='all'}}" class="region-check">✓</text></button>
    <view wx:for="{{regionGroups}}" wx:key="name" class="region-group"><view class="region-group-title">{{item.name}}</view><view class="region-grid"><button wx:for="{{item.items}}" wx:for-item="region" wx:key="id" class="region-option {{province===region.id?'selected':''}}" data-id="{{region.id}}" bindtap="chooseRegion" aria-pressed="{{province===region.id}}">{{region.name}}<text wx:if="{{province===region.id}}" class="region-check">✓</text></button></view></view>
   </view>
  </scroll-view>
 </view>
</view><privacy-panel/>
<qy-dialog class="page-dialog"/>
