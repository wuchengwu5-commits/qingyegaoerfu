.member-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #edf0e9}.member-row:last-child{border:0}.score-total{font-size:42rpx;font-weight:600;color:#49603f}.invite-actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:22rpx}.invite-actions button{font-size:23rpx;flex:1;white-space:nowrap}.invite-code{width:430rpx;height:430rpx;display:block;margin:24rpx auto}.cloud-error{padding:24rpx;border-radius:20rpx;background:#eef1e5;color:#697c53;font-size:24rpx;line-height:1.7}.note{line-height:1.8}
