<view class="page"><scene-backdrop/><view class="eyebrow">ONE DAY, MANY GROUPS</view><view class="title">{{hasInvite?'扫码加入小组':'我的线上球局'}}</view><view class="sub">{{hasInvite?'确认邀请后，进入这场球的记分牌。':'小组记分 · 每组最多 16 名球员。'}}</view><button wx:if="{{!loggedIn}}" class="primary space" bindtap="login">微信登录</button><view wx:if="{{error}}" class="cloud-error space">{{error}}</view><view wx:if="{{busy}}" class="note space">正在连接…</view><view wx:if="{{invitation}}" class="card spaced"><view class="section">{{invitation.title}}</view><view>{{invitation.courseName}} · {{invitation.groupName}}</view><view class="note space">{{invitation.kind==='scorer'?'扫码后仅协助本组记分，不占球位、不参与排名。':invitation.kind==='live'?'加入后可和同组球友一起看成绩、记杆数，并互存为常用球友。':invitation.kind==='join'?'加入本组后，昵称与本次成绩对活动内成员可见，同组成员会成为常用球友。':invitation.kind==='group'?'创建自己的小组，与活动内其他小组互看成绩。':'加入后仅能查看成绩，不能修改任何小组记分。'}}</view><block wx:if="{{invitation.kind==='live'&&!invitation.joined&&!invitation.closed}}"><view class="note space">临时加入请选择新增球位；已有代记成绩的球友可认领自己的球位。</view><view class="choices"><view wx:for="{{invitation.seats}}" wx:key="id" class="choice {{seatId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectSeat">{{item.name}}{{item.played?' · 已记 '+item.played+' 洞':''}}</view></view></block>
<button class="primary space" disabled="{{busy||(invitation.kind==='scorer'&&invitation.closed)||(invitation.kind==='live'&&!invitation.joined&&(invitation.closed||!seatId))}}" bindtap="join">{{invitation.kind==='scorer'?(invitation.closed?'本轮已结束':invitation.joined?'进入记分牌':'以记分员身份加入'):invitation.kind==='live'?(invitation.joined?'进入记分牌':invitation.closed?'本轮已结束':seatId?'加入并打开记分牌':invitation.seats.length?'请选择自己的球位':'暂无可加入的球位'):invitation.kind==='join'?'确认加入小组':invitation.kind==='group'?'创建我的小组':'查看活动成绩'}}</button></view><view wx:if="{{!activity&&!invitation&&!hasInvite}}"><view class="card space"><view class="section">{{course?course.name:'开始组队'}}</view><button class="primary space" bindtap="create">{{course?'创建新球局':'选球场，创建新球局'}}</button><button class="space" bindtap="scan">扫码加入小组</button></view><view class="section">我的小组记分</view><view class="card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view>{{item.title}} ›</view><view class="muted">{{item.courseName}} · {{item.groupCount}} 个小组</view></view><view wx:if="{{!activities.length}}" class="empty">接受微信好友邀请，或创建今天的第一组。</view></view><view wx:if="{{activity}}"><view class="card space"><view class="section">{{activity.title}}</view><view class="note">{{activity.courseName}} · 更新于 {{activity.updatedLabel}}</view><view wx:if="{{mine}}" class="note space">你在 {{mine.name}} · {{mine.myRole==='scorer'?'记分员 · 不参赛':mine.live?'可共同编辑记分牌':own?'本组发起人':'组员'}}</view><view wx:else class="note space">正在观看活动 · 仅查看成绩</view><button wx:if="{{mine.canScore}}" class="primary space" bindtap="start">{{mine.round?'继续本组记分':'确认 Tee 与规则，开始记分'}}</button><view wx:if="{{own}}" class="invite-actions"><button wx:if="{{!mine.round}}" data-kind="join" bindtap="invite">邀请同组好友</button><button wx:if="{{mine.live}}" data-kind="scorer" bindtap="invite">邀请记分员 / 球童</button><button data-kind="watch" bindtap="invite">分享看成绩</button></view><view class="note space">{{mine.live?'组内成员可共同编辑本组成绩。':'可在记分页邀请球友加入本场球。'}}</view></view><view class="section">活动成绩 · {{activity.groups.length}} 组</view><view class="card" wx:for="{{activity.groups}}" wx:key="id"><view class="row"><view class="grow section">{{item.name}}</view><text class="muted">{{item.round?'已开局':'等待开局'}}</text></view><view wx:if="{{item.canScore}}" class="link space" data-id="{{item.id}}" bindtap="selectGroup">{{mine.id===item.id?'当前操作组':'切换到本组 ›'}}</view><view wx:for="{{item.scorers}}" wx:for-item="scorer" wx:key="uid" class="note space">{{scorer.name}} · 记分员（不参赛）</view><view wx:if="{{!item.round}}" class="member-row" wx:for="{{item.members}}" wx:for-item="member" wx:key="uid"><text>{{member.name}}</text><text class="muted">已加入</text></view><view wx:for="{{item.rows}}" wx:for-item="player" wx:key="id" class="member-row"><view class="grow">{{player.name}}<view class="note">{{player.tee}} · 已记 {{player.played}} / {{player.holes}} 洞</view></view><text class="score-total">{{player.total}}</text></view></view><view class="row space"><text class="link" bindtap="retrySync">刷新 / 重试同步</text><text class="link" bindtap="list">其他活动</text></view><view class="note space">断网时本机记分保留，联网后重试同步。此页显示云端最近一次已同步的成绩。</view></view></view><view wx:if="{{codeOpen}}" class="invite-code-layer" catchtouchmove="codeNoop">
 <view class="invite-code-mask" bindtap="closeCode"></view>
 <scroll-view class="invite-code-dialog" scroll-y="{{true}}" catchtap="codeNoop">
  <view class="invite-code-content">
   <button class="invite-code-close" bindtap="closeCode" aria-label="关闭邀请">×</button>
   <view class="invite-code-title">{{codeKind==='scorer'?'邀请记分员 / 球童':codeKind==='group'?'邀请另一组加入活动':codeKind==='watch'?'邀请查看成绩':'邀请球友扫码入组'}}</view><view class="invite-code-subtitle">{{codeKind==='scorer'?'只协助本组记分，不占球位、不参与排名':codeKind==='watch'?'扫码查看本活动成绩':codeKind==='group'?'扫码建立小组，一起查看活动成绩':'微信扫一扫，加入本组一起记分'}}</view>
   <view class="invite-code-frame">
    <image wx:if="{{qrcode}}" class="invite-code-image" src="{{qrcode}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="previewCode" binderror="codeImageError"/>
    <view wx:elif="{{codeBusy}}" class="invite-code-status"><view class="invite-code-spinner"></view><text>正在生成微信小程序码…</text></view>
    <view wx:else class="invite-code-status"><text>{{codeError||'暂未生成小程序码'}}</text><button bindtap="retryCode">重新生成</button></view>
   </view>
   <view class="invite-code-version">{{codeVersion}} · 微信小程序码</view>
   <button wx:if="{{invite}}" class="primary invite-code-share" open-type="share">转发给微信好友</button>
   <view class="invite-code-actions"><text bindtap="closeCode" role="button">关闭</text><text wx:if="{{invite}}" bindtap="revoke" role="button">撤销本次邀请</text></view>
  </view>
 </scroll-view>
</view><privacy-panel/>
