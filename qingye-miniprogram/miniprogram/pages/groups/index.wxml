<view class="page"><image class="page-backdrop" src="cloud://cloud1-d7gketoi570d17f80.636c-cloud1-d7gketoi570d17f80-1524135194/media-v1/assets__spring-lake.webp" mode="aspectFill" aria-hidden="true"/><view class="eyebrow">ONE DAY, MANY GROUPS</view><view class="title">同场打球，一起看成绩。</view><view class="sub">每组最多 4 人，一个活动可以有多个小组。</view><button wx:if="{{!loggedIn}}" class="primary space" bindtap="login">微信登录</button><view wx:if="{{error}}" class="cloud-error space">{{error}}</view><view wx:if="{{busy}}" class="note space">正在连接…</view><view wx:if="{{invitation}}" class="card spaced"><view class="section">{{invitation.title}}</view><view>{{invitation.courseName}} · {{invitation.groupName}}</view><view class="note space">{{invitation.kind==='join'?'加入本组后，昵称与本次成绩对活动内成员可见，同组成员会成为常用球友。':invitation.kind==='group'?'创建自己的小组，与活动内其他小组互看成绩。':'加入后仅能查看成绩，不能修改任何小组记分。'}}</view><button class="primary space" bindtap="join">{{invitation.kind==='join'?'确认加入小组':invitation.kind==='group'?'创建我的小组':'查看活动成绩'}}</button></view><view wx:if="{{!activity&&!invitation}}"><view class="card space"><view class="section">{{course?course.name:'开始组队'}}</view><button class="primary space" bindtap="create">{{course?'创建活动和我的小组':'选球场，创建活动'}}</button><button class="space" bindtap="scan">扫码加入小组</button></view><view class="section">我的活动</view><view class="card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view>{{item.title}} ›</view><view class="muted">{{item.courseName}} · {{item.groupCount}} 个小组</view></view><view wx:if="{{!activities.length}}" class="empty">接受微信好友邀请，或创建今天的第一组。</view></view><view wx:if="{{activity}}"><view class="card space"><view class="section">{{activity.title}}</view><view class="note">{{activity.courseName}} · 更新于 {{activity.updatedLabel}}</view><view wx:if="{{mine}}" class="note space">你在 {{mine.name}} · {{own?'本组记分员':'组员，成绩由本组记分员统一记录'}}</view><view wx:else class="note space">正在观看活动 · 仅查看成绩</view><button wx:if="{{own}}" class="primary space" bindtap="start">{{mine.round?'继续本组记分':'确认 Tee 与规则，开始记分'}}</button><view wx:if="{{own}}" class="invite-actions"><button wx:if="{{!mine.round}}" data-kind="join" bindtap="invite">邀请同组好友</button><button data-kind="group" bindtap="invite">邀请另一组</button><button data-kind="watch" bindtap="invite">分享看成绩</button></view><view class="note space">开局后锁定本组成员。各组只编辑自己的记分卡；其他组仅查看。</view></view><view wx:if="{{invite}}" class="card"><view class="section">{{invite.label}}</view><view class="note">邀请有效期 7 天，撤销后不能新加入，已加入的成员保留。链接由你主动转发。</view><button class="primary space" open-type="share">转发给微信好友</button><button class="space" bindtap="qr">生成小程序码</button><image wx:if="{{qrcode}}" class="invite-code" src="{{qrcode}}" mode="aspectFit"/><view class="quiet-link" bindtap="revoke">撤销本次邀请</view></view><view class="section">活动成绩 · {{activity.groups.length}} 组</view><view class="card" wx:for="{{activity.groups}}" wx:key="id"><view class="row"><view class="grow section">{{item.name}}</view><text class="muted">{{item.round?'已开局':'等待开局'}}</text></view><view wx:if="{{!item.round}}" class="member-row" wx:for="{{item.members}}" wx:for-item="member" wx:key="uid"><text>{{member.name}}</text><text class="muted">已加入</text></view><view wx:for="{{item.rows}}" wx:for-item="player" wx:key="uid" class="member-row"><view class="grow">{{player.name}}<view class="note">{{player.tee}} · 已记 {{player.played}} / {{player.holes}} 洞</view></view><text class="score-total">{{player.total}}</text></view></view><view class="row space"><text class="link" bindtap="retrySync">刷新 / 重试同步</text><text class="link" bindtap="list">其他活动</text></view><view class="note space">断网时本机记分保留，联网后重试同步。此页显示云端最近一次已同步的成绩。</view></view></view><privacy-panel/>
