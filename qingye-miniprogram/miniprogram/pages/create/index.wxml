<view class="page"><image class="page-backdrop" src="cloud://cloud1-d7gketoi570d17f80.636c-cloud1-d7gketoi570d17f80-1524135194/media-v1/assets__spring-lake.webp" mode="aspectFill" aria-hidden="true"/><view class="eyebrow">A NEW ROUND</view><view class="title">准备好，出发。</view><view class="card space"><view class="section">{{course.name}}</view><view class="muted">{{course.city}} · {{course.holes}} 洞 · 公开记分卡待确认</view></view><view class="section">本轮洞段（按实际顺序）</view><picker class="choice-picker" data-title="选择第一段" range="{{segments}}" range-key="name" value="{{first}}" data-which="first" bindchange="segment"><view class="select-field "><view class="select-copy"><view class="select-label">第一段</view><view class="select-value">{{segments[first].name}}</view></view><image class="select-chevron" src="/assets/chevron.png" aria-hidden="true"/></view></picker><picker class="choice-picker" data-title="选择第二段" range="{{second}}" value="{{secondIndex}}" data-which="second" bindchange="segment"><view class="select-field "><view class="select-copy"><view class="select-label">第二段</view><view class="select-value">{{second[secondIndex]}}</view></view><image class="select-chevron" src="/assets/chevron.png" aria-hidden="true"/></view></picker><picker class="choice-picker" data-title="选择出发洞" value="{{draft.start===10?1:0}}" wx:if="{{draft.segmentIds.length===2}}" range="{{['第1洞出发','第10洞出发']}}" bindchange="startHole"><view class="select-field "><view class="select-copy"><view class="select-label">出发洞</view><view class="select-value">第 {{draft.start}} 洞出发</view></view><image class="select-chevron" src="/assets/chevron.png" aria-hidden="true"/></view></picker><view class="section">同组球友 {{draft.players.length}} / 4</view><view class="card" wx:for="{{teePlayers}}" wx:key="id"><view class="row"><text class="grow">{{item.name}}</text><picker class="choice-picker choice-inline" data-title="{{item.name}} · 发球台 Tee" value="{{item.teeIndex}}" range="{{course.tees}}" data-pid="{{item.id}}" bindchange="tee"><view class="select-field tee-picker"><text class="tee-dot" style="background:{{item.tee==='Black'?'#26342c':item.tee==='Blue'?'#5c92bc':item.tee==='Red'?'#d97472':item.tee==='Gold'?'#c3a35d':'#dfe3d4'}}"></text><text>{{item.tee}}</text><image class="select-chevron" src="/assets/chevron.png" aria-hidden="true"/></view></picker><text wx:if="{{item.id!=='me'&&!onlineGroup}}" data-id="{{item.id}}" bindtap="remove"> 移除</text></view></view><button wx:if="{{!onlineGroup}}" class="space" bindtap="group">邀请微信好友 / 扫码组队</button><view wx:if="{{onlineGroup}}" class="note">同组人员来自微信邀请，回到小组页可继续邀请；开局后锁定成员。</view><view wx:if="{{preview}}" class="note space">当前为单机布局预览，真实登录与组队需在微信中体验。</view><view class="section">距离单位</view><view class="choices"><view class="choice {{draft.distanceUnit!=='m'?'active':''}}" data-unit="yd" bindtap="distanceUnit">码 · yd</view><view class="choice {{draft.distanceUnit==='m'?'active':''}}" data-unit="m" bindtap="distanceUnit">米 · m</view></view><view class="note">开局后，球道地图沿用本轮单位和每位球友的 Tee。</view><view class="section">快捷玩法</view><view class="choices"><text wx:for="{{templates}}" wx:key="id" class="choice" data-id="{{item.id}}" bindtap="template">{{item.name}}</text></view><view class="card" bindtap="rules"><view class="row"><text>五项规则设置</text><text class="link">{{rulesName}} →</text></view><view class="muted">组队、手动让杆、判罚约定、附加玩法、让杆预览</view></view><button class="primary space" bindtap="start">确认规则，开始记分</button></view>
<privacy-panel/>