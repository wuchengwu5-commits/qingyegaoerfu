.route-start{display:flex;align-items:baseline;justify-content:space-between;gap:18rpx;padding:14rpx 8rpx;color:#426349;font-size:25rpx;line-height:1.55}.route-length{white-space:nowrap;color:#6b796c;font-size:23rpx}

@import "../../services/flow.wxss";
.create-page{padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}.create-title{font-size:44rpx}.create-player{display:flex;align-items:center;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid #dde5d5;min-height:112rpx}.create-player-name{font-size:30rpx;color:#2a4e36;font-weight:600}.create-tee{font-size:26rpx;padding:24rpx 6rpx;min-height:80rpx}.create-remove{font-size:24rpx;color:#88947d;padding:24rpx 0 24rpx 8rpx}.create-invite{display:flex;align-items:center;gap:18rpx;margin-top:24rpx;padding-top:12rpx;font-size:27rpx}.create-invite switch{transform:scale(.82);transform-origin:right center}.create-summary{margin:20rpx 0;padding:20rpx;border-radius:18rpx;background:#e9f0e2;color:#526e4d;font-size:26rpx;line-height:1.6}.create-setting,.create-friend{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:98rpx;padding:20rpx 0;border-bottom:1rpx solid #dde5d5;font-size:27rpx}.create-setting text:last-child,.create-friend text:last-child{color:#66825f}.create-page .scoring-policy-row{gap:10rpx}.create-page .scoring-policy-row button{flex:1;width:auto;margin:0;min-height:84rpx;line-height:1.4;padding:22rpx 8rpx;font-size:25rpx}
.create-page .create-course-select{display:flex;align-items:center;gap:20rpx;width:100%;max-width:none;min-height:140rpx;margin:18rpx 0 0;padding:24rpx;text-align:left;border:1rpx solid #dce5d3;border-radius:22rpx;background:#edf3e5;box-shadow:none;line-height:1.5;font-weight:400}.create-page .create-course-select[disabled]{color:inherit;opacity:1}.create-course-select .flow-title{font-size:30rpx}.create-course-select .flow-caption{font-size:24rpx}.create-course-icon{flex:none;width:44rpx;height:44rpx}.create-course-action{flex:none;font-size:25rpx;color:#678161}

/* Four direct course choices fill the blank first step without adding a confirmation. */
.course-shortcuts{margin-top:30rpx}.shortcut-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 6rpx;margin:0 0 16rpx;min-height:78rpx}.shortcut-title{font-size:30rpx;font-weight:600;line-height:1.5;color:#294e36}.shortcut-caption{font-size:22rpx;line-height:1.6;margin-top:4rpx;color:#74826c}.create-page button.shortcut-location{display:flex;align-items:center;justify-content:flex-end;gap:7rpx;flex:0 0 auto;width:auto;min-height:88rpx;margin:-5rpx 0;padding:16rpx 2rpx 16rpx 14rpx;line-height:1.5;border:0;border-radius:0;background:transparent;box-shadow:none;color:#57774e;font-size:23rpx;font-weight:400}.shortcut-location image{width:27rpx;height:27rpx;opacity:.8}.shortcut-hint{font-size:23rpx;color:#74826c}.shortcut-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16rpx}.create-page button.shortcut-course{display:flex;flex-direction:column;align-items:stretch;width:100%;min-width:0;max-width:none;min-height:208rpx;margin:0;padding:22rpx;border-radius:26rpx;text-align:left;line-height:1.5;font-weight:400;white-space:normal}.shortcut-card-top{display:flex;align-items:center;justify-content:space-between;gap:8rpx;min-height:34rpx}.shortcut-distance{font-size:23rpx;color:#617c56}.shortcut-star{font-size:27rpx;line-height:1;color:#819363}.shortcut-name{flex:1;margin:12rpx 0 16rpx;font-size:28rpx;font-weight:600;line-height:1.5;color:#294e36;overflow-wrap:anywhere}.shortcut-card-bottom{display:flex;align-items:center;justify-content:space-between;gap:8rpx;color:#75836d;font-size:21rpx;line-height:1.5}.shortcut-chevron{font-size:30rpx;line-height:1;flex:none;color:#7c9270}.favorite-heading{margin-top:26rpx}.create-page .shortcut-empty{padding:24rpx;margin:0;border-radius:24rpx;color:#667b5d;font-size:25rpx;line-height:1.7}.shortcut-empty>text{display:block;margin-top:6rpx;color:#819075;font-size:23rpx}.create-page button.shortcut-course:active{background:rgba(224,237,213,.8);border-color:rgba(90,130,70,.28)}
