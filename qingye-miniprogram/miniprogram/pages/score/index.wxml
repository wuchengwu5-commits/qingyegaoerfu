<view class="page score-page {{r.players.length<=4?'score-fit':''}}"><scene-backdrop/>
<view wx:if="{{!r}}" class="card round-overview">
 <view wx:if="{{!r}}" class="round-loading"><view wx:if="{{!embedded}}" class="section">同组记分牌</view><view class="note">{{boardError||(boardLoginNeeded?'登录后查看同组成绩':'正在读取成绩…')}}</view><button wx:if="{{boardLoginNeeded}}" bindtap="boardLogin">微信授权登录</button><button wx:elif="{{boardError}}" bindtap="pollBoard">重新加载</button></view>
</view>
<block wx:if="{{r}}">
<view class="card hole-score-card">
 <view class="score-card-heading"><view class="course-name">{{r.courseName}}</view><text class="link course-map-link" bindtap="guide" role="button" aria-label="查看当前球洞的球道图">球道图 ›</text></view>
 <view class="score-table">
  <view class="fixed-players">
   <view class="name-head">球友<text class="total-label">当前总杆</text></view><view class="name-par">PAR</view>
   <view wx:for="{{tablePlayers}}" wx:key="id" class="player-id {{p.id===item.id?'selected-player':''}}" data-id="{{item.id}}" bindtap="selectPlayer" role="button" aria-label="选择{{item.name}}，{{item.tee}}发球台，标准杆加已记差值{{item.liveTotal}}杆，实际{{item.total}}杆，{{item.played}}洞">
    <view class="player-identity"><view class="score-avatar-wrap"><image class="score-avatar {{item.avatarUrl?'':'avatar-placeholder'}}" src="{{item.avatarUrl||'/assets/nav-profile.png'}}" mode="aspectFill" data-id="{{item.id}}" binderror="avatarError"/><view class="avatar-tee-dot" style="background:{{item.teeColor}}" aria-label="{{item.tee}}发球台"/></view><text class="person-total">{{item.liveTotal}}</text></view><text class="person-name">{{item.name}}</text>
   </view>
  </view>
  <scroll-view class="score-scroll" scroll-x="{{true}}" scroll-left="{{scoreScrollLeft}}" bindscroll="scoreScrolled" show-scrollbar="{{true}}" enhanced="{{true}}" aria-label="左右滑动查看完整记分表">
   <view class="score-grid" style="width:{{tableWidth}}px">
    <view class="table-line table-head"><block wx:for="{{tableColumns}}" wx:key="key"><view wx:if="{{item.summary}}" class="hole-cell summary-cell {{item.isTotal?'total-cell':''}}" style="width:{{item.width}}px;flex-basis:{{item.width}}px"><text class="summary-title">{{item.title}}</text><text class="summary-subtitle">{{item.subtitle}}</text></view><view wx:else class="hole-cell {{h.number===item.number?'current':''}}" data-number="{{item.number}}" bindtap="hole" role="button" aria-label="选择{{item.shortLabel}}洞"><text wx:if="{{item.headerSection}}" class="hole-section-label">{{item.headerSection}}</text><text class="hole-number-label">{{item.headerNumber}}</text></view></block></view>
    <view class="table-line par-line"><block wx:for="{{tableColumns}}" wx:key="key"><view wx:if="{{item.summary}}" class="hole-cell summary-cell {{item.isTotal?'total-cell':''}}" style="width:{{item.width}}px;flex-basis:{{item.width}}px" aria-label="{{item.title}}标准杆{{item.par}}">{{item.par}}</view><view wx:else class="hole-cell {{h.number===item.number?'current':''}}" data-number="{{item.number}}" bindtap="hole" role="button" aria-label="{{item.shortLabel}}洞，PAR {{item.par}}">{{item.par}}</view></block></view>
    <view wx:for="{{tablePlayers}}" wx:key="id" class="table-line player-line {{p.id===item.id?'selected-row':''}}">
     <block wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key"><view wx:if="{{cell.summary}}" class="hole-cell summary-cell {{cell.isTotal?'total-cell':''}}" style="width:{{cell.width}}px;flex-basis:{{cell.width}}px" aria-label="{{cell.aria}}"><text class="summary-value">{{cell.value}}</text><text wx:if="{{cell.detail}}" class="summary-detail">{{cell.detail}}</text></view><view wx:else class="hole-cell {{h.number===cell.number?'current':''}} {{h.number===cell.number&&p.id===item.id?'selected-cell':''}} {{cell.recorded?'recorded':'unrecorded'}}" data-pid="{{item.id}}" data-number="{{cell.number}}" bindtap="hole" role="button" aria-label="{{cell.aria}}">
      <view wx:if="{{cell.recorded}}" class="score-mark {{cell.kind}} {{cell.value.length>2?'wide-score':''}}">{{cell.value}}</view><text wx:elif="{{!cell.distance}}" class="empty-score">—</text><text wx:if="{{cell.distance}}" class="hole-distance">{{cell.distance}}</text>
     </view></block>
    </view>
   </view>
  </scroll-view>
 </view>
 <view class="scroll-hint"><text>左右滑动 · 完整 {{r.holes.length}} 洞</text><text>淡字为距离（{{distanceUnitLabel}}）</text></view>
</view>
<view class="card compact-stepper">
 <view class="entry-hole-context"><view class="entry-hole-name">{{courseHole}}</view><view class="entry-hole-meta"><text>PAR {{currentPar}}</text><text>{{currentTee}}</text><text wx:if="{{currentDistance}}">{{currentDistance}} {{distanceUnitLabel}}</text></view></view>
 <block wx:if="{{!boardFinished&&!scoreLocked}}">
  <view class="step-row"><view class="entry-copy"><view class="entry-strokes-label">本洞总杆</view><view wx:if="{{s}}" class="score-caption">{{statusText}}</view><view wx:else class="entry-unscored">待记分</view></view><view class="score-controls"><view class="score-controls-row"><button class="step-minus" disabled="{{joiningBusy}}" data-delta="-1" bindtap="step" aria-label="减少一杆">−</button><button class="score-number {{!s?'score-preview':''}}" disabled="{{joiningBusy}}" bindtap="input" aria-label="{{s?(s.completion==='holed_out'?'本洞总杆'+displayScore+'杆':statusText):'尚未记分，点击'+currentPar+'记录为PAR'}}">{{displayScore}}</button><button class="primary step-plus" disabled="{{joiningBusy}}" data-delta="1" bindtap="step" aria-label="增加一杆">＋</button></view><view class="score-number-hint">{{s?'已记录 · 可用 ± 修改':'点击数字记为 PAR'}}</view></view></view>
 </block>
 <view wx:else class="entry-readonly">{{boardFinished?'本轮已结束，可查看逐洞成绩。':'此记分卡已锁定，可查看逐洞成绩。'}}</view>
</view>
<view class="card round-details">
 <view class="route-line"><view class="grow"><text class="route-caption">本轮路线</text><text class="route-label">{{routeLabel}}</text></view><button wx:if="{{canAdjustRoute}}" class="route-edit" bindtap="editRoute">调整 ›</button></view>
 <view wx:if="{{routeEditing}}" class="route-panel">
  <view class="route-title">选择场区与开球顺序</view>
  <view class="route-pickers">
   <view class="route-option"><view class="note">先打</view><qy-picker title="先打哪个场" range="{{routeFirstOptions}}" range-key="name" value="{{routeFirstIndex}}" data-which="0" bindchange="routePick"><view class="route-select">{{routeFirstName}} ⌄</view></qy-picker></view>
   <button wx:if="{{routeTwo}}" class="route-swap" bindtap="swapRoute" aria-label="调换前后顺序">⇄</button>
   <view wx:if="{{routeTwo}}" class="route-option"><view class="note">后打</view><qy-picker title="再打哪个场" range="{{routeSecondOptions}}" range-key="name" value="{{routeSecondIndex}}" data-which="1" bindchange="routePick"><view class="route-select">{{routeSecondName}} ⌄</view></qy-picker></view>
  </view>
  <view class="route-note">{{routeDraftLabel}} · 共 {{r.holes.length}} 洞</view>
  <view class="route-note">已记成绩按实际球洞保留，换回场区仍可查看。</view>
  <view class="route-actions"><button bindtap="cancelRoute">取消</button><button class="primary" bindtap="applyRoute">应用路线</button></view>
 </view>
 <view class="round-rule" bindtap="viewPolicy" role="button" aria-label="查看本场记分规则"><text class="route-caption">本场规则</text><text>{{policyName}} ›</text></view>
</view>
<view class="card score-tools team-tools">
 <view class="tools-heading"><view><view class="tools-title">球友与组队</view><view class="tools-caption">本组 {{players.length}} / 16 位球员</view></view><button class="tools-link" bindtap="switchGroups">{{competitionBoard?'赛事总览 ›':'切换 / 新建 ›'}}</button></view>
 <button class="tool-row" bindtap="playerDetails"><image class="tool-row-icon" src="/assets/nav-profile.png"/><view class="tool-copy"><view class="tool-label">组员资料</view><view class="tool-description">调整本轮称呼与发球台</view></view><text class="tool-chevron">›</text></button>
 <block wx:if="{{canInvite&&!editing&&!boardFinished}}">
  <button class="team-invite" bindtap="enableSharing" loading="{{joiningBusy}}" disabled="{{joiningBusy}}">
   <view class="invite-symbol" aria-hidden="true"><view></view><view></view><view></view><view></view></view>
   <view class="tool-copy"><view class="tool-label">邀请球友扫码入组</view><view class="tool-description">一起查看、记录本组成绩</view></view><text class="tool-chevron">›</text>
  </button>
  <view class="team-secondary">
   <button class="team-small-action" bindtap="managePlayers" disabled="{{joiningBusy}}"><image class="team-action-icon" src="/assets/nav-profile.png"/><view class="tool-copy"><view class="tool-label">管理球员</view><view class="tool-description">添加 / 移除本组球员</view></view></button>
   <button class="team-small-action" bindtap="inviteScorer" disabled="{{joiningBusy}}"><image class="team-action-icon" src="/assets/nav-profile.png"/><view class="tool-copy"><view class="tool-label">记分员 / 球童</view><view class="tool-description">邀请协助记分</view></view></button>
  </view>
 </block>
 <view wx:if="{{liveBoard||r.cloud&&!remoteBoard}}" class="team-sync"><text wx:if="{{liveBoard}}">{{pendingCellCount?'本机已记 · 同步中':(boardFinished?'本轮已结束':'同组共同记分')}}</text><text wx:if="{{r.cloud&&!remoteBoard}}" class="link" bindtap="groups">小组成绩 ›</text></view>
 <view wx:if="{{!competitionBoard}}" class="row space"><view class="note">主要记分员 · {{primaryScorerName}}</view><qy-picker title="选择记分员" wx:if="{{canInvite&&!boardFinished&&scorerChoices.length>1}}" range="{{scorerChoices}}" range-key="name" value="{{scorerIndex}}" bindchange="changePrimary"><view class="link">修改 ›</view></qy-picker></view>
 <view wx:if="{{scorers.length}}" class="scorer-list"><view class="note">记分员 · 不参赛</view><view wx:for="{{scorers}}" wx:key="uid" class="row scorer-row"><text>{{item.name}}</text><text wx:if="{{canInvite}}" class="link" data-uid="{{item.uid}}" bindtap="removeScorer">移除</text></view></view>
 <view wx:if="{{conflictCellCount}}" class="board-error">有 {{conflictCellCount}} 处成绩需要核对，本机输入已保留。<text class="link" bindtap="resolveCellConflict">核对冲突 ›</text></view><view wx:if="{{boardError}}" class="board-error">{{boardError}} <text wx:if="{{boardConflict}}" bindtap="resolveBoard" class="link">处理同步</text><text wx:else bindtap="retryBoard" class="link">重试</text></view>
</view>
<view class="card score-tools round-tools">
 <view class="tools-heading"><view class="tools-title">记分与球局</view></view>
 <button wx:if="{{!editing}}" class="tool-row score-sync-row" bindtap="refreshScoreSync" disabled="{{manualSyncBusy}}"><view class="tool-copy"><view class="tool-label">{{manualSyncBusy?'同步中':conflictCellCount||boardConflict?'核对同步':'刷新同步'}}</view><view class="tool-description">{{boardError||(pendingCellCount?'本机已记 · 同步中':liveBoard?'同组共同记分':syncText==='已保存到账号'?'已备份到账号':syncText)}}</view></view><text class="sync-refresh-icon {{manualSyncBusy?'sync-spinning':''}}" aria-hidden="true">↻</text></button>
 <button class="tool-row" bindtap="result"><image class="tool-row-icon" src="/assets/history.png"/><view class="tool-copy"><view class="tool-label">完整记分卡</view><view class="tool-description">查看本轮逐洞成绩</view></view><text class="tool-chevron">›</text></button>
 <button class="tool-row" bindtap="technical" aria-expanded="{{technical}}"><view class="tool-glyph" aria-hidden="true">≡</view><view class="tool-copy"><view class="tool-label">详细记录<text class="optional-label">选填</text></view><view class="tool-description">推杆、罚杆与命中情况</view></view><text class="tool-chevron">{{technical?'−':'＋'}}</text></button>
 <view wx:if="{{technical}}" class="tool-expanded">
  <view class="menu row" data-key="putts" bindtap="tech"><text>推杆数</text><text>{{!s||s.putts===null?'未记录':s.putts}} ›</text></view>
  <view class="menu row" data-key="penalties" bindtap="tech"><text>罚杆 · 已含在总杆中</text><text>{{s?s.penalties:0}} ›</text></view>
  <view class="menu row" data-key="fairway" bindtap="hit"><text>球道命中</text><text>{{h.par===3?'不适用':!s||s.fairway===null?'未记录':s.fairway?'命中':'未中'}} ›</text></view>
  <view class="menu row" data-key="green" bindtap="hit"><text>标准杆上果岭</text><text>{{!s||s.green===null?'未记录':s.green?'命中':'未中'}} ›</text></view>
 </view>
 <button wx:if="{{!remoteBoard}}" class="tool-row" bindtap="operations" aria-expanded="{{operations}}"><image class="tool-row-icon" src="/assets/flag.png"/><view class="tool-copy"><view class="tool-label">本洞与比赛操作</view><view class="tool-description">捡球、补记与比赛规则</view></view><text class="tool-chevron">{{operations?'−':'＋'}}</text></button>
 <view wx:if="{{operations&&!remoteBoard}}" class="tool-expanded"><view class="note">{{statusText}} · {{courseHole}} · {{p.tee}}</view><view class="sub">{{explanation}}</view><view class="choices"><text class="choice" data-mode="special" bindtap="adjust">捡球 / 跳洞</text><text class="choice" data-mode="penalty" bindtap="adjust">追加罚杆</text><text class="choice" data-mode="event" bindtap="adjust">比赛事件</text><text class="choice" data-mode="award" bindtap="adjust">附加奖项</text><text class="choice" bindtap="rules">本场规则</text></view></view>
 <button wx:if="{{!remoteBoard&&!editing}}" class="tool-row" bindtap="pause"><view class="tool-glyph pause-symbol" aria-hidden="true">Ⅱ</view><view class="tool-copy"><view class="tool-label">保存并返回</view><view class="tool-description">成绩已保留，其他组员可继续记分</view></view><text class="tool-chevron">›</text></button>
 <button wx:if="{{competitionBoard}}" class="tool-row" bindtap="switchGroups"><view class="tool-copy"><view class="tool-label">核对成绩与交卡</view><view class="tool-description">回到本组赛事页面确认成绩</view></view><text class="tool-chevron">›</text></button><button wx:if="{{canFinishRemote&&!boardFinished}}" class="primary round-finish" bindtap="finishRemote">检查并结束本轮</button><view wx:if="{{!remoteBoard}}" class="round-finish-area"><button wx:if="{{!editing}}" class="primary round-finish" bindtap="finish">检查并结束本轮<text>→</text></button><block wx:else><button class="primary round-finish" bindtap="commit">填写原因并提交更正<text>→</text></button><button class="tools-cancel" bindtap="cancel">放弃本次更正</button></block></view>
</view>
<view class="score-footnote">杆数仅累计已记录的实际完洞成绩；未记球洞留空，不自动补标准杆。</view></block></view><view wx:if="{{codeOpen}}" class="invite-code-layer" catchtouchmove="codeNoop">
 <view class="invite-code-mask" bindtap="closeCode"></view>
 <scroll-view class="invite-code-dialog" scroll-y="{{true}}" catchtap="codeNoop">
  <view class="invite-code-content">
   <button class="invite-code-close" bindtap="closeCode" aria-label="关闭邀请">×</button>
   <view class="invite-code-title">{{codeKind==='scorer'?'邀请记分员 / 球童':codeKind==='group'?'邀请另一组加入活动':codeKind==='watch'?'邀请查看成绩':'邀请球友扫码入组'}}</view><view class="invite-code-subtitle">{{codeKind==='scorer'?'只协助本组记分，不占球位、不参与排名':codeKind==='watch'?'扫码查看本活动成绩':codeKind==='group'?'扫码建立小组，一起查看活动成绩':'微信扫一扫，加入本组一起记分'}}</view>
   <view class="invite-code-frame">
    <image wx:if="{{boardCode}}" class="invite-code-image" src="{{boardCode}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="previewCode" binderror="codeImageError"/>
    <view wx:elif="{{codeBusy}}" class="invite-code-status"><view class="invite-code-spinner"></view><text>正在生成微信小程序码…</text></view>
    <view wx:else class="invite-code-status"><text>{{codeError||'暂未生成小程序码'}}</text><button bindtap="retryCode">重新生成</button></view>
   </view>
   <view class="invite-code-version">{{codeVersion}} · 微信小程序码</view>
   <button wx:if="{{boardInvite}}" class="primary invite-code-share" open-type="share">转发给微信好友</button>
   <view class="invite-code-actions"><text bindtap="closeCode" role="button">关闭</text><text wx:if="{{boardInvite}}" bindtap="revokeCode" role="button">撤销本次邀请</text></view>
  </view>
 </scroll-view>
</view><privacy-panel/>
<qy-dialog class="page-dialog"/>
