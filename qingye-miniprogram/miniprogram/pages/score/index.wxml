<view class="page score-page"><image class="page-backdrop" src="cloud://cloud1-d7gketoi570d17f80.636c-cloud1-d7gketoi570d17f80-1524135194/media-v1/assets__spring-lake.webp" mode="aspectFill" aria-hidden="true"/><view class="score-intro"><view class="title">本轮记分</view><view class="sub">专注当下，享受每一洞。</view></view><view class="row space score-social" bindtap="groups"><text class="link">{{r.cloud?'同组与活动成绩':'微信组队'}} ↗</text><text class="note">{{syncText}}</text></view><view class="card row score-course"><view class="grow course-name">{{r.courseName}}</view><text class="link tap" bindtap="guide">球道图 ›</text></view><view class="card hole-score-card"><view class="row hole-heading"><view class="row"><view><view class="note">当前球洞</view><view class="current-hole">第 {{h.number}} 洞</view></view><view class="par-header"><view class="note">标准杆</view><view>PAR {{h.par}}</view></view></view><view class="note">{{editing?'更正中':'✓ 已保存'}}</view></view><view class="segment half"><view class="{{half==='front'?'active':''}}" data-id="front" bindtap="half">前九洞</view><view wx:if="{{r.holes.length>9}}" class="{{half==='back'?'active':''}}" data-id="back" bindtap="half">后九洞</view></view><view class="score-table"><view class="table-line table-head"><view class="name-cell">球洞</view><view wx:for="{{tableHoles}}" wx:key="number" class="hole-cell {{h.number===item.number?'current':''}}" data-number="{{item.number}}" bindtap="hole">{{item.number}}</view><view class="total-cell">总杆</view></view><view class="table-line par-line"><view class="name-cell">PAR</view><view wx:for="{{tableHoles}}" wx:key="number" class="hole-cell {{h.number===item.number?'current':''}}" data-number="{{item.number}}" bindtap="hole" role="button" aria-label="第 {{item.number}} 洞，PAR {{item.par}}">{{item.par}}</view><view class="total-cell">—</view></view><view wx:for="{{tablePlayers}}" wx:key="id" class="table-line player-line"><view class="name-cell">{{item.name}}</view><view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="number" class="hole-cell {{h.number===cell.number?'current':''}} {{h.number===cell.number && p.id===item.id?'selected-cell':''}}" data-pid="{{item.id}}" data-number="{{cell.number}}" bindtap="hole"><view class="score-mark {{cell.kind}}">{{cell.value}}</view></view><view class="total-cell">{{item.total}}</view></view></view></view><view class="card compact-stepper"><view wx:if="{{players.length>1}}" class="players"><view wx:for="{{players}}" wx:key="id" class="person {{p.id===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="selectPlayer">{{item.id==='me'?'我':item.name}}</view></view><view class="row step-row"><view class="grow"><view class="note">{{p.id==='me'?'我':p.name}}的本洞总杆</view><view class="score-caption">{{s?(s.completion==='holed_out'?(appearance.label||appearance.delta):statusText):'默认 PAR · 待确认'}}</view></view><button class="step-minus" data-delta="-1" bindtap="step" aria-label="减少一杆">−</button><button class="score-number" bindtap="input" aria-label="确认默认标准杆">{{displayScore}}</button><button class="primary step-plus" data-delta="1" bindtap="step" aria-label="增加一杆">＋</button></view><view class="row step-footer"><text class="note">总杆 {{summary.liveTotal}} <text>{{summary.diff===0?'E':summary.diff>0?'+'+summary.diff:summary.diff}}</text></text><text wx:if="{{!s}}" class="link" bindtap="input">记为 Par ✓</text><text wx:else class="link tap" bindtap="clear">清空</text><text class="link tap" bindtap="undo">↶ 撤销</text></view></view><view class="legend"><view><text class="score-mark eagle">−2</text><text>Eagle</text></view><view><text class="score-mark birdie">−1</text><text>Birdie</text></view><view><text class="score-mark par">E</text><text>Par</text></view><view><text class="score-mark bogey">+1</text><text>Bogey</text></view><view><text class="score-mark double">+2</text><text>Double</text></view></view><view class="quiet-card spaced row" bindtap="operations"><text>本洞详情与比赛操作</text><text>{{operations?'⌃':'⌄'}}</text></view><view wx:if="{{operations}}"><view class="note">{{statusText}} · {{h.sectionName}} · 原洞号 {{h.label}} · {{p.tee}}</view><view class="sub">{{explanation}}</view><view class="choices"><text class="choice" data-mode="special" bindtap="adjust">捡球 / 跳洞</text><text class="choice" data-mode="penalty" bindtap="adjust">追加罚杆</text><text class="choice" data-mode="event" bindtap="adjust">比赛事件</text><text class="choice" data-mode="award" bindtap="adjust">附加奖项</text><text class="choice" bindtap="rules">本场规则</text></view></view><view class="menu row" bindtap="technical"><text>详细记录 <text class="note">选填</text></text><text>{{technical?'收起 −':'展开 +'}}</text></view><view wx:if="{{technical}}" class="card"><view class="menu row" data-key="putts" bindtap="tech"><text>推杆数</text><text>{{!s||s.putts===null?'未记录':s.putts}} ›</text></view><view class="menu row" data-key="penalties" bindtap="tech"><text>罚杆 · 已含在总杆中</text><text>{{s?s.penalties:0}} ›</text></view><view class="menu row" data-key="fairway" bindtap="hit"><text>球道命中</text><text>{{h.par===3?'不适用':!s||s.fairway===null?'未记录':s.fairway?'命中':'未中'}}</text></view><view class="menu row" data-key="green" bindtap="hit"><text>标准杆上果岭</text><text>{{!s||s.green===null?'未记录':s.green?'命中':'未中'}}</text></view></view><view class="toolbar"><button bindtap="result">完整记分卡</button><button wx:if="{{!editing}}" bindtap="pause">暂存球局</button></view><button wx:if="{{!editing}}" class="space" bindtap="finish">检查并结束本轮</button><view wx:else><button class="primary space" bindtap="commit">填写原因并提交更正</button><button class="space" bindtap="cancel">放弃本次更正</button></view><view class="note spaced">总杆按整轮标准杆＋已完球洞杆差显示。未记球洞保留空白，不计作实际完洞。</view></view><privacy-panel/>
