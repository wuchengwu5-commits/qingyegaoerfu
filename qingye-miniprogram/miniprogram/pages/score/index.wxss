.score-page{padding:18rpx 20rpx calc(32rpx + env(safe-area-inset-bottom))}.course-name{font-size:30rpx;font-weight:600}.hole-heading{margin:12rpx 0 20rpx}.current-hole{font-size:44rpx;font-weight:650;margin-top:3rpx}.par-header{border-left:1rpx solid #d4dfc9;padding-left:24rpx;font-size:32rpx;color:#69865b}.half{margin:16rpx 0;padding:6rpx}.half view{padding:12rpx}.score-table{border:1rpx solid #e0e8d8;border-radius:20rpx;overflow:hidden;background:white}.table-line{display:flex;align-items:stretch;text-align:center;min-height:64rpx}.table-head{background:#365f48;color:#fff;font-size:25rpx}.par-line{background:#edf2e6;color:#8a9c7c;font-size:24rpx;min-height:40rpx}.name-cell{width:72rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:24rpx;padding:6rpx;overflow:hidden}.hole-cell{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;border-left:1rpx solid #edf1e8}.total-cell{width:70rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-left:1rpx solid #edf1e8;font-size:25rpx;font-weight:600}.player-line{border-bottom:1rpx solid #edf1e8}.player-line:last-child{border-bottom:0}.selected-cell{background:#ecf3e4;box-shadow:inset 0 0 0 3rpx #658657}.table-head .current{background:#214b34}.score-table .score-mark{width:38rpx;min-width:38rpx;height:38rpx;font-size:24rpx}.compact-stepper{padding:22rpx;margin:18rpx 0 12rpx;border:1rpx solid #dae5cf}.players{display:flex;gap:8rpx;padding-bottom:18rpx;border-bottom:1rpx solid #e6ecdf;margin-bottom:18rpx}.person{flex:1;min-width:0;padding:16rpx 6rpx;text-align:center;border-radius:16rpx;color:#819074;font-size:25rpx}.person.selected{background:#eaf2e3;color:#226448}.step-row{gap:12rpx}.step-row button{width:88rpx;min-height:88rpx;line-height:88rpx;padding:0;border-radius:22rpx;flex-shrink:0;font-size:40rpx}.step-row .score-number{font-size:60rpx;color:#173f2c;background:transparent;width:78rpx;font-weight:650}.step-row .note{font-size:24rpx}.score-caption{font-size:28rpx;color:#7c8a70;margin-top:8rpx}.step-footer{border-top:1rpx solid #e7ecdf;margin-top:16rpx;padding-top:4rpx;gap:12rpx}.step-footer .link{font-size:25rpx}.legend{display:flex;justify-content:space-between;gap:4rpx;padding:10rpx 2rpx}.legend>view{display:flex;align-items:center;gap:5rpx;font-size:22rpx;color:#829176}.legend .score-mark{width:28rpx;min-width:28rpx;height:28rpx;font-size:18rpx}

.score-page{padding:24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom))}.score-intro{margin:14rpx 20rpx 26rpx}.score-intro .title{margin:0 0 4rpx}.score-social{margin:0 12rpx 14rpx;min-height:48rpx}.score-social .link,.score-social .note{font-size:23rpx}.page .score-course{padding:22rpx 24rpx;margin-bottom:18rpx;border-radius:28rpx;min-height:104rpx}.score-course .course-name{font-size:30rpx}.score-course .tap{min-height:60rpx;flex-shrink:0;font-size:25rpx}.page .hole-score-card{padding:22rpx 20rpx 18rpx;margin-bottom:18rpx;border-radius:30rpx}.hole-heading{margin:0 4rpx 20rpx}.current-hole{font-size:46rpx}.par-header{font-size:30rpx}.score-table{border-radius:12rpx}.page .score-table{box-shadow:none}.table-line{min-height:68rpx}.par-line{min-height:54rpx}.page .table-head{background:rgba(54,95,57,.87)}.page .table-head .current{background:#759e62}.page .par-line{background:rgba(226,238,217,.6)}.page .compact-stepper{margin-top:0;border-radius:30rpx}.page .step-row .score-number{background:transparent}.page .quiet-card{border-radius:28rpx}.legend{padding:8rpx 6rpx 16rpx}
/* Shared cool-glass palette. */
.page .table-head{background:rgba(48,96,70,.88)}.page .table-head .current{background:#739f80}.page .par-line{background:rgba(220,240,230,.52);color:#597767}

/* A continuous active column connects the hole, PAR and every player's score. */
.page.score-page .score-table{border:1rpx solid rgba(255,255,255,.84);border-radius:14rpx;background:rgba(250,253,248,.66);box-shadow:none}
.score-page .score-table .table-line{min-height:68rpx}
.score-page .score-table .hole-cell,.score-page .score-table .total-cell{border-left-color:rgba(255,255,255,.68)}
.page.score-page .table-head{background:linear-gradient(180deg,rgba(85,119,88,.94),rgba(47,86,59,.97))}
.page.score-page .table-head .current{background:linear-gradient(180deg,#a4be91,#7ca36b);color:#fff;font-weight:600}
.page.score-page .par-line{background:rgba(244,249,241,.72);color:#385547}
.page.score-page .player-line{background:rgba(255,255,255,.66);border-color:rgba(223,233,218,.7)}
.page.score-page .par-line .current,.page.score-page .player-line .current{background:rgba(189,216,175,.55)}
.page.score-page .par-line .current{color:#24482f;font-weight:600}
.page.score-page .player-line .selected-cell{background:rgba(171,204,153,.6);box-shadow:none}
.score-page .legend{flex-wrap:nowrap;gap:8rpx;padding:12rpx 4rpx 18rpx}
.score-page .legend>view{flex:none;gap:6rpx;font-size:25rpx;line-height:1.3;color:#4e6957;white-space:nowrap}
.score-page .legend text{white-space:nowrap}
.score-page .legend .score-mark{width:34rpx;min-width:34rpx;height:34rpx;font-size:20rpx}

