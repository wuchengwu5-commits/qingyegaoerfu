@import "../../services/invite-code.wxss";
/* Approved large-cell scorecard. Pixel minima keep tap targets usable on small phones. */
.page.score-page{padding:12px 12px calc(24px + env(safe-area-inset-bottom))}
.page .score-course{padding:9px 13px;margin-bottom:8px;border-radius:19px}.course-name{font-size:17px;font-weight:600;line-height:1.45}.course-map-link{font-size:13px;flex-shrink:0;min-height:28px;display:flex;align-items:center}
.route-line{display:flex;align-items:center;margin-top:2px;padding-top:0;gap:6px}.route-caption{font-size:12px;color:#667e67;margin-right:9px}.route-label{font-size:14px;font-weight:600}.page .route-edit{padding:0 6px;min-height:40px;line-height:40px;font-size:13px;background:transparent;border:0;box-shadow:none;flex-shrink:0}
.route-panel{border-top:1px solid #e1e8d9;margin-top:6px;padding-top:12px}.route-title{font-size:17px;font-weight:600;margin-bottom:10px}.route-pickers{display:flex;align-items:flex-end;gap:6px}.route-option{flex:1;min-width:0}.route-option .note{font-size:12px}.route-select{min-height:44px;padding:10px 8px;border:1px solid #e1e8d9;border-radius:9px;background:#edf0e3;font-size:15px;line-height:24px}.page .route-swap{width:44px;min-height:44px;line-height:44px;font-size:22px;padding:0;border-radius:9px;flex-shrink:0}.route-note{font-size:12px;color:#667e67;line-height:1.6;margin-top:8px}.route-actions{display:flex;gap:8px;margin-top:11px}.route-actions button{flex:1;min-height:44px;line-height:44px;font-size:15px;border-radius:10px;padding:0 8px}
.page .hole-score-card{padding:12px 10px 9px;margin-bottom:10px;border-radius:19px}.hole-heading{gap:10px;margin:0 1px 12px}.hole-heading .note{font-size:13px;line-height:1.6}.course-hole-title{font-size:20px;font-weight:600;line-height:1.4;overflow-wrap:anywhere}.par-header{flex-shrink:0;border-left:1px solid #e1e8d9;padding-left:12px;font-size:18px;color:#667e67}
.page.score-page .score-table{display:flex;align-items:flex-start;width:100%;overflow:hidden;border:1px solid #e1e8d9;border-radius:10px;background:#f9fbf1;box-shadow:none}
.fixed-players{width:84px;flex:0 0 84px;position:relative;z-index:1;box-shadow:2px 0 4px #2344350a}.name-head,.name-par{height:51px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:16px;border-bottom:1px solid #e1e8d9;border-right:1px solid #e1e8d9}.name-head{background:#476d50;color:white;font-weight:600}.total-label{font-size:11px;font-weight:400;opacity:.85}.name-par{background:#edf0e3;color:#456248;font-size:18px}
.player-id{height:64px;padding:5px 7px;background:#f9fbf1;border-bottom:1px solid #e1e8d9;border-right:1px solid #e1e8d9;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:3px}.player-identity{display:flex;align-items:center;gap:6px;width:100%}.score-avatar{display:block;width:32px;height:32px;flex-shrink:0;border-radius:50%;background:#dfebd9;border:1px solid #f9fbf1}.person-total{font-size:17px;line-height:1.2;font-weight:400;color:#7e8c79}.person-name{font-size:15px;font-weight:600;color:#234435;line-height:18px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.selected-player{background:#dfebd9}.avatar-placeholder{padding:5px;opacity:.7}
.score-scroll{flex:1;width:0;min-width:0}.score-grid{display:block}.table-line{display:flex;text-align:center}.score-page .hole-cell{width:45px;flex:0 0 45px;height:51px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:2px;border-right:1px solid #e1e8d9;border-bottom:1px solid #e1e8d9;box-sizing:border-box;font-size:18px;background:#f9fbf1;overflow:hidden}.page.score-page .table-head .hole-cell{background:#476d50;color:#fff;font-size:16px;font-weight:600}.page.score-page .table-head .current{background:#688060}.page.score-page .par-line .hole-cell{background:#edf0e3;color:#456248}.page.score-page .par-line .current{background:#f0f4e9}
.score-page .player-line .hole-cell{height:64px}.page.score-page .player-line .current{background:#f0f4e9}.page.score-page .selected-row .hole-cell{background:#eaf2e5}.page.score-page .selected-row .current{background:#e1ead8}.page.score-page .player-line .selected-cell{box-shadow:inset 0 0 0 1.5px #346341}
.score-page .score-table .score-mark{width:29px;min-width:29px;height:29px;font-size:22px;font-weight:600}.score-page .score-table .score-mark.par{color:#234435;background:transparent}.hole-distance{font-size:14px;font-weight:400;line-height:1.3;color:#c3cbbc}.recorded .hole-distance{font-size:11px;line-height:1.2}.selected-cell .hole-distance{color:#b9c5b1}.empty-score{font-size:22px;color:#c3cbbc}.scroll-hint{display:flex;justify-content:space-between;gap:6px;margin-top:6px;font-size:11px;color:#667e67;line-height:1.6}
.page .compact-stepper{padding:9px 11px 10px;border-radius:19px;margin:0 0 8px}.players-scroll{width:100%;border-bottom:1px solid #e1e8d9;padding-bottom:8px}.players{display:flex;gap:4px;min-width:100%;width:max-content}.person{flex:1 0 58px;min-width:58px;min-height:54px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;padding:4px 0;border-radius:10px;font-size:15px;color:#667e67}.page .person.selected{background:#dfebd9;color:#346341;font-weight:600}.tab-avatar{width:23px;height:23px;border-radius:50%;background:#dfebd9;display:block}.tab-avatar.avatar-placeholder{padding:3px}.tab-name{max-width:72px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 3px}
.step-row{padding:10px 0;gap:3px}.step-row .note{font-size:13px;line-height:1.5}.score-caption{font-size:14px;color:#667e67;margin-top:4px;line-height:1.5}.step-row button{width:46px;min-height:48px;line-height:48px;padding:0;flex-shrink:0;font-size:28px;border-radius:14px}.page .step-row .score-number{font-size:34px;width:41px;background:transparent;font-weight:650;border:0;box-shadow:none}.step-footer{border-top:1px solid #e1e8d9;padding-top:3px;gap:6px}.step-footer .note,.step-footer .link{font-size:14px}.footer-action{display:flex;align-items:center;min-height:40px;white-space:nowrap}
.legend{display:flex;justify-content:space-between;gap:3px;padding:6px 2px 10px}.legend-item{display:flex;align-items:center;gap:3px;font-size:12px;color:#667e67;white-space:nowrap}.legend .score-mark{width:18px;height:18px;min-width:18px;font-size:11px}
.score-social{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:10px 0 14px}.score-social .note,.score-social .link{font-size:13px}.page .board-invite{min-height:44px;line-height:44px;padding:0 14px;font-size:14px;border-radius:14px;background:#e3ecdf;color:#23543a;margin:0}.board-code-card{text-align:center}.board-code{display:block;width:180px;height:180px;margin:14px auto;background:white}.board-error{font-size:13px;color:#865327;line-height:1.7;padding:8px 0}.board-code-actions{justify-content:space-between;padding-top:12px}
.score-avatar,.tab-avatar{box-sizing:border-box}.person-name{flex-shrink:0}.page .route-edit{width:58px;flex:0 0 58px}
@media(max-width:330px){.page.score-page{padding-left:8px;padding-right:8px}.page .score-course{padding:10px}.course-name{font-size:15px}.page .hole-score-card{padding:11px 8px 8px}.step-row .note,.score-caption{font-size:12px}.entry-prefix{display:none}.step-footer .note,.step-footer .link{font-size:13px}.person{min-width:49px;flex-basis:49px;font-size:14px}.legend-item{font-size:11px;gap:2px}.route-caption{margin-right:5px}.route-label{font-size:13px}}

.page .round-details{padding:8px 13px 10px;margin:6px 0 10px;border-radius:16px}.round-rule{display:flex;align-items:center;min-height:40px;font-size:13px;color:#667e67}.round-rule .route-caption{margin-right:9px}

.roster-actions{display:flex;gap:8px;margin-top:12px}.page .roster-actions button{flex:1;padding:0 8px;min-height:44px;line-height:44px;font-size:13px;border-radius:12px}.scorer-list{padding:10px 12px;border-top:1px solid #dfe7d9}.scorer-row{min-height:42px;font-size:14px;justify-content:space-between}

/* Keep the physical hole number legible even when its course label is long. */
.page.score-page .table-head .hole-cell{gap:1px;padding:4px 2px}
.hole-section-label{display:block;max-width:39px;font-size:11px;line-height:13px;font-weight:400;color:#d8e3d3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hole-number-label{display:block;max-width:100%;font-size:20px;line-height:25px;font-weight:600;font-variant-numeric:tabular-nums}

.page.score-page .score-tools{padding:14px 14px 0;margin:12px 0;border-radius:18px;overflow:hidden}
.tools-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:38px;margin-bottom:8px}
.tools-title{font-size:16px;font-weight:600;line-height:1.5;color:#294b37}.tools-caption{font-size:12px;line-height:1.6;color:#7a8974;margin-top:2px}
.score-page .tools-link{width:auto;flex:0 0 auto;min-height:44px;line-height:44px;margin:0;padding:0 2px;font-size:12px;font-weight:400;color:#607c61;background:transparent;border:0;box-shadow:none}
.score-page .team-invite{display:flex;align-items:center;gap:12px;width:100%;margin:0;padding:13px 14px;min-height:70px;line-height:1.5;border:0;border-radius:12px;background:#e5eddf;color:#315e3d;box-shadow:none;text-align:left}
.tool-copy{flex:1;min-width:0}.tool-label{font-size:15px;line-height:1.5;font-weight:500;white-space:normal}.tool-description{font-size:12px;line-height:1.6;font-weight:400;color:#7b8975;margin-top:2px;white-space:normal}.tool-chevron{font-size:21px;font-weight:400;line-height:26px;color:#879780;flex:0 0 auto}
.invite-symbol{display:grid;grid-template-columns:8px 8px;grid-template-rows:8px 8px;gap:4px;width:20px;height:20px;flex:0 0 20px;margin:0 2px}.invite-symbol view{border:1.5px solid #567b5a;border-radius:1px}.invite-symbol view:last-child{border:0;background:#567b5a;width:5px;height:5px;box-shadow:5px 5px 0 #567b5a}
.team-secondary{display:flex;gap:0;margin-top:8px;margin-bottom:5px}.score-page .team-small-action{display:flex;align-items:center;gap:8px;flex:1;width:0;min-width:0;min-height:64px;line-height:1.5;padding:8px 5px;margin:0;border:0;border-radius:0;background:transparent;box-shadow:none;text-align:left;color:#36513e}
.score-page .team-small-action+.team-small-action{padding-left:14px;border-left:1px solid #e1e7d9}.team-small-action .tool-label{font-size:13px}.team-small-action .tool-description{font-size:11px}
.team-action-symbol{display:block;font-size:23px;line-height:26px;font-weight:400;color:#5c805e;flex:0 0 20px}.team-action-icon{display:block;width:20px;height:20px;opacity:.75;flex:0 0 20px}
.team-sync{display:flex;justify-content:space-between;align-items:center;gap:8px;min-height:40px;border-top:1px solid #e1e7d9;font-size:12px;color:#7a8974}.team-sync .link{font-size:12px;min-height:40px;display:flex;align-items:center}
.score-page .team-tools .scorer-list{padding:10px 0}.team-tools .scorer-list .note{font-size:12px}.team-tools .board-error{padding:10px 0}
.score-page .round-tools .tools-heading{margin-bottom:0;min-height:34px}
.score-page .tool-row{display:flex;align-items:center;gap:12px;width:100%;margin:0;padding:12px 0;min-height:67px;line-height:1.5;text-align:left;border:0;border-radius:0;border-bottom:1px solid #e2e8db;background:transparent;box-shadow:none;color:#36513e}
.tool-row-icon{width:21px;height:21px;flex:0 0 21px;opacity:.75}.tool-glyph{width:21px;flex:0 0 21px;text-align:center;font-size:25px;font-weight:400;line-height:26px;color:#658264}.pause-symbol{font-size:20px}
.optional-label{font-size:11px;font-weight:400;color:#8b9685;margin-left:8px}.tool-expanded{padding:10px 10px 6px;background:#edf2e6;border-radius:10px}.tool-expanded .menu{font-size:14px;min-height:46px}.tool-expanded .note,.tool-expanded .sub{font-size:12px}.tool-expanded .choices{margin:10px 0;gap:6px}.tool-expanded .choice{font-size:13px;min-height:44px;min-width:0;padding:12px}
.round-finish-area{padding:14px 0 16px}.score-page .round-finish{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;line-height:24px;padding:12px 16px;margin:0;border-radius:12px;font-size:15px;font-weight:500}.round-finish text{font-size:21px;font-weight:400;opacity:.8}
.score-page .tools-cancel{width:100%;min-height:44px;line-height:44px;margin:6px 0 0;padding:0;font-size:13px;color:#7a8974;background:transparent;box-shadow:none;border:0}
.score-footnote{padding:0 7px 12px;font-size:11px;line-height:1.7;color:#89957e}
@media(max-width:330px){.page.score-page .score-tools{padding:12px 11px 0}.team-small-action .tool-label{font-size:12px}.team-small-action .tool-description{font-size:10px}.score-page .team-small-action{gap:5px}.score-page .team-small-action+.team-small-action{padding-left:9px}.tools-title{font-size:15px}.score-page .tools-link{font-size:11px}}
