.score-hub{padding-bottom:calc(170rpx + env(safe-area-inset-bottom))}.score-hub .hub-round{padding:36rpx;border-radius:32rpx}.hub-status{color:#537457;font-size:24rpx;margin-bottom:14rpx}.hub-name{font-weight:600;font-size:38rpx;line-height:1.5;color:#204735}.hub-round .muted{margin-top:8rpx}.score-hub .hub-start{display:flex;align-items:center;justify-content:center;gap:14rpx;width:100%;margin-top:30rpx}.hub-menu image{width:36rpx;height:36rpx}.hub-menu .row{gap:18rpx}
.hub-heading{padding:28rpx 12rpx 32rpx}.score-hub .hub-title{margin:0;font-size:54rpx;line-height:1.45;font-weight:500;color:#193f2d;letter-spacing:1rpx}.hub-subtitle{margin-top:10rpx;font-size:28rpx;line-height:1.65;color:#4c6652}.score-hub .hub-round{margin-top:0}
.hub-recent-heading{font-size:32rpx;font-weight:500;margin:28rpx 8rpx 14rpx;min-height:72rpx}.hub-all{font-size:26rpx;font-weight:400;min-height:72rpx;display:flex;align-items:center}.score-hub .hub-recent-list{padding:0 26rpx;border-radius:30rpx}.hub-recent-row{display:flex;align-items:center;gap:16rpx;min-height:126rpx;padding:20rpx 0;border-bottom:1rpx solid rgba(84,111,78,.13)}.hub-recent-row:last-child{border-bottom:0}.hub-recent-row:active{background:rgba(230,242,222,.4)}.hub-recent-name{font-size:29rpx;font-weight:500;line-height:1.45;color:#244631;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hub-recent-meta{font-size:24rpx;color:#63775f;line-height:1.6;margin-top:5rpx}.hub-recent-score{flex-shrink:0;text-align:right;min-width:86rpx}.hub-recent-score>view{font-size:38rpx;line-height:1.2;font-weight:500;color:#28543b;font-variant-numeric:tabular-nums}.hub-recent-score>text{display:block;font-size:23rpx;color:#6b7e65;margin-top:5rpx}.hub-recent-arrow{width:22rpx;height:22rpx;flex-shrink:0;opacity:.65}.hub-recent-empty{font-size:29rpx;line-height:1.7;padding:30rpx}.hub-recent-empty>text{display:block;font-size:25rpx;color:#6b7e65;margin-top:8rpx}
.hub-start-icon{width:34rpx;height:34rpx;flex-shrink:0}
.hub-active-heading{margin:0 8rpx 18rpx;font-size:29rpx;font-weight:500;color:#244631}
.score-hub .hub-active-round{padding:24rpx 28rpx;margin-bottom:18rpx}
.hub-active-status{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 16rpx;margin-bottom:10rpx;color:#537457;font-size:24rpx;line-height:1.5}
.hub-group-label{padding:4rpx 14rpx;border-radius:12rpx;background:#e6efdd;color:#355740;font-weight:600}
.hub-current-hole{min-width:0}
.hub-active-round .hub-name{font-size:33rpx;line-height:1.4;overflow-wrap:anywhere}
.hub-active-round .muted{margin-top:6rpx;font-size:25rpx;line-height:1.5}
.score-hub .hub-active-round .hub-start{margin-top:18rpx}


.hub-group-heading{gap:12rpx}.hub-group-heading .hub-name{font-size:36rpx}.hub-my-groups{display:flex;align-items:center;justify-content:flex-end;min-height:76rpx;flex-shrink:0;font-size:25rpx;font-weight:400}
.hub-group-actions{display:flex;gap:16rpx;margin-top:26rpx}
.score-hub .hub-group-actions button{width:auto;min-width:0;margin:0;min-height:100rpx;line-height:1.4;padding:28rpx 12rpx;white-space:nowrap;font-size:30rpx;border-radius:24rpx}
.hub-group-actions .hub-create{flex:1.45}.score-hub .hub-group-actions .hub-scan{flex:1;background:rgba(225,237,216,.65);border:1rpx solid rgba(134,160,122,.22);color:#3f6947;box-shadow:inset 0 1rpx 1rpx rgba(255,255,255,.7)}
.hub-draft{display:flex;align-items:center;gap:20rpx;padding-top:24rpx;margin-top:26rpx;border-top:1rpx solid rgba(84,111,78,.14);min-height:92rpx}.hub-draft .hub-status{font-size:23rpx;margin-bottom:5rpx}.hub-draft-course{font-size:26rpx;line-height:1.5;color:#4d684e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hub-draft>.link{flex-shrink:0;font-size:25rpx}
.score-hub .hub-menu{margin-top:0;padding:18rpx 30rpx}

.hub-round-actions{display:flex;gap:16rpx;margin-top:18rpx}.score-hub .hub-round-actions button{margin:0;min-width:0;min-height:88rpx;line-height:1.4;padding:24rpx 12rpx;font-size:28rpx}.score-hub .hub-round-actions .hub-start{flex:1;width:auto;margin:0}.score-hub .hub-round-actions .hub-end{flex:0 0 180rpx;width:180rpx;color:#61765c;background:rgba(242,247,235,.7);border:1rpx solid #d9e3d0;box-shadow:none}
