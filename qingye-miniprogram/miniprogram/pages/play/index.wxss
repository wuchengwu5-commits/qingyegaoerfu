/* Scoring hub: the next scoring action owns the only strong emphasis. */
.score-hub{padding-bottom:calc(170rpx + env(safe-area-inset-bottom))}
.hub-heading{padding:24rpx 10rpx 36rpx}.score-hub .hub-title{margin:0;font-size:54rpx;line-height:1.45;font-weight:500;color:#193f2d;letter-spacing:1rpx}.hub-subtitle{margin-top:8rpx;font-size:27rpx;line-height:1.65;color:#586f5c}
.hub-active-heading{display:flex;align-items:center;gap:16rpx;margin:0 8rpx 16rpx;font-size:29rpx;font-weight:600;color:#294b37}.hub-count{font-size:23rpx;font-weight:400;color:#6b7e65}
.score-hub .hub-round{padding:28rpx;margin:0 0 22rpx;border-radius:32rpx}
.hub-active-status{display:flex;align-items:center;gap:14rpx;min-height:70rpx;margin:-12rpx 0 8rpx;color:#61775d;font-size:24rpx}.hub-group-label{padding:6rpx 14rpx;border-radius:12rpx;background:rgba(221,233,209,.7);color:#355740;font-weight:500}.hub-current-hole{flex:1;min-width:0}
.score-hub button.hub-end{width:auto;min-height:88rpx;line-height:1.4;margin:-9rpx -8rpx -9rpx auto;padding:24rpx 8rpx;border:0;border-radius:12rpx;background:transparent;box-shadow:none;color:#71806b;font-size:24rpx;font-weight:400;flex-shrink:0}
.hub-name{font-size:34rpx;font-weight:600;line-height:1.5;color:#204735;overflow-wrap:anywhere}.hub-active-round .muted{margin-top:8rpx;font-size:25rpx;line-height:1.6}
.hub-round-actions{margin-top:24rpx}.score-hub .hub-start{display:flex;align-items:center;justify-content:center;gap:14rpx;width:100%;margin:22rpx 0 0;min-height:92rpx;line-height:1.4;padding:24rpx 16rpx;border-radius:22rpx;font-size:30rpx}.score-hub .hub-round-actions .hub-start{margin:0}.hub-start-icon{width:34rpx;height:34rpx;flex-shrink:0}.score-hub button.hub-continue-secondary{background:rgba(222,235,213,.6);color:#365e40;box-shadow:none;border:1rpx solid rgba(91,124,77,.15)}
.hub-group-heading{gap:12rpx;margin-bottom:2rpx}.hub-group-heading .hub-name{font-size:32rpx}.hub-my-groups{display:flex;align-items:center;justify-content:flex-end;min-height:76rpx;flex-shrink:0;font-size:24rpx;font-weight:400}.hub-group-entry>.note{font-size:25rpx}
.hub-group-actions{display:flex;gap:16rpx;margin-top:24rpx}.score-hub .hub-group-actions button{display:flex;align-items:center;justify-content:center;gap:12rpx;flex:1;min-width:0;width:auto;margin:0;min-height:96rpx;line-height:1.4;padding:22rpx 8rpx;font-size:28rpx;font-weight:500;border-radius:22rpx}.score-hub .hub-group-actions button:not(.primary){background:rgba(226,237,216,.52);border:1rpx solid rgba(104,135,89,.15);color:#3c6446;box-shadow:none}.hub-action-icon{font-size:34rpx;font-weight:400;line-height:1}.hub-scan-icon{width:28rpx;height:28rpx;position:relative;background:linear-gradient(currentColor,currentColor) left top/9rpx 3rpx no-repeat,linear-gradient(currentColor,currentColor) left top/3rpx 9rpx no-repeat,linear-gradient(currentColor,currentColor) right top/9rpx 3rpx no-repeat,linear-gradient(currentColor,currentColor) right top/3rpx 9rpx no-repeat,linear-gradient(currentColor,currentColor) left bottom/9rpx 3rpx no-repeat,linear-gradient(currentColor,currentColor) left bottom/3rpx 9rpx no-repeat,linear-gradient(currentColor,currentColor) right bottom/9rpx 3rpx no-repeat,linear-gradient(currentColor,currentColor) right bottom/3rpx 9rpx no-repeat;flex:0 0 28rpx}.hub-scan-icon view{position:absolute;left:6rpx;right:6rpx;top:13rpx;height:2rpx;background:currentColor}
.hub-competition-row{display:flex;align-items:center;gap:18rpx;margin-top:26rpx;padding-top:24rpx;min-height:112rpx;border-top:1rpx solid rgba(84,111,78,.14);color:#36543d;font-size:29rpx}.hub-competition-row image{width:32rpx;height:32rpx;opacity:.75}.hub-competition-row .note{font-size:23rpx;margin-top:5rpx}.hub-chevron{font-size:36rpx;color:#829279}.score-hub button.hub-rank-link{min-height:88rpx;line-height:1.4;padding:26rpx 0 8rpx;width:100%;background:transparent;box-shadow:none;border:0;font-size:26rpx;font-weight:400}
.hub-draft{display:flex;align-items:center;gap:20rpx;padding-top:22rpx;margin-top:24rpx;border-top:1rpx solid rgba(84,111,78,.14);min-height:92rpx}.hub-status{color:#6b7e65;font-size:23rpx;margin-bottom:5rpx}.hub-draft-course{font-size:26rpx;line-height:1.5;color:#4d684e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hub-draft>.link{display:flex;align-items:center;min-height:88rpx;flex-shrink:0;font-size:25rpx}
.hub-recent-heading{font-size:30rpx;font-weight:600;margin:26rpx 8rpx 12rpx;min-height:72rpx}.hub-all{font-size:24rpx;font-weight:400;min-height:72rpx;display:flex;align-items:center}.score-hub .hub-recent-list{padding:0 26rpx;border-radius:30rpx}.hub-recent-row{display:flex;align-items:center;gap:16rpx;min-height:126rpx;padding:22rpx 0;border-bottom:1rpx solid rgba(84,111,78,.13)}.hub-recent-row:last-child{border-bottom:0}.hub-recent-row:active{background:rgba(230,242,222,.4)}.hub-recent-name{font-size:29rpx;font-weight:500;line-height:1.5;color:#244631;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hub-recent-meta{font-size:23rpx;color:#63775f;line-height:1.6;margin-top:5rpx}.hub-recent-score{flex-shrink:0;text-align:right;min-width:86rpx}.hub-recent-score>view{font-size:38rpx;line-height:1.2;font-weight:500;color:#28543b;font-variant-numeric:tabular-nums}.hub-recent-score>text{display:block;font-size:23rpx;color:#6b7e65;margin-top:5rpx}.hub-recent-arrow{width:22rpx;height:22rpx;flex-shrink:0;opacity:.65}.hub-recent-empty{font-size:29rpx;line-height:1.7;padding:30rpx}.hub-recent-empty>text{display:block;font-size:25rpx;color:#6b7e65;margin-top:8rpx}

.live-tab{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}.live-tab-heading{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;box-sizing:border-box;height:44px;padding:0 100px;font-size:17px;font-weight:500;white-space:nowrap;color:#294b37}
.live-tab-heading .live-hub-button{position:absolute;left:10px;top:0;display:flex;align-items:center;gap:5px;width:auto;min-height:44px;line-height:1.4;margin:0;padding:0 3px;font-size:12px;font-weight:400;letter-spacing:0;color:#45694d;background:transparent;border:0;border-radius:8px;box-shadow:none}.live-hub-symbol{font-size:19px;line-height:1;font-weight:400}
