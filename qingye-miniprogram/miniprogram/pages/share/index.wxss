.postcard-preview{width:100%;display:block;border-radius:24rpx}.postcard-canvas{position:fixed;width:450px;height:720px;left:-1000px;top:0;pointer-events:none}.toolbar button{font-size:26rpx}

.share-background-picker{display:block;margin-top:24rpx}.share-background-row{min-height:96rpx;margin-bottom:8rpx;font-size:28rpx;padding:20rpx 26rpx}.share-background-row>view{display:flex;gap:20rpx;align-items:center;color:#315b3d}.share-picker-arrow{font-size:32rpx}.share-background-note{font-size:25rpx;margin-bottom:20rpx;line-height:1.7}.share-error{padding:20rpx 0;font-size:27rpx}.page .toolbar button{width:100%;min-width:0;line-height:1.5;min-height:90rpx;padding:18rpx 12rpx;display:flex;align-items:center;justify-content:center}.toolbar{display:grid;grid-template-columns:1fr 1fr}
