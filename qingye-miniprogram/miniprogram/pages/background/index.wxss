.background-page{padding-bottom:calc(210rpx + env(safe-area-inset-bottom))}.background-page .title{font-size:44rpx;margin-top:10rpx}.background-page .sub{font-size:26rpx;line-height:1.7}.background-preview{height:480rpx;border-radius:30rpx;overflow:hidden;position:relative;margin:28rpx 0;background:#d3dfcb;box-shadow:0 10rpx 30rpx #254b3215}.background-preview>image{width:100%;height:100%;object-fit:cover}.preview-shade{position:absolute;left:0;right:0;top:0;bottom:0;background:linear-gradient(180deg,#eaf2e755,transparent 60%,#123c3155)}.preview-copy{position:absolute;left:30rpx;right:24rpx;top:25rpx;color:#163c2c}.preview-eyebrow{font-size:21rpx;letter-spacing:2rpx}.preview-copy>view{font-family:'Songti SC',serif;font-size:34rpx;margin-top:32rpx;line-height:1.6}.preview-caption{display:block;font-size:24rpx;margin-top:12rpx}.preview-label{position:absolute;right:20rpx;bottom:18rpx;border-radius:30rpx;padding:8rpx 16rpx;background:#f6faefb3;color:#385541;font-size:22rpx}.mode-switch{margin:26rpx 0 18rpx;min-height:86rpx}.mode-switch>view{min-height:74rpx;display:flex;justify-content:center;align-items:center;font-size:29rpx}.mode-description{padding:6rpx 4rpx 18rpx;font-size:29rpx;line-height:1.8}.mode-description text{display:block;font-size:25rpx;color:#62735f;line-height:1.8;margin-top:4rpx}.collection-title{font-size:29rpx;margin:20rpx 0}.collection-title .link{font-size:26rpx;min-height:68rpx;display:flex;align-items:center}.background-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.background-choice{position:relative;overflow:hidden;border-radius:24rpx;background:#f4f8ee99;border:2rpx solid #ffffff66;box-shadow:0 5rpx 16rpx #274e3010}.background-choice>image{display:block;width:100%;height:290rpx}.background-choice.selected{border-color:#366d45;box-shadow:0 0 0 3rpx #366d4522}.theme-copy{padding:18rpx 18rpx 20rpx;font-size:27rpx;line-height:1.5}.theme-copy text{display:block;font-size:23rpx;color:#6a7b66;margin-top:4rpx}.theme-check{position:absolute;top:14rpx;right:14rpx;width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#2b6540;color:white;font-size:27rpx}.background-note{font-size:24rpx;margin:28rpx 4rpx;line-height:1.8}.background-save{position:fixed;z-index:10;left:0;right:0;bottom:0;padding:14rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));background:#f4f9ecdb;backdrop-filter:blur(16px);border-top:1rpx solid #ffffff66}.background-save button{min-height:90rpx;font-size:29rpx;margin:0}.save-copy{font-size:23rpx;color:#5c735c;margin-bottom:12rpx;text-align:center}
