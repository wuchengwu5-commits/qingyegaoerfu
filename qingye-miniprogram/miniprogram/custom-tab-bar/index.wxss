/* A separate floating glass capsule; spacing includes the iPhone safe area. */
.glass-tabs{position:fixed;left:24rpx;right:24rpx;bottom:calc(16rpx + env(safe-area-inset-bottom));z-index:90;display:block;width:auto;max-width:none;padding:10rpx;border:1rpx solid rgba(255,255,255,.88);border-radius:999rpx;background:linear-gradient(135deg,rgba(248,254,251,.72),rgba(229,243,236,.64));backdrop-filter:blur(18px) saturate(1.18);-webkit-backdrop-filter:blur(18px) saturate(1.18);box-shadow:inset 0 2rpx 2rpx rgba(255,255,255,.84),inset 0 -1rpx 1rpx rgba(131,164,146,.18),0 12rpx 34rpx rgba(32,68,49,.12),0 2rpx 5rpx rgba(32,68,49,.04);box-sizing:border-box}
.glass-tab-track{position:relative;display:flex;align-items:stretch;height:110rpx;width:100%}
.glass-tab-highlight{position:absolute;top:0;bottom:0;left:0;width:25%;border:1rpx solid rgba(255,255,255,.72);border-radius:999rpx;background:linear-gradient(145deg,rgba(217,234,223,.87),rgba(195,219,204,.62));box-shadow:inset 0 2rpx 3rpx rgba(255,255,255,.72),inset 0 -1rpx 2rpx rgba(99,133,113,.09),0 2rpx 8rpx rgba(43,84,60,.055);box-sizing:border-box;transition:transform 280ms cubic-bezier(.22,.8,.2,1);pointer-events:none}
.glass-tabs .tab{position:relative;z-index:1;flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7rpx;min-height:110rpx;margin:0;padding:8rpx 0 6rpx;border:0;border-radius:999rpx;background:transparent;box-shadow:none;color:#667a70;font-size:22rpx;font-weight:400;line-height:1.3;letter-spacing:.5rpx;transition:color 180ms ease,transform 120ms ease;box-sizing:border-box}
.glass-tabs .tab::after{border:none}
.glass-tabs .tab-image{display:block;width:44rpx;height:44rpx;flex-shrink:0;margin:0;opacity:.62;object-fit:contain;transition:opacity 180ms ease,transform 220ms cubic-bezier(.22,.8,.2,1)}
.glass-tabs .tab-label{display:block;line-height:1.35;font-size:22rpx}
.glass-tabs .tab.selected{color:#234e38;font-weight:600}
.glass-tabs .tab.selected .tab-image{opacity:1;transform:translateY(-1rpx) scale(1.04)}
.glass-tabs .tab-pressed,.glass-tabs .tab:active{transform:scale(.96)}
.glass-tabs .tab:focus-visible{outline:2rpx solid #81a68d;outline-offset:-3rpx}
@media(prefers-reduced-motion:reduce){.glass-tab-highlight,.glass-tabs .tab,.glass-tabs .tab-image{transition:none}}

/* Keep navigation visually light while retaining full touch targets. */
.glass-tabs{left:14rpx;right:14rpx;bottom:calc(8rpx + env(safe-area-inset-bottom));padding:6rpx 10rpx;border-radius:40rpx;background:rgba(248,252,239,.77);border-color:rgba(255,255,255,.83);box-shadow:inset 0 1rpx 1rpx #fff,0 5rpx 18rpx rgba(35,61,39,.055);backdrop-filter:blur(20px) saturate(.85);-webkit-backdrop-filter:blur(20px) saturate(.85)}
.glass-tab-track{height:96rpx}.glass-tabs .tab{min-height:96rpx;gap:6rpx;font-weight:400}.glass-tabs .tab-image{width:42rpx;height:42rpx;opacity:.76}.glass-tabs .tab.selected{color:#234b32;font-weight:600}.glass-tab-highlight{border:0;border-radius:28rpx;background:rgba(219,232,205,.38);box-shadow:none}.glass-tabs .tab.selected .tab-image{transform:none;opacity:1}
.glass-tabs{border-color:rgba(255,255,255,.35);box-shadow:inset 0 1rpx 1rpx rgba(255,255,255,.4),0 5rpx 18rpx rgba(35,61,39,.055)}

/* Device-safe dock: paint through to the bottom; inset belongs inside, exactly once. */
.glass-tabs{left:0;right:0;bottom:0;border-radius:38rpx 38rpx 0 0;padding:6rpx 14rpx calc(6rpx + env(safe-area-inset-bottom));border-bottom:0;background:rgba(248,252,239,.83)}
